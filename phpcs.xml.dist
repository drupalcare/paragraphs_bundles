<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="paragraphs_bundles">
  <description>Drupal + DrupalPractice coding standards for Paragraphs Bundles.</description>

  <file>.</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*.css</exclude-pattern>
  <exclude-pattern>*.svg</exclude-pattern>
  <exclude-pattern>*.json</exclude-pattern>
  <exclude-pattern>*.yml</exclude-pattern>
  <exclude-pattern>*.md</exclude-pattern>

  <!-- One-off porting/migration tooling (export-ignore in .gitattributes). -->
  <exclude-pattern>*/scripts/*</exclude-pattern>

  <!-- Generated documentation artefacts (export-ignore in .gitattributes).
       Individual *.md files need no entry — *.md above already excludes them. -->
  <exclude-pattern>*/docs/generated/*</exclude-pattern>

  <!-- Test fixtures: multi-interface stub file (not one-class-per-file), plus
       third-party assets downloaded at CI time (e.g. axe-core). -->
  <exclude-pattern>*/tests/stubs/*</exclude-pattern>
  <exclude-pattern>*/tests/fixtures/*</exclude-pattern>

  <arg name="extensions" value="php,module,theme,inc,install,js"/>
  <arg name="colors"/>
  <arg value="np"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>

  <!-- PHPCS and Prettier make contradictory demands on JavaScript switch
       statements, and both gate the drupal.org pipeline (phpcs is a hard
       failure; eslint runs prettier through eslint-plugin-prettier).

       This sniff requires a blank line after a case `break;`. When the case
       body is a braced block - which ESLint's no-case-declarations forces on
       any case that declares a const - that blank line lands immediately
       before the closing `}`, and Prettier strips blank lines at the end of a
       block. Verified 2026-08-03 on
       modules/paragraph_bundle_parallax/js/paragraph-bundle-parallax.js:
       phpcbf inserts exactly 4 such lines and prettier 3.6.2 with core's
       .prettierrc.json removes exactly those same 4. There is no source text
       that satisfies both tools.

       Drupal core never hits this because it does not sniff JavaScript at all
       (its phpcs.xml.dist `extensions` list has no `js`); JS there is owned by
       ESLint + Prettier. This module deliberately keeps JS under PHPCS for the
       rest of the standard, so only the one contradictory message is turned
       off, and only for JS. PHP files keep the sniff. -->
  <rule ref="Squiz.ControlStructures.SwitchDeclaration.SpacingAfterBreak">
    <exclude-pattern>*\.js$</exclude-pattern>
  </rule>
</ruleset>
