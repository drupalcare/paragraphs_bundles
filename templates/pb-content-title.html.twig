{#
/**
 * @file
 * Renders pb_content_title with configurable heading tag and alignment.
 *
 * When Title tag or Title alignment are empty (None in the form), the
 * output uses heading H3 and left alignment.
 *
 * Available variables:
 * - paragraph: The paragraph entity.
 * - content: The paragraph render array (must include pb_content_title).
 * - title_extra_classes: Optional extra classes (space-separated)
 *   appended to the title.
 *
 * THERE IS NO `title_style`, DELIBERATELY. Its only caller was the image
 * overlay, whose colours now reach this element through the paragraph's
 * generated stylesheet — see PbDynamicUserVarBuilder::USER_STYLE_SCOPES,
 * `image_overlay_bundle`. A style ATTRIBUTE cannot be permitted by a Content
 * Security Policy except through 'unsafe-inline'; unlike a <style> element it
 * cannot carry a nonce. Do not reintroduce one here — put the value in the
 * generated CSS instead.
 */
#}
{% set _tags = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'div'] %}
{% if paragraph.hasField('pb_content_title_tag') and not paragraph.pb_content_title_tag.isEmpty() %}
  {% set _tag = paragraph|pb_field_value('pb_content_title_tag') %}
{% else %}
  {% set _tag = 'h3' %}
{% endif %}
{% if _tag not in _tags %}
  {% set _tag = 'h3' %}
{% endif %}

{% set _aligns = ['left', 'center', 'right'] %}
{% if paragraph.hasField('pb_content_title_alignment') and not paragraph.pb_content_title_alignment.isEmpty() %}
  {% set _align = paragraph|pb_field_value('pb_content_title_alignment') %}
{% else %}
  {% set _align = 'left' %}
{% endif %}
{% if _align not in _aligns %}
  {% set _align = 'left' %}
{% endif %}

{% set _base = 'pb-content__title pb-content__title--align-' ~ _align %}
{% set _extra = title_extra_classes|default('')|trim %}

<{{ _tag }} class="{{ _base }}{{ _extra ? ' ' ~ _extra : '' }}">{{ content.pb_content_title }}</{{ _tag }}>
