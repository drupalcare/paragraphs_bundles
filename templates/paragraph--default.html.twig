{#
/**
 * @file
 * Default theme implementation to display a paragraph (v2).
 *
 * v2 contract:
 *   - Foundation styles ship in `paragraphs_bundles/paragraphs-bundles`
 *     (loaded once per page).
 *   - Per-paragraph color/background values previously emitted as
 *     `style="--pb-bg:rgba(...);"` are now written to a dedicated CSS
 *     file (`pb-{slug}-{id}.css`) by `paragraphs_bundles.css.dynamic_builder`
 *     on save, and attached here via `attach_library('paragraphs_bundles/dynamic--…')`.
 *   - The DOM id (`pb__{slug}-{id}`) and inner class names are kept
 *     verbatim from v1 so existing sub-theme CSS keeps working.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 * - content: All paragraph items.
 * - attributes: HTML attributes for the containing element.
 * - pb_paragraph_id: DOM id added by PbPreprocessHook (`pb__{slug}-{id}`).
 * - pb_dynamic_library: Library id for this paragraph's dynamic CSS.
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{# Always attach the foundation library. #}
{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}

{# Attach per-paragraph dynamic CSS when pb-{slug}-{id}.css exists. #}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{# DOM id used as the CSS scope for the dynamic file. #}
{% set paragraph_id = pb_paragraph_id ?: 'pb__default-' ~ paragraph.id.value %}
{# Inner-wrapper classes (sub-theme contract). #}
{% set classes_inner = 'pb-ui-inner pb__default__inner' %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{# Display modifiers (kebab-case literal class names from select-list values). #}
{% set pb_displays = [
  'pb_display_width',
  'pb_display_border',
  'pb_display_border_radius',
  'pb_display_margin',
  'pb_display_padding',
  'pb_display_shadow',
] %}
{% for pb_display in pb_displays %}
  {% set display_value = paragraph|pb_field_value(pb_display) %}
  {% set classes_inner = display_value ? classes_inner ~ ' ' ~ (display_value|pb_class) : classes_inner %}
{% endfor %}

{% set pb_title = content.pb_content_title|render|striptags|trim %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">

    <div class="pb-content__full">

      {% if pb_title %}
        {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
      {% endif %}

      {{ content|without(
        'pb_content_title',
        'pb_content_title_tag',
        'pb_content_title_alignment',
        'pb_display_bg',
        'pb_display_bg_opacity',
        'pb_display_bg_hover',
        'pb_display_border_color',
        'pb_display_border_hover',
        'pb_display_text',
        'pb_display_text_hover',
        'pb_display_link',
        'pb_display_link_hover',
        'pb_display_border',
        'pb_display_border_radius',
        'pb_display_margin',
        'pb_display_padding',
        'pb_display_width',
        'pb_display_shadow',
      ) }}

    </div>

  </div>
</div>
