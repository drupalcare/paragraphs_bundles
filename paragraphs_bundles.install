<?php

/**
 * @file
 * Install / uninstall / update hooks for paragraphs_bundles (v2).
 *
 * V2 update hooks (pre-release; run `drush updb` once):
 *  - 9005: shared field storages + title/link field metadata.
 *  - 9006: wire shared fields, nest Display tab, hide pb_display_* on view
 *    displays (all paragraph bundles).
 *  - 9007: repair v1 config values that fail D11 config-schema validation.
 *  - 9008: realign display layout (weights, stale `hidden` entries, field
 *    group child order) with the config a fresh install of this version
 *    imports, so both install paths end on the same edit forms.
 *
 * **Why v2 numbering starts at 9005.** V1 defined its update hooks in
 * `paragraphs_bundles.module` rather than a `.install` file — unusual, but
 * Drupal discovers `{module}_update_N()` wherever it is defined, because
 * `.module` is always loaded. V1 shipped 9001 through 9004, so every v1 site
 * stores `system.schema` = 9004. Drupal runs only updates numbered ABOVE the
 * stored value, so any v2 hook numbered 9001-9004 is silently skipped on
 * exactly the sites that need it. Grepping for `*.install` to check whether v1
 * had update hooks returns nothing and is misleading — grep for
 * `_update_[0-9]` across all files instead.
 *
 * The per-paragraph dynamic-CSS backfill is a **post_update**, not an update
 * hook. It must run after 9001 and 9006 have created and wired the
 * `pb_display_*` fields, because it reads those fields to generate the CSS.
 * hook_update_N runs in numeric order, so a backfill numbered below 9006 would
 * read fields that do not exist yet and write empty stylesheets; numbering it
 * above 9006 would only hold until the next update hook is added. Drupal runs
 * every post_update after every hook_update_N, which makes the ordering
 * structural instead of a numbering convention someone has to remember.
 *
 * See docs/PB-V2-TESTING-WORKFLOW.md for maintainer test paths (fresh install
 * vs v1 drop-over). Dev DBs from fragmented v2 hook numbers (9007–9015) must
 * be reset — trash DB and retest from v1 baseline before release.
 *
 * Helpers `paragraphs_bundles_pb_wire_shared_fields_for_bundle()` and
 * `paragraphs_bundles_get_pb_bundles()` centralise bundle discovery;
 * sub-modules do not need their own .install for shared fields.
 *
 * Display tab nest helpers live in paragraphs_bundles.display.inc. Parent
 * .install requires it directly. Bundle sub-module update hooks must call
 * \Drupal::moduleHandler()->loadInclude('paragraphs_bundles', 'inc',
 * 'paragraphs_bundles.display') before nest helpers.
 */

declare(strict_types=1);

require_once __DIR__ . '/paragraphs_bundles.display.inc';

use Drupal\Core\Config\Entity\ConfigEntityInterface;
use Drupal\Core\Config\Entity\ConfigEntityStorageInterface;
use Drupal\Core\Config\FileStorage;
use Drupal\Core\Entity\Display\EntityDisplayInterface;
use Drupal\Core\Entity\Display\EntityFormDisplayInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\paragraphs_bundles\Service\Css\PbCssFileManagerInterface;

/**
 * Adds the CSS Classes field to one bundle on a site that already has it.
 *
 * Config in `config/optional` installs on a FRESH install only, so without
 * this an existing site keeps the bundle it has and never sees the field.
 * Every sub-module owning a parent bundle calls this from its own
 * `hook_update_N`, so a site that installed only some sub-modules updates
 * exactly the bundles it actually has.
 *
 * Safe to re-run: every step is guarded, and re-running on a site that got
 * the field from a fresh install of the same code changes nothing.
 *
 * @param string $module_name
 *   Module whose `config/optional` holds the field instance.
 * @param string $bundle
 *   Paragraph type machine name.
 *
 * @return bool
 *   TRUE when the field exists on the bundle once the call returns.
 */
function paragraphs_bundles_pb_css_classes_wire_bundle(string $module_name, string $bundle): bool {
  // Storage lives in the parent module and is shared by all 31 bundles; the
  // instance lives with the sub-module that owns the bundle.
  paragraphs_bundles_import_optional_config_if_missing(
    'paragraphs_bundles',
    'field.storage.paragraph.pb_display_css_classes',
  );
  paragraphs_bundles_import_optional_config_if_missing(
    $module_name,
    'field.field.paragraph.' . $bundle . '.pb_display_css_classes',
  );

  $em = \Drupal::entityTypeManager();
  $exists = (bool) $em->getStorage('field_config')
    ->load('paragraph.' . $bundle . '.pb_display_css_classes');
  if (!$exists) {
    return FALSE;
  }

  // On the edit form. Weight 60 keeps it below every other display field;
  // the Advanced group it lands in is ordered by the group registry, not
  // by this weight, but the weight still decides the ungrouped fallback.
  $fd = $em->getStorage('entity_form_display')->load('paragraph.' . $bundle . '.default');
  if ($fd instanceof EntityFormDisplayInterface
    && !$fd->getComponent('pb_display_css_classes')) {
    $fd->setComponent('pb_display_css_classes', [
      'type' => 'string_textfield',
      'weight' => 60,
      'region' => 'content',
      'settings' => ['size' => 60, 'placeholder' => ''],
      'third_party_settings' => [],
    ])->save();
  }

  // Off the rendered output: the preprocess hook reads the stored value and
  // puts it on the wrapper, so printing it as a field would duplicate it as
  // visible text.
  $vd = $em->getStorage('entity_view_display')->load('paragraph.' . $bundle . '.default');
  if ($vd instanceof EntityViewDisplayInterface
    && $vd->getComponent('pb_display_css_classes')) {
    $vd->removeComponent('pb_display_css_classes')->save();
  }

  // Nest it under Display → Advanced, from the one group registry.
  \Drupal::moduleHandler()->loadInclude('paragraphs_bundles', 'inc', 'paragraphs_bundles.display');
  paragraphs_bundles_pb_nest_display_field_groups($bundle);

  return TRUE;
}

/**
 * Implements hook_install().
 *
 * A site that already has paragraphs gets its Paragraphs List index filled by
 * a chunked queue on cron, not by one long install request.
 */
function paragraphs_bundles_install(): void {
  if (\Drupal::database()->schema()->tableExists('paragraphs_bundles_list_index')) {
    \Drupal::queue('paragraphs_bundles_list_index_rebuild')->createItem(['after' => 0]);
  }
}

/**
 * Implements hook_uninstall().
 *
 * Wipe the public://paragraphs_bundles/ directory so reinstalls start
 * clean.
 */
function paragraphs_bundles_uninstall(): void {
  // The Paragraphs List index table is dropped with the module (hook_schema);
  // its rebuild queue is not, so empty it here.
  \Drupal::queue('paragraphs_bundles_list_index_rebuild')->deleteQueue();
  /** @var \Drupal\paragraphs_bundles\Service\Css\PbCssFileManagerInterface $files */
  $files = \Drupal::service(PbCssFileManagerInterface::class);
  $files->deleteAll();
}

/**
 * Implements hook_schema().
 *
 * The Paragraphs List index: one row per paragraph, DERIVED from the
 * paragraphs' own parent_type / parent_id columns and never edited by hand.
 * It exists so the list page can answer every query from an index and touch
 * one page of rows, however many paragraphs the site holds. No node titles are
 * stored here (node_field_data owns them); `label` is a derived copy of
 * Paragraph::label(), kept so the page can search and sort it.
 *
 * @return array<string, array<string, mixed>>
 *   The table definitions.
 */
function paragraphs_bundles_schema(): array {
  $schema['paragraphs_bundles_list_index'] = [
    'description' => 'Derived Paragraphs List index: one row per paragraph.',
    'fields' => [
      'pid' => [
        'description' => 'The paragraph id.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'bundle' => [
        'description' => 'The paragraph type.',
        'type' => 'varchar_ascii',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
      ],
      'root_type' => [
        'description' => 'Entity type at the top of the chain; empty when orphaned.',
        'type' => 'varchar_ascii',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
      ],
      'root_id' => [
        'description' => 'Id of the root entity; 0 when orphaned. Not NULL so keyset paging can compare it.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'depth' => [
        'description' => 'Nesting depth: 1 is a direct child of the root; 0 when orphaned.',
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'langcode' => [
        'description' => 'The paragraph default language.',
        'type' => 'varchar_ascii',
        'length' => 12,
        'not null' => TRUE,
        'default' => '',
      ],
      'label' => [
        'description' => 'Derived copy of Paragraph::label(), first 191 characters.',
        'type' => 'varchar',
        // 191, not 255: Drupal's MySQL driver prefixes any longer index at 191
        // characters, and a prefix index cannot serve ORDER BY, so a longer
        // column would make sorting by label a full scan with a filesort.
        'length' => 191,
        'not null' => TRUE,
        'default' => '',
      ],
      'root_title' => [
        'description' => 'Derived copy of the root entity label() in its default translation, first 191 characters; empty when orphaned.',
        'type' => 'varchar',
        // 191 for the same reason as label: a longer column gets a prefix index
        // that cannot serve ORDER BY.
        'length' => 191,
        'not null' => TRUE,
        'default' => '',
      ],
    ],
    'primary key' => ['pid'],
    'indexes' => [
      'bundle_pid' => ['bundle', 'pid'],
      'root_pid' => ['root_type', 'root_id', 'pid'],
      'label_pid' => ['label', 'pid'],
      'root_title_pid' => ['root_title', 'pid'],
    ],
  ];
  return $schema;
}

/**
 * Imports one optional config entity if it is not already active.
 *
 * Used by update hooks in this module and in paragraph_bundle_*
 * sub-modules (the v1 helper signature is preserved verbatim).
 */
function paragraphs_bundles_import_optional_config_if_missing(string $module_name, string $config_name): void {
  $existing = \Drupal::configFactory()->get($config_name);
  if (!$existing->isNew()) {
    return;
  }
  $module_handler = \Drupal::moduleHandler();
  if (!$module_handler->moduleExists($module_name)) {
    return;
  }
  $config_storage = new FileStorage($module_handler->getModule($module_name)->getPath() . '/config/optional');
  $config_record = $config_storage->read($config_name);
  if (!$config_record) {
    return;
  }
  $entity_type = \Drupal::service('config.manager')->getEntityTypeIdByName($config_name);
  if ($entity_type === NULL) {
    return;
  }
  $storage = \Drupal::entityTypeManager()->getStorage($entity_type);
  // createFromStorageRecord() is declared on ConfigEntityStorageInterface, not
  // on EntityStorageInterface. getEntityTypeIdByName() should only ever name a
  // config entity type, but an unguarded call here would fatal mid-`updatedb`,
  // which is the worst possible place to find out otherwise.
  if (!$storage instanceof ConfigEntityStorageInterface) {
    \Drupal::logger('paragraphs_bundles')->error(
      'Skipped optional config @config: storage for entity type @type is not a config entity storage.',
      ['@config' => $config_name, '@type' => $entity_type]
    );
    return;
  }
  $entity = $storage->createFromStorageRecord($config_record);
  $entity->save();
}

/**
 * Ensure shared title-tag / title-alignment field storages.
 */
function paragraphs_bundles_ensure_pb_title_storages(): void {
  foreach ([
    'field.storage.paragraph.pb_content_title_tag',
    'field.storage.paragraph.pb_content_title_alignment',
  ] as $config_name) {
    paragraphs_bundles_import_optional_config_if_missing('paragraphs_bundles', $config_name);
  }
}

/**
 * Import optional title tag/alignment field instances for a bundle.
 *
 * @param string $bundle
 *   Paragraph type machine name.
 * @param string|null $module_name
 *   Module providing the YAML files; auto-discovered when NULL.
 */
function paragraphs_bundles_pb_title_import_instances_for_bundle(string $bundle, ?string $module_name = NULL): void {
  foreach ([
    'pb_content_title_tag',
    'pb_content_title_alignment',
  ] as $field_name) {
    $config_name = 'field.field.paragraph.' . $bundle . '.' . $field_name;
    $provider = $module_name ?? paragraphs_bundles_get_optional_config_provider($config_name);
    if ($provider === NULL) {
      continue;
    }
    paragraphs_bundles_import_optional_config_if_missing($provider, $config_name);
  }
}

/**
 * Bumps Content tab field/group weights colliding with the title (1-3).
 *
 * The field_group module sorts siblings by entity form display weight, not
 * children order.
 *
 * @param array<string, mixed> $content
 *   Form display content section (by reference).
 * @param array<string, mixed> $groups
 *   Field group definitions (by reference).
 */
function paragraphs_bundles_pb_bump_content_tab_tail_weights(
  array &$content,
  array &$groups,
): void {
  $content_group = $groups['group_pb_tab_content'] ?? NULL;
  $children = is_array($content_group) ? $content_group['children'] ?? [] : [];
  if (!is_array($children)) {
    return;
  }

  $weight = 4;
  foreach (array_slice($children, 3) as $child) {
    if (!is_string($child)) {
      continue;
    }
    if (str_starts_with($child, 'group_')) {
      if (isset($groups[$child]) && is_array($groups[$child])
        && ($groups[$child]['weight'] ?? 99) <= 3) {
        $groups[$child]['weight'] = $weight++;
      }
      continue;
    }
    if (isset($content[$child]) && is_array($content[$child])
      && ($content[$child]['weight'] ?? 99) <= 3) {
      $content[$child]['weight'] = $weight++;
    }
  }
}

/**
 * Add title tag/alignment widgets after pb_content_title; hide on default view.
 */
function paragraphs_bundles_pb_title_wire_bundle(string $bundle): void {
  $em = \Drupal::entityTypeManager();
  $form_id = 'paragraph.' . $bundle . '.default';
  $fd = $em->getStorage('entity_form_display')->load($form_id);
  if (!$fd) {
    return;
  }
  $content = paragraphs_bundles_pb_array_prop($fd->get('content'));
  if (!isset($content['pb_content_title'])) {
    return;
  }

  // Existing widget settings are kept; only the weight is forced, so the three
  // title fields always lead the Content tab in a fixed order.
  $hidden = paragraphs_bundles_pb_array_prop($fd->get('hidden'));
  foreach (['pb_content_title_tag' => 2, 'pb_content_title_alignment' => 3] as $field => $field_weight) {
    $existing = $content[$field] ?? NULL;
    $content[$field] = is_array($existing)
      ? ['weight' => $field_weight] + $existing
      : [
        'type' => 'options_select',
        'weight' => $field_weight,
        'region' => 'content',
        'settings' => [],
        'third_party_settings' => [],
      ];
    // A v1 display lists these under `hidden`. Writing into `content` without
    // dropping that entry leaves the component in BOTH lists — a state
    // EntityDisplayBase::setComponent() can never produce and preSave() does
    // not repair, so it survives every later save and every config export.
    unset($hidden[$field]);
  }
  $fd->set('hidden', $hidden);
  if (is_array($content['pb_content_title'])) {
    $content['pb_content_title']['weight'] = 1;
  }

  $third = paragraphs_bundles_pb_array_prop($fd->get('third_party_settings'));
  if (!empty($third['field_group']) && is_array($third['field_group'])) {
    $field_groups = paragraphs_bundles_pb_array_prop($third['field_group']);
    paragraphs_bundles_pb_normalize_field_group_names($field_groups);
    $content_tab = paragraphs_bundles_pb_array_prop($field_groups['group_pb_tab_content'] ?? NULL);
    if (isset($content_tab['children']) && is_array($content_tab['children'])) {
      $tail = array_values(array_filter(
        $content_tab['children'],
        static fn(mixed $child): bool => is_string($child)
          && !in_array($child, [
            'pb_content_title',
            'pb_content_title_tag',
            'pb_content_title_alignment',
          ], TRUE),
      ));
      $content_tab['children'] = array_merge(
        ['pb_content_title', 'pb_content_title_tag', 'pb_content_title_alignment'],
        $tail,
      );
      $field_groups['group_pb_tab_content'] = $content_tab;
    }
    paragraphs_bundles_pb_bump_content_tab_tail_weights($content, $field_groups);
    $third['field_group'] = $field_groups;
    $fd->set('third_party_settings', $third);
  }

  $fd->set('content', $content);

  $dependencies = paragraphs_bundles_pb_array_prop($fd->get('dependencies'));
  if (!isset($dependencies['config']) || !is_array($dependencies['config'])) {
    $dependencies['config'] = [];
  }
  foreach ([
    'field.field.paragraph.' . $bundle . '.pb_content_title_tag',
    'field.field.paragraph.' . $bundle . '.pb_content_title_alignment',
  ] as $dep) {
    if (!in_array($dep, $dependencies['config'], TRUE)) {
      $dependencies['config'][] = $dep;
    }
  }
  sort($dependencies['config']);
  $fd->set('dependencies', $dependencies);
  $fd->save();

  $vd = $em->getStorage('entity_view_display')->load('paragraph.' . $bundle . '.default');
  if ($vd) {
    $hidden = paragraphs_bundles_pb_array_prop($vd->get('hidden'));
    $hidden['pb_content_title_tag'] = TRUE;
    $hidden['pb_content_title_alignment'] = TRUE;
    $vd->set('hidden', $hidden);
    $deps = paragraphs_bundles_pb_array_prop($vd->get('dependencies'));
    if (!isset($deps['config']) || !is_array($deps['config'])) {
      $deps['config'] = [];
    }
    foreach ([
      'field.field.paragraph.' . $bundle . '.pb_content_title_tag',
      'field.field.paragraph.' . $bundle . '.pb_content_title_alignment',
    ] as $dep) {
      if (!in_array($dep, $deps['config'], TRUE)) {
        $deps['config'][] = $dep;
      }
    }
    sort($deps['config']);
    $vd->set('dependencies', $deps);
    $vd->save();
  }
}

/**
 * Clears field widget/formatter and entity field definition caches.
 */
function paragraphs_bundles_clear_field_caches(): void {
  \Drupal::service('plugin.manager.field.widget')->clearCachedDefinitions();
  \Drupal::service('plugin.manager.field.formatter')->clearCachedDefinitions();
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
}

/**
 * Paragraph bundle machine names that use paragraphs_bundles display fields.
 *
 * Uses pb_display_bg as the marker — every standard PB bundle ships it.
 *
 * @return list<string>
 *   Bundle machine names.
 */
function paragraphs_bundles_get_pb_bundles(): array {
  $storage = \Drupal::entityTypeManager()->getStorage('field_config');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('entity_type', 'paragraph')
    ->condition('field_name', 'pb_display_bg')
    ->execute();
  $bundles = [];
  foreach ($storage->loadMultiple($ids) as $field) {
    if (!$field instanceof FieldConfig) {
      continue;
    }
    // getTargetBundle() is nullable. A field_config with no target bundle is
    // not something the upgrade can act on, and a NULL reaching the bundle
    // loop would be coerced to '' and silently upgrade nothing.
    $bundle = $field->getTargetBundle();
    if ($bundle !== NULL) {
      $bundles[] = $bundle;
    }
  }
  return array_values(array_unique($bundles));
}

/**
 * Enabled paragraph_bundle_* sub-module machine names.
 *
 * @return list<string>
 *   Sorted module names.
 */
function paragraphs_bundles_get_sub_module_names(): array {
  /** @var list<string>|null $names */
  static $names = NULL;
  if ($names !== NULL) {
    return $names;
  }
  $collected = [];
  $module_handler = \Drupal::moduleHandler();
  foreach (array_keys($module_handler->getModuleList()) as $module) {
    if (str_starts_with($module, 'paragraph_bundle_')) {
      $collected[] = $module;
    }
  }
  sort($collected);
  $names = $collected;
  return $names;
}

/**
 * Finds which enabled module ships an optional config file.
 *
 * @param string $config_name
 *   Config entity name without .yml (e.g. field.field.paragraph.x.y).
 *
 * @return string|null
 *   Module machine name, or NULL when no file is found.
 */
function paragraphs_bundles_get_optional_config_provider(string $config_name): ?string {
  /** @var array<string, string|null> $cache */
  static $cache = [];
  if (array_key_exists($config_name, $cache)) {
    return $cache[$config_name];
  }
  $module_handler = \Drupal::moduleHandler();
  $candidates = array_merge(
    ['paragraphs_bundles'],
    paragraphs_bundles_get_sub_module_names()
  );
  foreach ($candidates as $module) {
    if (!$module_handler->moduleExists($module)) {
      continue;
    }
    $path = $module_handler->getModule($module)->getPath()
      . '/config/optional/' . $config_name . '.yml';
    if (is_readable($path)) {
      $cache[$config_name] = $module;
      return $module;
    }
  }
  $cache[$config_name] = NULL;
  return NULL;
}

/**
 * Reads a shipped optional config file as a raw array.
 *
 * @param string $config_name
 *   Config entity name without .yml (e.g. core.entity_form_display.x.y.z).
 *
 * @return array<string, mixed>|null
 *   Decoded file contents, or NULL when no enabled module ships the file.
 */
function paragraphs_bundles_pb_read_optional_config(string $config_name): ?array {
  $module = paragraphs_bundles_get_optional_config_provider($config_name);
  if ($module === NULL) {
    return NULL;
  }
  $storage = new FileStorage(
    \Drupal::moduleHandler()->getModule($module)->getPath() . '/config/optional'
  );
  $record = $storage->read($config_name);
  return is_array($record) ? paragraphs_bundles_pb_array_prop($record) : NULL;
}

/**
 * Gives an upgraded site a shipped value it still has an older copy of.
 *
 * Config in config/optional reaches a site once, when the module is
 * installed, so a label or help text improved in a later release never
 * arrives on a site that already has it. This copies the shipped value, read
 * from the module's own file so the words live in one place, but only while
 * the site still holds exactly what the older release shipped: a value the
 * site changed itself is its own and is kept.
 *
 * @param string $config_name
 *   Config entity name without .yml (e.g. field.field.paragraph.x.y).
 * @param string $property
 *   Top-level property to adopt, such as `label` or `description`.
 * @param string $previous
 *   The value the older release shipped.
 *
 * @return string
 *   `updated`, `current` (already the shipped value), `kept` (the site's own
 *   value), or `absent` (not on this site, or nothing shipped).
 */
function paragraphs_bundles_pb_adopt_shipped_property(string $config_name, string $property, string $previous): string {
  $shipped = paragraphs_bundles_pb_read_optional_config($config_name)[$property] ?? NULL;
  $entity = \Drupal::service('config.manager')->loadConfigEntityByName($config_name);
  if (!is_string($shipped) || !$entity instanceof ConfigEntityInterface) {
    return 'absent';
  }
  $current = $entity->get($property);
  $current = is_string($current) ? $current : '';
  if ($current === $shipped) {
    return 'current';
  }
  if ($current !== $previous) {
    return 'kept';
  }
  $entity->set($property, $shipped)->save();
  return 'updated';
}

/**
 * Adopts shipped values for several config entities and reports the result.
 *
 * @param array<string, string> $config_names
 *   Previous shipped value, keyed by config entity name.
 * @param string $property
 *   Top-level property to adopt, such as `label` or `description`.
 *
 * @return string
 *   One sentence: how many were updated and how many kept the site's own.
 */
function paragraphs_bundles_pb_adopt_shipped_properties(array $config_names, string $property): string {
  $counts = ['updated' => 0, 'current' => 0, 'kept' => 0, 'absent' => 0];
  foreach ($config_names as $config_name => $previous) {
    $counts[paragraphs_bundles_pb_adopt_shipped_property($config_name, $property, $previous)]++;
  }
  return (string) t('@property: @updated updated to the shipped text, @current already current, @kept kept with this site\'s own text, @absent not on this site.', [
    '@property' => $property,
    '@updated' => $counts['updated'],
    '@current' => $counts['current'],
    '@kept' => $counts['kept'],
    '@absent' => $counts['absent'],
  ]);
}

/**
 * Realigns one display entity's layout with the config this module ships.
 *
 * Three kinds of drift are repaired, all of them differences between a site
 * upgraded from v1 and a fresh v2 install of the same code:
 *  - component weights that the programmatic wiring computed rather than took
 *    from the shipped file;
 *  - components left in `hidden` while also present in `content`;
 *  - field_group children listed in a different order.
 *
 * Only components and groups the module itself ships are touched, and a child
 * the site added to a shipped group is kept (appended), never dropped.
 *
 * @param \Drupal\Core\Entity\Display\EntityDisplayInterface $display
 *   The active display to realign.
 * @param array<string, mixed> $shipped
 *   Raw contents of the matching config/optional file.
 * @param array<string, int> $stats
 *   Running totals, keyed weights / unhidden / groups; modified in place.
 *
 * @return bool
 *   TRUE when the display was changed and needs saving.
 */
function paragraphs_bundles_pb_realign_display(
  EntityDisplayInterface $display,
  array $shipped,
  array &$stats,
): bool {
  $changed = FALSE;
  $content = paragraphs_bundles_pb_array_prop($display->get('content'));
  $hidden = paragraphs_bundles_pb_array_prop($display->get('hidden'));

  // 1. Weights, for components present in both the shipped file and the site.
  // A component the site added, or one it has hidden, is left alone.
  foreach (paragraphs_bundles_pb_array_prop($shipped['content'] ?? NULL) as $field => $options) {
    if (!is_string($field) || !is_array($options) || !isset($options['weight'])) {
      continue;
    }
    if (!isset($content[$field]) || !is_array($content[$field])) {
      continue;
    }
    if (($content[$field]['weight'] ?? NULL) === $options['weight']) {
      continue;
    }
    $content[$field]['weight'] = $options['weight'];
    $stats['weights']++;
    $changed = TRUE;
  }

  // 2. A component cannot be visible and hidden at once. `content` wins, which
  // is what getComponent() already resolves to, so this changes no behaviour —
  // it removes a contradictory entry the v1 wiring path left behind.
  foreach (array_keys($content) as $field) {
    if (isset($hidden[$field])) {
      unset($hidden[$field]);
      $stats['unhidden']++;
      $changed = TRUE;
    }
  }

  // 3. Field group weight and child order.
  $third = paragraphs_bundles_pb_array_prop($display->get('third_party_settings'));
  $groups = paragraphs_bundles_pb_array_prop($third['field_group'] ?? NULL);
  $shipped_third = paragraphs_bundles_pb_array_prop($shipped['third_party_settings'] ?? NULL);
  foreach (paragraphs_bundles_pb_array_prop($shipped_third['field_group'] ?? NULL) as $name => $shipped_group) {
    if (!is_string($name) || !is_array($shipped_group)) {
      continue;
    }
    $group = paragraphs_bundles_pb_array_prop($groups[$name] ?? NULL);
    if ($group === []) {
      continue;
    }
    $group_changed = FALSE;
    if (isset($shipped_group['weight']) && ($group['weight'] ?? NULL) !== $shipped_group['weight']) {
      $group['weight'] = $shipped_group['weight'];
      $stats['groups']++;
      $group_changed = TRUE;
    }
    $shipped_children = array_values(array_filter(
      paragraphs_bundles_pb_array_prop($shipped_group['children'] ?? NULL),
      'is_string',
    ));
    $current_children = array_values(array_filter(
      paragraphs_bundles_pb_array_prop($group['children'] ?? NULL),
      'is_string',
    ));
    // Shipped order first, then anything this site added, in the order it had.
    $reordered = array_merge(
      array_values(array_intersect($shipped_children, $current_children)),
      array_values(array_diff($current_children, $shipped_children)),
    );
    if ($reordered !== $current_children) {
      $group['children'] = $reordered;
      $stats['groups']++;
      $group_changed = TRUE;
    }
    if ($group_changed) {
      $groups[$name] = $group;
      $changed = TRUE;
    }
  }

  if ($changed) {
    $display->set('content', $content);
    $display->set('hidden', $hidden);
    if ($groups !== []) {
      $third['field_group'] = $groups;
      $display->set('third_party_settings', $third);
    }
  }
  return $changed;
}

/**
 * Help text for the shared pb_content_title field (config + update 9004).
 *
 * Stored as English on the field; use configuration translation if
 * needed.
 */
function paragraphs_bundles_pb_content_title_help_description(): string {
  return 'Use Title tag and Title alignment to set the heading level and text alignment. None is the default for those fields; if they are unset, the bundle Twig template renders this title as H3 with left alignment.';
}

/**
 * Implements hook_update_dependencies().
 *
 * @phpstan-return array<string, array<int, array<string, int>>>
 */
function paragraphs_bundles_update_dependencies(): array {
  // Bundle sub-modules whose update 9001 must run after this module's 9006.
  //
  // Each of these restructures its bundle's Display tab through
  // paragraphs_bundles_pb_nest_display_field_groups(), which operates on the
  // shared pb_display_* fields that 9006 wires onto the bundle. Running one of
  // them first would nest field groups around fields that are not there yet.
  //
  // Keep this list in step with the sub-module .install files: add an entry
  // whenever a sub-module gains an update hook that touches shared fields.
  // A sub-module absent from hook_update_dependencies() is ordered only by
  // module name, and every paragraph_bundle_* sorts BEFORE paragraphs_bundles
  // ('_' < 's'), so the wrong order is the silent default, not the exception.
  $submodules = [
    'paragraph_bundle_3d_carousel' => 9001,
    'paragraph_bundle_content' => 9001,
    'paragraph_bundle_image_background' => 9001,
  ];

  $dependencies = [];
  foreach ($submodules as $module => $update) {
    $dependencies[$module][$update]['paragraphs_bundles'] = 9006;
  }
  return $dependencies;
}

/**
 * Implements hook_update_last_removed().
 *
 * V1 shipped `paragraphs_bundles_update_9001()` … `_9004()` (defined in
 * `paragraphs_bundles.module`, not a `.install` file — see the file header).
 * V2 dropped all four, so a site still below 9004 cannot reach a consistent
 * state from here: the intermediate steps no longer exist to run. Declaring
 * 9004 makes Drupal refuse the update with a "requires an intermediate
 * version" message instead of silently skipping the missing work.
 */
function paragraphs_bundles_update_last_removed(): int {
  return 9004;
}

/**
 * Installs shared v2 field storages and refreshes title field metadata.
 */
function paragraphs_bundles_update_9005(): string {
  // NUMBERING — do not renumber below 9005. V1's own update hooks ran to 9004
  // (defined in paragraphs_bundles.module; see the file header), so every real
  // v1 site sits at system.schema 9004. Drupal runs only updates numbered ABOVE
  // the stored schema, so while this step carried the number 9001 it never ran
  // on any v1 site: `drush updb` reported success and the shared v2 field
  // storages were silently never installed. Verified against a real v1 install
  // — see docs/PB-V2-RELEASE-LOG.md.
  //
  // Keep this docblock to ONE line: `drush updatedb:status` prints the whole
  // docblock in a narrow column, so prose here becomes an unreadable wall of
  // text on the screen a site owner reads before upgrading production.
  paragraphs_bundles_ensure_pb_title_storages();
  paragraphs_bundles_ensure_pb_link_storages();

  $storage = \Drupal::entityTypeManager()->getStorage('field_config');
  $desc = paragraphs_bundles_pb_content_title_help_description();
  $title_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('entity_type', 'paragraph')
    ->condition('field_name', 'pb_content_title')
    ->execute();
  foreach ($storage->loadMultiple($title_ids) as $field) {
    if (!$field instanceof FieldConfig) {
      continue;
    }
    $field->setDescription($desc);
    $field->save();
  }

  $tag_ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('entity_type', 'paragraph')
    ->condition('field_name', ['pb_content_title_tag', 'pb_content_title_alignment'], 'IN')
    ->execute();
  foreach ($storage->loadMultiple($tag_ids) as $field) {
    if (!$field instanceof FieldConfig) {
      continue;
    }
    if ($field->isRequired()) {
      $field->setRequired(FALSE);
    }
    $field->setDefaultValue([]);
    $field->save();
  }

  paragraphs_bundles_clear_field_caches();
  return (string) t('Installed shared v2 field storages and refreshed title metadata.');
}

/**
 * Wires ALL shared v2 fields for one bundle in a single call.
 *
 * Safe to call multiple times — all operations are idempotent.
 *
 * Covers:
 *  - pb_content_title_tag / pb_content_title_alignment (Content tab)
 *  - pb_display_link / pb_display_link_hover (Display tab)
 *  - Display tab color field order (base then hover per group)
 *
 * When optional YAML exists (v1 sub-module or v2 port), it is imported.
 * Link field instances are created programmatically when YAML is absent
 * (typical v1→v2 upgrade before sub-module v2 YAML ships).
 *
 * @param string $bundle
 *   Paragraph type machine name (e.g. 'hero_bundle').
 * @param string|null $module_name
 *   Module providing field instance YAML; auto-discovered when NULL.
 */
function paragraphs_bundles_pb_wire_shared_fields_for_bundle(string $bundle, ?string $module_name = NULL): void {
  \Drupal::service('entity_type.bundle.info')->clearCachedBundles();
  $paragraph_type = \Drupal::entityTypeManager()
    ->getStorage('paragraphs_type')
    ->load($bundle);
  if ($paragraph_type === NULL) {
    return;
  }

  paragraphs_bundles_ensure_pb_title_storages();
  paragraphs_bundles_pb_title_import_instances_for_bundle($bundle, $module_name);
  paragraphs_bundles_pb_title_wire_bundle($bundle);

  paragraphs_bundles_ensure_pb_link_storages();
  paragraphs_bundles_pb_ensure_link_field_instances_for_bundle($bundle, $module_name);
  paragraphs_bundles_pb_link_wire_bundle($bundle);
  paragraphs_bundles_pb_sort_display_extra_fields($bundle);
}

/**
 * Applies the full v2 display upgrade on every PB bundle.
 *
 * Form display: shared fields, legacy group rename, Display tab nesting.
 * View display: hide all pb_display_* (values come from dynamic CSS).
 *
 * Idempotent — safe to re-run.
 *
 * @return string
 *   Status message for update hooks.
 */
function paragraphs_bundles_pb_upgrade_all_bundles(): string {
  paragraphs_bundles_ensure_pb_title_storages();
  paragraphs_bundles_ensure_pb_link_storages();
  $bundles = paragraphs_bundles_get_pb_bundles();
  foreach ($bundles as $bundle) {
    paragraphs_bundles_pb_wire_shared_fields_for_bundle($bundle);
  }
  paragraphs_bundles_clear_field_caches();
  $view_message = paragraphs_bundles_pb_hide_display_fields_on_view_displays();
  return (string) t('Applied v2 display layout for @count paragraph bundle(s). @view', [
    '@count' => count($bundles),
    '@view' => $view_message,
  ]);
}

/**
 * Hides all pb_display_* fields on paragraph default view displays.
 *
 * V2 reads styling values from entity fields and dynamic CSS, not view
 * formatters. Safe and idempotent on every bundle.
 *
 * @return string
 *   Status message with the number of updated view displays.
 */
function paragraphs_bundles_pb_hide_display_fields_on_view_displays(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('entity_view_display');
  $updated = 0;

  foreach (paragraphs_bundles_get_pb_bundles() as $bundle) {
    $display = $storage->load('paragraph.' . $bundle . '.default');
    if ($display === NULL) {
      continue;
    }

    $content = paragraphs_bundles_pb_array_prop($display->get('content'));
    $hidden = paragraphs_bundles_pb_array_prop($display->get('hidden'));
    $changed = FALSE;

    foreach (array_keys($content) as $field) {
      if (!is_string($field) || !str_starts_with($field, 'pb_display_')) {
        continue;
      }
      unset($content[$field]);
      $hidden[$field] = TRUE;
      $changed = TRUE;
    }

    if (!$changed) {
      continue;
    }

    ksort($hidden);
    $display->set('content', $content);
    $display->set('hidden', $hidden);
    $display->save();
    $updated++;
  }

  return (string) t('Hidden pb_display_* fields on @count paragraph view display(s).', [
    '@count' => $updated,
  ]);
}

/**
 * Ensures shared link-color field storages exist.
 */
function paragraphs_bundles_ensure_pb_link_storages(): void {
  foreach ([
    'field.storage.paragraph.pb_display_link',
    'field.storage.paragraph.pb_display_link_hover',
  ] as $config_name) {
    paragraphs_bundles_import_optional_config_if_missing('paragraphs_bundles', $config_name);
  }
}

/**
 * Ensures link-color field instances exist on a bundle.
 *
 * Imports optional YAML when present; otherwise creates field instances
 * programmatically (v1 bundles do not ship link-color YAML).
 *
 * @param string $bundle
 *   Paragraph type machine name.
 * @param string|null $module_name
 *   Module providing YAML; auto-discovered when NULL.
 */
function paragraphs_bundles_pb_ensure_link_field_instances_for_bundle(string $bundle, ?string $module_name = NULL): void {
  paragraphs_bundles_ensure_pb_link_storages();

  $labels = [
    'pb_display_link' => 'Link Color',
    'pb_display_link_hover' => 'Link Color Hover',
  ];

  foreach ($labels as $field_name => $label) {
    $field_id = 'paragraph.' . $bundle . '.' . $field_name;
    if (FieldConfig::load($field_id)) {
      continue;
    }

    $config_name = 'field.field.paragraph.' . $bundle . '.' . $field_name;
    $provider = $module_name ?? paragraphs_bundles_get_optional_config_provider($config_name);
    if ($provider !== NULL) {
      paragraphs_bundles_import_optional_config_if_missing($provider, $config_name);
      continue;
    }

    $field_storage = FieldStorageConfig::load('paragraph.' . $field_name);
    if ($field_storage === NULL) {
      continue;
    }

    FieldConfig::create([
      'field_storage' => $field_storage,
      'bundle' => $bundle,
      'label' => $label,
      'required' => FALSE,
      'translatable' => FALSE,
    ])->save();
  }
}

/**
 * Wire link-color widgets onto an existing bundle form/view display.
 *
 * Inserts pb_display_link and pb_display_link_hover into the Display
 * tab immediately after pb_display_border_hover.  Safe to call on a
 * bundle whose form display already contains those fields.
 *
 * @param string $bundle
 *   Paragraph type machine name.
 */
function paragraphs_bundles_pb_link_wire_bundle(string $bundle): void {
  $em = \Drupal::entityTypeManager();
  $form_id = 'paragraph.' . $bundle . '.default';
  $fd = $em->getStorage('entity_form_display')->load($form_id);
  if (!$fd) {
    return;
  }

  $content = paragraphs_bundles_pb_array_prop($fd->get('content'));

  // Determine weight: place after pb_display_border_hover (default 22).
  $border_hover = paragraphs_bundles_pb_array_prop($content['pb_display_border_hover'] ?? NULL);
  $base_weight = is_int($border_hover['weight'] ?? NULL) ? $border_hover['weight'] : 22;

  // Existing widget settings are kept; only the weight is forced, so the two
  // link colours always follow pb_display_border_hover.
  $hidden = paragraphs_bundles_pb_array_prop($fd->get('hidden'));
  foreach (['pb_display_link' => 1, 'pb_display_link_hover' => 2] as $field => $offset) {
    $existing = $content[$field] ?? NULL;
    $content[$field] = is_array($existing)
      ? ['weight' => $base_weight + $offset] + $existing
      : [
        'type' => 'color_text_widget',
        'weight' => $base_weight + $offset,
        'region' => 'content',
        'settings' => [],
        'third_party_settings' => [],
      ];
    // See the matching note in paragraphs_bundles_pb_title_wire_bundle(): a
    // field left in `hidden` while also present in `content` is config core's
    // own API cannot produce, and nothing downstream repairs it.
    unset($hidden[$field]);
  }
  $fd->set('hidden', $hidden);
  $fd->set('content', $content);

  $dependencies = paragraphs_bundles_pb_array_prop($fd->get('dependencies'));
  if (!isset($dependencies['config']) || !is_array($dependencies['config'])) {
    $dependencies['config'] = [];
  }
  foreach ([
    'field.field.paragraph.' . $bundle . '.pb_display_link',
    'field.field.paragraph.' . $bundle . '.pb_display_link_hover',
  ] as $dep) {
    if (!in_array($dep, $dependencies['config'], TRUE)) {
      $dependencies['config'][] = $dep;
    }
  }
  sort($dependencies['config']);
  $fd->set('dependencies', $dependencies);
  $fd->save();

  paragraphs_bundles_pb_nest_display_field_groups($bundle);
  paragraphs_bundles_pb_ensure_link_fields_in_colors_group($bundle);

  // Mark as hidden on the view display (values come from dynamic CSS).
  $vd = $em->getStorage('entity_view_display')->load('paragraph.' . $bundle . '.default');
  if ($vd) {
    $hidden = paragraphs_bundles_pb_array_prop($vd->get('hidden'));
    $hidden['pb_display_link'] = TRUE;
    $hidden['pb_display_link_hover'] = TRUE;
    $vd->set('hidden', $hidden);
    $deps = paragraphs_bundles_pb_array_prop($vd->get('dependencies'));
    if (!isset($deps['config']) || !is_array($deps['config'])) {
      $deps['config'] = [];
    }
    foreach ([
      'field.field.paragraph.' . $bundle . '.pb_display_link',
      'field.field.paragraph.' . $bundle . '.pb_display_link_hover',
    ] as $dep) {
      if (!in_array($dep, $deps['config'], TRUE)) {
        $deps['config'][] = $dep;
      }
    }
    sort($deps['config']);
    $vd->set('dependencies', $deps);
    $vd->save();
  }
}

/**
 * Wire shared v2 fields, nest Display tab, hide view display styling fields.
 */
function paragraphs_bundles_update_9006(): string {
  return paragraphs_bundles_pb_upgrade_all_bundles();
}

/**
 * Repair v1 config values that fail Drupal 11 config-schema validation.
 */
function paragraphs_bundles_update_9007(): string {
  // Two v1 leftovers are invalid under D11 strict config schema. Neither
  // breaks rendering, but both fail `config:inspect` and any Kernel test that
  // validates config, and they are only reachable on upgraded sites — a fresh
  // v2 install writes neither. Found by validating all 1127 active PB config
  // objects against their schema on a real v1 -> v2 upgrade.
  $em = \Drupal::entityTypeManager();
  $fixed_types = 0;
  $fixed_components = 0;

  // 1. node.type help: D11 requires NULL for "no help", not ''. Core stopped
  // repairing this itself when node_post_update_set_node_type_description_and
  // _help_to_null was removed in 11.0, so v1 sites keep the empty string.
  $node_type_storage = $em->getStorage('node_type');
  foreach (['pb_content', 'pb_node_reference'] as $type_id) {
    $node_type = $node_type_storage->load($type_id);
    if ($node_type === NULL) {
      continue;
    }
    if ($node_type->get('help') === '') {
      $node_type->set('help', NULL);
      $node_type->save();
      $fixed_types++;
    }
  }

  // 2. `label` is a view-display key; it is not supported on an entity_form
  // _display component. v1 shipped it on at least the tabs bundle. It is
  // ignored at runtime, so dropping it changes nothing a user can see.
  //
  // Scope: EVERY paragraph form display, not just the bundles returned by
  // paragraphs_bundles_get_pb_bundles() — that helper keys off pb_display_bg,
  // which section bundles like tab_section_bundle do not have, and
  // tab_section_bundle is exactly where the stray key lives. Restricting the
  // unset to pb_*-prefixed components keeps this off any field the site owns.
  $form_storage = $em->getStorage('entity_form_display');
  foreach ($form_storage->loadMultiple() as $fd) {
    if (!str_starts_with((string) $fd->id(), 'paragraph.')) {
      continue;
    }
    $content = paragraphs_bundles_pb_array_prop($fd->get('content'));
    $changed = FALSE;
    foreach ($content as $field => $component) {
      if (!is_string($field) || !str_starts_with($field, 'pb_')) {
        continue;
      }
      if (is_array($component) && array_key_exists('label', $component)) {
        unset($component['label']);
        $content[$field] = $component;
        $changed = TRUE;
        $fixed_components++;
      }
    }
    if ($changed) {
      $fd->set('content', $content);
      $fd->save();
    }
  }

  // 3. Two field_config value-type leftovers, both from v1. Neither is
  // visible at runtime; both fail strict config-schema checks.
  //
  // (a) paragraphs_bundles_range stores an int column, and v2 declares the
  // default as `integer` in config schema. v1 wrote it quoted, so an upgraded
  // site holds the string '100' where an integer is required.
  //
  // (b) target_bundles_drag_drop is a sequence; v1 left it NULL on two tabs
  // fields, where the schema requires at least an empty sequence.
  $fixed_fields = 0;
  foreach ($em->getStorage('field_config')->loadMultiple() as $field) {
    if (!$field instanceof FieldConfig) {
      continue;
    }
    $changed = FALSE;

    if ($field->getType() === 'paragraphs_bundles_range') {
      $default = $field->get('default_value');
      if (is_array($default)) {
        foreach ($default as $delta => $item) {
          if (!is_array($item) || !isset($item['value'])) {
            continue;
          }
          if (!is_int($item['value']) && is_numeric($item['value'])) {
            $item['value'] = (int) $item['value'];
            $default[$delta] = $item;
            $changed = TRUE;
          }
        }
        if ($changed) {
          $field->set('default_value', $default);
        }
      }
    }

    $settings = $field->getSettings();
    if (array_key_exists('handler_settings', $settings)
      && is_array($settings['handler_settings'])
      && array_key_exists('target_bundles_drag_drop', $settings['handler_settings'])
      && $settings['handler_settings']['target_bundles_drag_drop'] === NULL) {
      $settings['handler_settings']['target_bundles_drag_drop'] = [];
      $field->set('settings', $settings);
      $changed = TRUE;
    }

    if ($changed) {
      $field->save();
      $fixed_fields++;
    }
  }

  return (string) t(
    'Config-schema repair: @types node type(s), @components form display component(s), @fields field(s).',
    [
      '@types' => $fixed_types,
      '@components' => $fixed_components,
      '@fields' => $fixed_fields,
    ],
  );
}

/**
 * Realigns display layout and node type help with a fresh v2 install.
 */
function paragraphs_bundles_update_9008(): string {
  // Keep the docblock above to ONE line — `drush updatedb:status` prints the
  // whole thing in a narrow column on the screen a site owner reads before
  // upgrading production.
  //
  // 9006 wires the shared v2 fields onto displays that already exist, so it
  // has to compute weights from what it finds rather than take them from the
  // file a fresh install imports. The two paths then disagree: measured across
  // 39 bundles, six pb_display_* fields land on different weights on ~30 form
  // displays, and on 4 of 5 sampled bundles that is enough to REORDER the edit
  // form — on icon_bundle two content fields end up scattered among the
  // display fields. One module version, two different edit forms depending on
  // install history. See docs/PB-V2-RELEASE-LOG.md.
  //
  // The fix is to treat the shipped config/optional file as the single source
  // of truth for layout and re-apply it. It only ever touches components and
  // field groups this module ships; a field the site added, a component the
  // site has hidden, and a child the site dragged into a shipped group are all
  // left as they are.
  //
  // A site that deliberately reordered the module's own pb_* fields WILL have
  // that reordering reset. That is the point of the update, and it is called
  // out in docs/UPGRADE-V1-TO-V2.md.
  $stats = ['weights' => 0, 'unhidden' => 0, 'groups' => 0];
  $displays = 0;
  $em = \Drupal::entityTypeManager();

  foreach (['entity_form_display', 'entity_view_display'] as $entity_type_id) {
    foreach ($em->getStorage($entity_type_id)->loadMultiple() as $display) {
      if (!$display instanceof EntityDisplayInterface) {
        continue;
      }
      $shipped = paragraphs_bundles_pb_read_optional_config(
        'core.' . $entity_type_id . '.' . $display->id()
      );
      if ($shipped === NULL) {
        continue;
      }
      if (paragraphs_bundles_pb_realign_display($display, $shipped, $stats)) {
        $display->save();
        $displays++;
      }
    }
  }

  // Node type help, same principle, opposite caution. A fresh install ships a
  // sentence of editor guidance on the PB content types; an upgraded site has
  // none, because update_9007 had to set v1's empty string to NULL to satisfy
  // the D11 config schema. Filling it costs the site nothing.
  //
  // Only ever fills an EMPTY value, and deliberately does NOT touch
  // `description`. Both are admin-editable text on a screen the site owner
  // owns (/admin/structure/types/manage/pb_content), so overwriting what they
  // wrote is a different kind of act from correcting a field weight — an
  // upgraded site therefore keeps v1's description even though it is stale.
  $help_filled = 0;
  $node_type_storage = $em->getStorage('node_type');
  foreach (['pb_content', 'pb_node_reference'] as $type_id) {
    $node_type = $node_type_storage->load($type_id);
    if ($node_type === NULL) {
      continue;
    }
    $current = $node_type->get('help');
    if ($current !== NULL && $current !== '') {
      continue;
    }
    $shipped = paragraphs_bundles_pb_read_optional_config('node.type.' . $type_id);
    $help = $shipped['help'] ?? NULL;
    if (!is_string($help) || $help === '') {
      continue;
    }
    $node_type->set('help', $help);
    $node_type->save();
    $help_filled++;
  }

  return (string) t(
    'Realigned @displays display(s) with the shipped layout: @weights weight(s), @unhidden stale hidden entr(y/ies), @groups field group change(s); filled @help empty node type help text(s).',
    [
      '@displays' => $displays,
      '@weights' => $stats['weights'],
      '@unhidden' => $stats['unhidden'],
      '@groups' => $stats['groups'],
      '@help' => $help_filled,
    ],
  );
}

/**
 * Adds the CSS Classes field to the bundle this module owns.
 *
 * The field lets a site put its own class on every instance of a bundle and
 * style them all with one theme rule. New sites get it from config/optional;
 * this is the path for sites that already have the bundle.
 */
function paragraphs_bundles_update_9009(): string {
  \Drupal::moduleHandler()->loadInclude('paragraphs_bundles', 'install');
  $done = [];
  foreach (['simple_bundle'] as $bundle) {
    if (paragraphs_bundles_pb_css_classes_wire_bundle('paragraphs_bundles', $bundle)) {
      $done[] = $bundle;
    }
  }
  return $done === []
    ? (string) t('CSS Classes field was already present; nothing to do.')
    : (string) t('CSS Classes field added to: @list.', ['@list' => implode(', ', $done)]);
}

/**
 * Creates the Paragraphs List index table; a post-update fills it.
 */
function paragraphs_bundles_update_9010(): string {
  $database_schema = \Drupal::database()->schema();
  if ($database_schema->tableExists('paragraphs_bundles_list_index')) {
    return (string) t('The Paragraphs List index table already exists.');
  }
  $definition = paragraphs_bundles_schema();
  $database_schema->createTable('paragraphs_bundles_list_index', $definition['paragraphs_bundles_list_index']);
  return (string) t('Created the Paragraphs List index table; the post-update fills it.');
}

/**
 * Adds the root_title column and its index to the Paragraphs List index.
 */
function paragraphs_bundles_update_9011(): string {
  $database_schema = \Drupal::database()->schema();
  $table = 'paragraphs_bundles_list_index';
  if (!$database_schema->tableExists($table)) {
    // Update 9010 has not made the table yet; it will make it complete.
    return (string) t('The Paragraphs List index table does not exist yet; nothing to add.');
  }
  // One source of truth: the column and index specs come from hook_schema().
  $definition = paragraphs_bundles_schema()[$table];
  $fields = $definition['fields'];
  $indexes = $definition['indexes'];
  if (!is_array($fields) || !is_array($indexes) || !is_array($fields['root_title'] ?? NULL) || !is_array($indexes['root_title_pid'] ?? NULL)) {
    throw new \LogicException('paragraphs_bundles_schema() lacks the root_title definition.');
  }
  $done = [];
  if (!$database_schema->fieldExists($table, 'root_title')) {
    $database_schema->addField($table, 'root_title', $fields['root_title']);
    $done[] = 'column';
  }
  if (!$database_schema->indexExists($table, 'root_title_pid')) {
    $database_schema->addIndex($table, 'root_title_pid', $indexes['root_title_pid'], $definition);
    $done[] = 'index';
  }
  return $done === []
    ? (string) t('The root_title column and index already exist.')
    : (string) t('Added the root_title @what; a post-update fills it.', ['@what' => implode(' and ', $done)]);
}

/**
 * Gives five Simple section style fields the help text v2 ships.
 *
 * Border, border radius, margin, padding and shadow shipped with no
 * description in v1; v2 says what they are for. A description the site wrote
 * itself is kept.
 */
function paragraphs_bundles_update_9012(): string {
  return paragraphs_bundles_pb_adopt_shipped_properties([
    'field.field.paragraph.simple_bundle.pb_display_border' => '',
    'field.field.paragraph.simple_bundle.pb_display_border_radius' => '',
    'field.field.paragraph.simple_bundle.pb_display_margin' => '',
    'field.field.paragraph.simple_bundle.pb_display_padding' => '',
    'field.field.paragraph.simple_bundle.pb_display_shadow' => '',
  ], 'description');
}
