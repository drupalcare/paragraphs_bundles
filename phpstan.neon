# There is deliberately no baseline file. The suppression list started at 145
# entries and burning it down found five shipped defects — three live fatals, a
# silent data-loss bug, and a dead conditional-fields branch — so a suppressed
# finding here has a poor track record of being noise. Fix new findings rather
# than running `--generate-baseline`.
#
# `level: max` is not one level. On PHPStan 1.x it means 9; on 2.x it means 10,
# which adds the `mixed` strictness rules. drupal.org CI runs 2.2.7, and it
# passes `.` on the command line, which overrides the `paths` below — so the
# job analyses strictly more code, more strictly, than any local 1.x run does.
# A clean local run is evidence about this machine, not about the gate: read
# the CI job's own log before claiming the tree is clean.
parameters:
  level: max
  paths:
    - src
    - paragraphs_bundles.module
    - paragraphs_bundles.install
    - paragraphs_bundles.post_update.php
    # Shipped, and missing from this list until 2026-08-03, so ~600 lines of
    # form-display rewriting had never been analysed. The drupal.org job passes
    # "." on the command line, which overrides these paths, so it found the
    # file and this list did not.
    - paragraphs_bundles.display.inc
    # Bundle sub-modules ship ~100 PHP files (hook classes, services, their own
    # .module/.install). They were outside `paths` and so had never been
    # analysed at all; the parent module alone is not the shipped surface.
    - modules
  excludePaths:
    # Drush is a host-site dependency, not a package dependency, so the
    # DrushCommands base class is unresolvable at analysis time (matches
    # vvj_core). The command is a thin wrapper; its logic lives in the
    # analyzed, unit-tested services.
    - src/Drush
    # Tests run bootstrap-free with class stubs in tests/stubs that redefine
    # Drupal framework classes and conflict with phpstan-drupal's real ones.
    # Tests are validated by PHPUnit; PHPStan scopes to shipped code. These
    # two entries carry that intent onto the drupal.org job, which analyses
    # "." and so reached the tests regardless of `paths` above.
    # `tests` is a plain directory path and matches. `modules/*/tests` did NOT:
    # PHPStan fnmatches excludePaths entries against each analysed FILE path, so
    # a pattern containing a wildcard has to match the file, not the directory.
    # `modules/*/tests` matched nothing, which is why the drupal.org job kept
    # reporting findings inside
    # modules/paragraph_bundle_content/tests/src/Unit/. The trailing `/*` fixes
    # it. Verified on CI, not locally: the local runner is PHPStan 1.x and the
    # job is 2.x.
    - tests
    - modules/*/tests/*
    # (Two entries that were here, modules/paragraphs_bundles_ai/src/Plugin/
    # AiFunctionCall and modules/paragraphs_bundles_ai/src/Tool, named
    # directories that no longer exist - the AI module was stripped back to a
    # page form and services, and its FunctionCallBase tool plugins went with
    # it. PHPStan 2.x fails a run whose excludePaths entry matches nothing, so
    # a dead entry is a red job, not clutter. The remaining ai-package gaps are
    # handled by the targeted ignoreErrors entries below.)
  treatPhpDocTypesAsCertain: false
  ignoreErrors:
    # The batched post_update cannot carry a `@param array<string, mixed>`
    # docblock: `drush updatedb:status` renders the WHOLE docblock, tags
    # included, in a ~40-char column, turning the screen a site owner reads
    # before upgrading production into a wall of text. Core's batched
    # post_updates use a bare one-line docblock for the same reason. The
    # function reads the sandbox into typed locals on entry, so the missing
    # docblock type costs no actual type safety.
    - message: '#^Function paragraphs_bundles_post_update_regenerate_dynamic_css\(\) has parameter \$sandbox with no value type specified in iterable type array\.$#'
      path: paragraphs_bundles.post_update.php
      count: 1
    - message: '#^Function paragraphs_bundles_post_update_build_list_index\(\) has parameter \$sandbox with no value type specified in iterable type array\.$#'
      path: paragraphs_bundles.post_update.php
      count: 1
    - message: '#^Function paragraphs_bundles_post_update_refill_list_index_root_title\(\) has parameter \$sandbox with no value type specified in iterable type array\.$#'
      path: paragraphs_bundles.post_update.php
      count: 1
    # `parameterByRef.type` cannot be resolved from this side. It fires where a
    # by-reference `array<string, mixed>` of ours meets a core signature that
    # types the same parameter as a bare `array` — `NestedArray::getValue()` /
    # `setValue()`, and the `#element_validate` callback contract, which Drupal
    # invokes with a plain `array &$element`. Widening our own docblocks to
    # `array` to silence it would delete real type information from the code
    # that actually reads these arrays, which is the wrong trade. Narrow in
    # scope: only this identifier, only where core is the other side.
    #
    # The third path is spelled out rather than globbed. `modules/*/src/Hook`
    # was kept literal by PHPStan — it matched nothing, and the run then failed
    # twice over: once on the unsuppressed error, once on "Ignored error
    # pattern … was not matched". A plain directory (the FieldWidget entry
    # below) resolves; a directory with a wildcard segment does not.
    - identifier: parameterByRef.type
      paths:
        - src/Utility/PbRenderArray.php
        - src/Plugin/Field/FieldWidget
        - modules/paragraph_bundle_image_grid/src/Hook/PbigPreprocessSectionHook.php
        # A fourth path here named
        # modules/paragraphs_bundles_ai/src/Form/PbAiSettingsForm.php. That file
        # was deleted when the AI module was stripped back to the bar, so the
        # entry could never match anything — on this machine or on CI — and
        # PHPStan reported it as an unmatched pattern. Removed 2026-09-23.
        #
        # The other three stay even though this run also reports the group as
        # unmatched: that is PHPStan 1.x at level 9 on this machine, and the
        # drupal.org job is 2.x at level 10 analysing `.`. A local "not matched"
        # is evidence about the local runner, not about the gate — see the note
        # at the top of this file.
    # `Drupal\apex\…` is a genuinely optional integration: the APEX theme is a
    # `suggest`, never a `require`, and paragraph_bundle_content degrades to the
    # neutral layout when it is absent (see PbcRegionMap::layoutLibraryName()).
    # The class is therefore unresolvable on any site that does not run APEX,
    # including CI. The constructor argument is nullable and every call site
    # null-checks it.
    - identifier: class.notFound
      path: modules/paragraph_bundle_content/src/Service/Theme/PbcThemeFamilyResolver.php
    # `format` is a magic property on a formatted field item — TextItem and
    # friends expose it through the item's property definitions, not as a
    # declared PHP property, so the analyser sees only TypedDataInterface. The
    # line is guarded: carriesFormat() has already asked the field definition
    # whether a `format` property exists before this runs, so the access cannot
    # be made against an item that has none.
    #
    # NOT rewritten as ->get('format')->getValue(), which would be tidier and
    # is behaviour-equivalent given that guard. The magic property is the whole
    # reason for this entry and it stands on its own.
    #
    # ⚠ AN EARLIER VERSION OF THIS COMMENT GAVE A SECOND REASON THAT WAS FALSE:
    # that the Kernel tests covering this service "cannot be run on this
    # machine". They can. phpunit.xml.dist sweeps Unit directories only — that
    # part is true — but the Kernel suite runs perfectly well against SQLite
    # with core's own bootstrap, needing no database credential:
    #   cd web/core && SIMPLETEST_DB="sqlite://localhost/<path>.sqlite" \
    #     vendor/bin/phpunit --bootstrap tests/bootstrap.php <test-dir>
    # Measured 2026-09-24: 66 tests, 1001 assertions, 0 failures. "The project's
    # suite does not sweep them" and "they cannot be run" are different claims,
    # and the false one was used here to justify suppressing instead of fixing.
    #
    # ⚠ MATCHED BY IDENTIFIER, NOT BY MESSAGE, AND THAT IS THE SECOND ATTEMPT.
    # The first version of this entry pinned the message text, which named
    # TypedDataInterface::$format. Adding the generic to the $items docblock in
    # the same change made first() return FieldItemInterface instead, the
    # message changed with it, and the pattern stopped matching — so the run
    # reported BOTH the unsuppressed error and "ignored pattern was not
    # matched". A message regex encodes the analyser's inferred type, which is
    # exactly the thing a type fix moves.
    - identifier: property.notFound
      path: modules/paragraphs_bundles_ai/src/Service/TextFormats.php
      count: 1
    # `$entity` is the computed property EntityReferenceItem exposes for the
    # referenced entity. It is real at runtime and absent from
    # FieldItemInterface, so the analyser cannot see it — the same limitation as
    # `format` above, not a defect in either file. Both call sites already check
    # what comes back with `instanceof ParagraphInterface` before using it, so
    # a field that does not carry an entity is refused rather than fataled on.
    - identifier: property.notFound
      paths:
        - modules/paragraphs_bundles_ai/src/Service/SectionCatalog.php
        - modules/paragraphs_bundles_ai/src/Service/SectionEditor.php
    # SAME CAUSE AS THE excludePaths ENTRIES FOR AiFunctionCall AND Tool ABOVE:
    # drupal/ai is a dependency of the paragraphs_bundles_ai SUBMODULE and is
    # deliberately not required by this project, so it is absent whenever
    # paragraphs_bundles is built from its own composer.json — which is what
    # drupal.org CI does. The provider manager is a generic plugin manager
    # typed `object`, and the chat response class cannot be named here without
    # naming a package that is not installed.
    #
    # Both lines are already inside a try/catch that relays the provider's own
    # message, and the getText() call is guarded by method_exists(), so a
    # provider that cannot answer produces a sentence rather than a fatal.
    #
    # The absent package is the whole reason for this entry: no amount of
    # narrowing makes a class that is not installed resolvable.
    #
    # ⚠ AN EARLIER VERSION OF THIS COMMENT ALSO CLAIMED THE KERNEL TESTS
    # "CANNOT BE RUN ON THIS MACHINE". That was false — see the note on the
    # TextFormats entry above for the SQLite invocation that runs them, and the
    # measurement that proves it. The claim was written after the opposite had
    # already been demonstrated in the same session.
    - message: '#^Call to an undefined method object\:\:chat\(\)\.$#'
      path: modules/paragraphs_bundles_ai/src/Service/SectionDrafter.php
      count: 1
    - message: '#^Cannot call method getText\(\) on class-string\|object\.$#'
      path: modules/paragraphs_bundles_ai/src/Service/SectionDrafter.php
      count: 1
    # `filter_default_format()` is deprecated in 11.4 and removed in 13.0, and
    # it is called ON PURPOSE. This module declares ^11.3, where the supported
    # replacement — FilterFormatRepositoryInterface — does not exist yet. The
    # call sits behind a function_exists() guard and a null-object check, and
    # the constructor takes the repository as a nullable argument so 11.4+ never
    # reaches it. Deleting the call would break the older major the info.yml
    # still promises; the code comment says to remove it the day that floor
    # rises to ^11.4, and this entry goes with it.
    - message: '#^Call to deprecated function filter_default_format\(\)#'
      path: modules/paragraphs_bundles_ai/src/Service/TextFormats.php
      count: 1
