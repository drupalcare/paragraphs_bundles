{
    "name": "drupal/paragraphs_bundles",
    "description": "A suite of Paragraph bundles for Drupal. v2 \u2014 modernized for Drupal 11.3+ / 12; per-paragraph dynamic CSS files; deliberately un-layered CSS; BEM class names.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Alaa Haddad (alaahaddad.com)",
            "homepage": "https://www.drupal.org/u/flashwebcenter",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://drupal.org/project/paragraphs_bundles",
    "require": {
        "php": ">=8.3",
        "drupal/core": "^11.3 || ^12",
        "drupal/paragraphs": "^1.18",
        "drupal/entity_reference_revisions": "^1.10",
        "drupal/field_group": "^3.4 || ^4"
    },
    "require-dev": {
        "drupal/viewsreference": "^2.0@beta",
        "drupal/webform": "^6.2",
        "drupal/contact_formatter": "^2.0",
        "drupal/link_attributes": "^2.1"
    },
    "suggest": {
        "drupal/viewsreference": "^2.0@beta \u2014 required by the paragraph_bundle_views sub-module.",
        "drupal/webform": "^6.2 \u2014 required by the paragraph_bundle_webform sub-module.",
        "drupal/contact_formatter": "^2.0 \u2014 required by the paragraph_bundle_contact_form sub-module.",
        "drupal/link_attributes": "^2.1 \u2014 required by the paragraph_bundle_link sub-module.",
        "drupal/apex": "Optional. paragraph_bundle_content uses APEX's theme-detection service when present, and falls back to a theme-name scan when it is not."
    },
    "support": {
        "issues": "https://drupal.org/project/issues/paragraphs_bundles",
        "source": "https://git.drupalcode.org/project/paragraphs_bundles"
    }
}
