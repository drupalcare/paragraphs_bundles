{#
/**
 * @file
 * `image_grid_section_bundle` paragraph template (v2).
 *
 * Split dynamic CSS (see PbDynamicCssBuilder::SPLIT_COLOR_SCOPES):
 * - border on `#pb-image-grid-section-{id} > .pb-ui-inner`
 * - bg/text on `#pb-image-grid-section-{id} .pb-image-grid__title`
 *
 * `pb_full_size_url` is set by PbigPreprocessSectionHook for lightbox JS.
 *
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 * @see \Drupal\paragraphs_bundles\Service\Css\PbDynamicCssBuilder
 * @see \Drupal\paragraph_bundle_image_grid\Hook\PbigPreprocessSectionHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_image_grid/paragraph-bundle-image-grid') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id ?: 'pb-image-grid-section-' ~ paragraph.id.value %}
{% set item_id = 'pb-image-grid-item-' ~ paragraph.id.value %}
{% set classes_inner = 'pb-ui-inner pb-image-grid-section__inner' %}
{% set pb_full_size_url = pb_full_size_url|default('') %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-image-grid-section',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set pb_displays = [
  'pb_display_width',
  'pb_display_border',
  'pb_display_border_radius',
  'pb_display_margin',
  'pb_display_padding',
  'pb_display_shadow',
] %}
{% for pb_display in pb_displays %}
  {% set display_value = paragraph|pb_field_value(pb_display) %}
  {% set classes_inner = display_value ? classes_inner ~ ' ' ~ (display_value|pb_class) : classes_inner %}
{% endfor %}

{% set pb_link = content.pb_content_image_link.0['#url'] %}
{% set pb_link_title = content.pb_content_image_link_title|render|striptags|trim %}
{% set pb_image = content.pb_content_image %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id).setAttribute('data-full-image-url', pb_full_size_url) }}>
  <div class="{{ classes_inner }}">

    {% if pb_link and pb_image %}
      <div id="{{ item_id }}" class="pb-image__wrapper pb-image-grid">
        <button type="button" class="pb-grid__expand" aria-expanded="false" aria-label="{{ 'Expand image grid'|t }}"><span class="visually-hidden">{{ 'Expand image grid'|t }}</span>
          <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path d="M120-120v-320h80v184l504-504H520v-80h320v320h-80v-184L256-200h184v80H120Z"/></svg>
        </button>
        <a href="{{ pb_link }}" class="pb-ui-link"{% if pb_link_title %} title="{{ pb_link_title }}"{% endif %}>
          {{ pb_image }}
          {% if pb_title %}
            <div class="pb-image-grid__title">
              {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
            </div>
          {% endif %}
        </a>
      </div>
    {% else %}
      <div id="{{ item_id }}" class="pb-image__wrapper pb-image-grid not-clickable">
        <button type="button" class="pb-grid__expand" aria-expanded="false" aria-label="{{ 'Expand image grid'|t }}"><span class="visually-hidden">{{ 'Expand image grid'|t }}</span>
          <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path d="M120-120v-320h80v184l504-504H520v-80h320v320h-80v-184L256-200h184v80H120Z"/></svg>
        </button>
        {{ pb_image }}
        {% if pb_title %}
          <div class="pb-image-grid__title">
            {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
          </div>
        {% endif %}
      </div>
    {% endif %}

  </div>
</div>
