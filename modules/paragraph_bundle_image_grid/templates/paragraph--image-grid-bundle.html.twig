{#
/**
 * @file
 * `image_grid_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars                    | DOM target              | v2 mechanism |
 * |---------------------------------|-------------------------|--------------|
 * | pb_display_* (list)             | `.pb-ui-inner`     | entity field values |
 * | pb_display_bg/text/border/link* | `.pb-ui-inner`     | dynamic CSS |
 * | pb_display_grid_width           | `.pb-image-grid__wrapper` | inline grid-template-columns |
 * | pb_display_image_grid_gap       | `.pb-image-grid__wrapper` | inline gap (px) |
 *
 * Dynamic CSS selector: `#pb-image-grid-{id} > .pb-ui-inner`
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_image_grid/paragraph-bundle-image-grid') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id ?: 'pb-image-grid-' ~ paragraph.id.value %}
{% set lightbox_id = paragraph_id ~ '-lightbox' %}
{% set lightbox_heading_id = paragraph_id ~ '-lightbox-heading' %}
{% set classes_inner = 'pb-ui-inner pb-image-grid__inner' %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-image-grid',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set pb_displays = [
  'pb_display_width',
  'pb_display_border',
  'pb_display_border_radius',
  'pb_display_margin',
  'pb_display_padding',
  'pb_display_shadow',
] %}
{% for pb_display in pb_displays %}
  {% set display_value = paragraph|pb_field_value(pb_display) %}
  {% set classes_inner = display_value ? classes_inner ~ ' ' ~ (display_value|pb_class) : classes_inner %}
{% endfor %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">

    <div class="pb-content__full">
      {% if pb_title %}
        {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
      {% endif %}

      <div class="pb-image-grid__wrapper" aria-label="{{ 'Image Grid'|t }}">
        <div id="{{ lightbox_id }}" class="pb-grid__lightbox" aria-hidden="true" inert style="display: none;" role="dialog" aria-labelledby="{{ lightbox_heading_id }}" tabindex="-1">
          <h2 id="{{ lightbox_heading_id }}" class="visually-hidden">{{ 'Image Grid Lightbox'|t }}</h2>
          <button type="button" class="pb-grid__close" aria-label="{{ 'Close Grid'|t }}"><span class="visually-hidden">{{ 'Close Grid'|t }}</span>
            <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
          </button>
          <div class="pb-grid__lightbox-content">
            {# Content injected by JS. #}
          </div>
          <button type="button" class="pb-modal__prev" aria-label="{{ 'Previous'|t }}"><span class="visually-hidden">{{ 'Previous'|t }}</span>
            <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path d="M640-80 240-480l400-400 71 71-329 329 329 329-71 71Z"/></svg>
          </button>
          <button type="button" class="pb-modal__next" aria-label="{{ 'Next'|t }}"><span class="visually-hidden">{{ 'Next'|t }}</span>
            <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24"><path d="m321-80-71-71 329-329-329-329 71-71 400 400L321-80Z"/></svg>
          </button>
        </div>

        {{ content.pb_content_image_grid_image }}
      </div>

    </div>
  </div>
</div>
