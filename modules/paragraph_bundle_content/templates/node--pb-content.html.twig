{#
/**
 * @file
 * Theme override to display a 'pb_content' node.
 *
 * Page background colour is emitted in the per-node dynamic CSS file
 * (`pb_dynamic_library`) on `#node-{id}` — same target as v1 inline style.
 *
 * @see template_preprocess_node()
 * @see \Drupal\paragraph_bundle_content\Hook\PbcPreprocessHook
 */
#}

{% if pb_dynamic_library %}
  {{ attach_library(pb_dynamic_library) }}
{% endif %}

{% set classes = [
    'node',
    'pb-content',
    'pb-ui-row',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}

<article{{ attributes.addClass(classes) }}>

  {% if (label and not page) or display_submitted %}

  <header class="pb-ui-row node__header">
    {{ title_prefix }}
    {% if label and not page %}
      <h3 {{ title_attributes.addClass('node__title') }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h3>
    {% endif %}
    {{ title_suffix }}

    {% if display_submitted %}
      <div class="node__meta">
      {% if author_picture %}
        <div class="node__author-image">
          {{ author_picture }}
        </div>
      {% endif %}
        <div class="node__author-info" {{ author_attributes }}>
          <span {{ author_attributes }}>
            {{ 'By'|t }} {% apply spaceless %}{{ author_name }}{% endapply %} | {{ date }}
          </span>
        </div>
        {{ metadata }}
      </div>
    {% endif %}

  </header>

  {% endif %}

  <div{{ content_attributes.addClass('pb-ui-row node__content') }}>
    {{ content|without('pb_display_content_bg', 'pb_display_content_bg_opacity', 'pb_display_disable_region', 'pb_display_content_width') }}
  </div>

</article>
