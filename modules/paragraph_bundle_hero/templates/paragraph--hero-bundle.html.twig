{#
/**
 * @file
 * `hero_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field                  | DOM target                    | CSS |
 * |------------------------|-------------------------------|-----|
 * | pb_display_margin      | `.hero-bundle-inner`          | paragraphs-bundles-base.css `.pb__margin*` |
 * | pb_display_width       | `.pb-hero__text-inner` | paragraphs-bundles-custom.css `--pb-width` |
 * | pb_display_border      | `.pb-hero__text-inner` | base `.pb__border*` |
 * | pb_display_border_radius | `.pb-hero__text-inner` | base `.pb__round*` |
 * | pb_display_padding     | `.pb-hero__text-inner` | base `.pb__padding*` |
 * | pb_display_shadow      | `.pb-hero__text-inner` | base `.pb-card*` |
 * | pb_display_hero        | `.pb-hero__text-inner` | base `.pb__ds_*` |
 * | pb_display_bg*         | `.pb-hero__text-inner` | dynamic CSS `--pb-bg*` |
 * | pb_display_text*       | `.pb-hero__text-inner` | dynamic CSS `--pb-tx*` |
 * | pb_display_border_color* | `.pb-hero__text-inner` | dynamic CSS `--pb-br*` |
 * | pb_display_link*       | `.pb-hero__text-inner` | dynamic CSS `--pb-lk*` |
 *
 * Dynamic CSS selector: `#pb__hero-{id} .pb-hero__text-inner`
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 * @see \Drupal\paragraphs_bundles\Service\Css\PbDynamicCssBuilder
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_hero/paragraph-bundle-hero') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = 'pb-ui-row pb-hero__text-inner' %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-hero',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set pb_displays = [
  'pb_display_width',
  'pb_display_border',
  'pb_display_border_radius',
  'pb_display_padding',
  'pb_display_shadow',
  'pb_display_hero',
] %}
{% for pb_display in pb_displays %}
  {% set display_value = paragraph|pb_field_value(pb_display) %}
  {% set classes_inner = display_value ? classes_inner ~ ' ' ~ (display_value|pb_class) : classes_inner %}
{% endfor %}

{% set pb_link = content.pb_content_image_link.0['#url'] %}
{% set pb_link_title = content.pb_content_image_link_title|render|striptags|trim %}
{% set pb_margin = paragraph|pb_field_value('pb_display_margin')|pb_class %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="pb-ui-row hero-bundle-inner{{ pb_margin ? ' ' ~ pb_margin : '' }}">

    <div class="pb-ui-row pb-u-image-full">
      {{ content.pb_content_image }}
    </div>

    <div class="pb-ui-row pb-hero__text-wrapper pb-content__full">
      <div class="{{ classes_inner }}">

        {% if pb_link %}
        <a href="{{ pb_link }}" class="pb-ui-row pb-ui-link"{% if pb_link_title %} title="{{ pb_link_title }}"{% endif %}>
        {% endif %}

        {% if pb_title %}
        {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
        {% endif %}

        {{ content.pb_content_body }}

        {% if pb_link %}
        </a>
        {% endif %}

      </div>
    </div>

    {{ content|without(
      'pb_content_title',
      'pb_content_title_tag',
      'pb_content_title_alignment',
      'pb_display_hero',
      'pb_content_body',
      'pb_content_image',
      'pb_content_image_link',
      'pb_content_image_link_title',
      'pb_display_bg',
      'pb_display_bg_opacity',
      'pb_display_bg_hover',
      'pb_display_border_color',
      'pb_display_border_hover',
      'pb_display_text',
      'pb_display_text_hover',
      'pb_display_link',
      'pb_display_link_hover',
      'pb_display_border',
      'pb_display_border_radius',
      'pb_display_margin',
      'pb_display_padding',
      'pb_display_width',
      'pb_display_shadow',
    ) }}

  </div>
</div>
