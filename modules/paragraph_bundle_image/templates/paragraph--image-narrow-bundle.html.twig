{#
/**
 * @file
 * `image_narrow_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars              | DOM target                  | v2 mechanism |
 * |---------------------------|-----------------------------|--------------|
 * | pb_display_* (list)     | `.pb-image-narrow__inner`   | entity field values |
 * | pb_display_bg* / text*    | `.pb-image-narrow__inner`   | dynamic CSS `--pb-*` |
 * | pb_display_border_color*  | `.pb-image-narrow__inner`   | dynamic CSS `--pb-br*` |
 * | pb_display_link*          | `.pb-image-narrow__inner`   | dynamic CSS `--pb-lk*` |
 * | title + radius + padding  | `.pb-image__wrapper`        | `pb-u-dis-*` utilities |
 *
 * Dynamic CSS selector: `#pb__image-n-{id} > .pb-ui-inner`
 * Scoping contract: L0 `pb-image-narrow` on paragraph root.
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = ['pb-ui-inner', 'pb-image-narrow__inner', 'pb-content__full']|merge(pb_display_classes)|join(' ') %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-image-narrow',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set pb_link = content.pb_content_image_link.0['#url'] %}
{% set pb_link_title = content.pb_content_image_link_title|render|striptags|trim %}
{% set pb_padding = paragraph|pb_field_value('pb_display_padding')|pb_class %}
{% set pb_radius = paragraph|pb_field_value('pb_display_border_radius')|pb_class %}
{% set pb_image = content.pb_content_image %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}

{% set pb_img_classes = [
  'pb-image__wrapper',
  pb_radius == '' ? '' : ' ' ~ pb_radius,
  pb_title ? 'pb-u-dis-top-left-right' : '',
  pb_padding ? 'pb-u-dis-radius' : '',
] %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">

    {% if pb_title %}
      {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
    {% endif %}

    {% if pb_link and pb_image %}
      <a href="{{ pb_link }}" class="pb-ui-link"{% if pb_link_title %} title="{{ pb_link_title }}"{% endif %}>
        <div class="{{ pb_img_classes|join(' ')|trim }}">{{ pb_image }}</div>
      </a>
    {% else %}
      <div class="{{ pb_img_classes|join(' ')|trim }}">{{ pb_image }}</div>
    {% endif %}

    {{ content|without(
      'pb_content_title',
      'pb_content_title_tag',
      'pb_content_title_alignment',
      'pb_content_image',
      'pb_content_image_link',
      'pb_content_image_link_title',
      'pb_display_bg',
      'pb_display_bg_opacity',
      'pb_display_bg_hover',
      'pb_display_border_color',
      'pb_display_border_hover',
      'pb_display_text',
      'pb_display_text_hover',
      'pb_display_link',
      'pb_display_link_hover',
      'pb_display_border',
      'pb_display_border_radius',
      'pb_display_margin',
      'pb_display_padding',
      'pb_display_width',
      'pb_display_shadow',
    ) }}

  </div>
</div>
