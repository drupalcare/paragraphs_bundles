{#
/**
 * @file
 * `slideshow_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars                    | DOM target              | v2 mechanism |
 * |---------------------------------|-------------------------|--------------|
 * | pb_display_* (list)             | `.pb-ui-inner`     | entity field values |
 * | pb_display_bg/text/border/link* | `.pb-ui-inner`     | dynamic CSS |
 * | pb_display_slide_active_item    | `--pb-bt-a` on inner    | dynamic CSS |
 * | pb_display_bottom_navigation    | `.pb-slideshow__stage`  | class on stage |
 * | pb_display_slide_animated_slides| `.pb-slideshow__slide-inner` | class on pane |
 * | pb_display_slide_play_stop      | `data-slide-time`       | entity integer value |
 * | pb_display_slide_prev_next      | `.pb-slideshow__arrows`     | conditional render |
 *
 * Dynamic CSS selector: `#pb-slideshow-{id} > .pb-ui-inner`
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_slideshow/paragraph-bundle-slideshow') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{# Not `pb-slideshow-{id}`. That is now the outer id from preprocess. This
   names the stage the way its siblings below are named. #}
{% set slide_id = 'pb-slideshow__stage-' ~ paragraph.id.value %}
{% set classes_inner = ['pb-ui-inner', 'pb-slideshow__wrap-inner']|merge(pb_display_classes)|join(' ') %}

{% set pb_prev_next = not paragraph.pb_display_slide_prev_next.isEmpty and paragraph|pb_field_value('pb_display_slide_prev_next') %}
{% set pb_bottom_nav = paragraph|pb_field_value('pb_display_bottom_navigation') %}
{% set pb_animated_tab = paragraph|pb_field_value('pb_display_slide_animated_slides')|pb_class %}
{% set pb_slide_time = paragraph|pb_field_value('pb_display_slide_play_stop', 0) %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}
{% set has_bottom_nav = pb_bottom_nav != '' %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-slideshow',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  has_bottom_nav ? 'pb-has-bottom-nav',
  paragraph_id,
] %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">
    {# Deliberately NOT `pb-width-own`. The slideshow inherited an exclusion
       from the old structural list (`.pb-slideshow__wrap-inner > .pb-content__full`),
       which meant the node width never clamped it and it rendered full-bleed on
       every pb_content node. Its own wrapper carries the bundle max-width, so
       nothing else was holding it either. It respects the node width like any
       other bundle. #}
    <div class="pb-content__full">

      {% if pb_title %}
        {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
      {% endif %}

      {% set total_slides = 0 %}

      {# WCAG 2.2.2: whenever autoplay can run there must be a pause control,
         regardless of which bottom-navigation style is selected. #}
      {% set show_play_button = pb_slide_time > 0 %}

      {# This slideshow uses the ARIA APG **basic carousel** pattern, not the
         tabbed-picker variant: every slide is a `role="group"` with
         `aria-roledescription="slide"`, the nav is a `role="group"`, and the
         numbered buttons are plain buttons carrying `aria-controls` and
         `aria-current`.

         The tabbed variant was tried and dropped. It requires a `tablist`
         whose children are all `tab`s, and this nav also holds the play/pause
         button that WCAG 2.2.2 requires whenever autoplay can run, so with
         both dots and autoplay the play button was a non-tab child of a
         tablist. Getting it out meant either wrapping the dots in an inner
         tablist (which breaks the fourteen
         `.pb-slideshow__nav > .pb-slideshow__nav-btn` child combinators the
         CSS relies on) or moving the button out of the nav row. The basic
         pattern needs neither, and it removes the split where slides had two
         different roles depending on the bottom-nav value.

         Kept as a flag because the nav is only rendered at all for these
         values. #}
      {% set show_navigation_buttons = pb_bottom_nav in ['dot', 'nav', 'dot_play', 'nav_play'] %}

      {# L3 behavior host: JS once() target #}
      <div id="{{ slide_id }}" class="pb-slideshow__stage{{ pb_bottom_nav ? ' pb-slideshow__nav--' ~ pb_bottom_nav|replace({_: '-'}) }}{{ pb_slide_time == 0 ? ' pb-u-zero' : ' pb-u-not-zero' }}" data-slide-time="{{ pb_slide_time }}">
        <div id="pb-slideshow__slides-{{ paragraph.id.value }}" class="pb-slideshow__slides">
          {% for key, item in content.pb_content_slideshow_section %}
            {% if key|first != '#' %}
              {% set total_slides = total_slides + 1 %}

              <div id="pb-slideshow__slide-{{ paragraph.id.value }}-{{ key + 1 }}" role="group" aria-roledescription="{{ 'slide'|t }}" aria-label="{{ 'Slide '|t ~ (key + 1) }}" data-index="{{ key }}" aria-hidden="{% if key == 0 %}false{% else %}true{% endif %}" class="pb-ui-row pb-slideshow__slide{% if key == 0 %} pb-is-active{% endif %}">
                <div class="pb-ui-row pb-slideshow__slide-inner{{ pb_animated_tab == '' ? '' : ' ' ~ pb_animated_tab }}" id="{{ slide_id }}-{{ key + 1 }}-pane">
                  {{ item|pb_section_bodies('pb_content_slideshow_body') }}
                  {% if item['#paragraph'].pb_content_slideshow_title.value %}
                    <div class="pb-ui-row pb-slideshow__title">{{ item['#paragraph'].pb_content_slideshow_title.value|decode_entities }}</div>
                  {% endif %}
                </div>
              </div>

            {% endif %}
          {% endfor %}
        </div>
        <div class="pb-nav__announcer visually-hidden" aria-live="polite"></div>

        {# show_play_button and show_navigation_buttons are set above the slide
           loop, because the slides' roles depend on the same flag. #}
        {% if show_play_button or show_navigation_buttons %}
          <div id="pb-slideshow__nav-{{ paragraph.id.value }}" role="group" aria-label="{{ 'Slideshow Controls'|t }}" class="pb-slideshow__nav pb-slideshow__number{{ pb_bottom_nav ? ' pb-slideshow__nav--' ~ pb_bottom_nav|replace({_: '-'}) }}">

            {% if show_play_button %}
              <button id="pb-slideshow__play-pause-{{ paragraph.id.value }}" type="button"
                      aria-label="{{ 'Pause slideshow'|t }}"
                      class="pb-ui-btn pb-nav__play pb-is-playing control-btn"
                      aria-live="polite">
                <span class="visually-hidden">{{ 'Play and Stop Slideshow'|t }}</span>
                <span class="pb-nav__play-icon" hidden>{{ include('@paragraph_bundle_slideshow/svg/svg-play.svg') }}</span>
                <span class="pb-nav__pause-icon">{{ include('@paragraph_bundle_slideshow/svg/svg-pause.svg') }}</span>
              </button>
            {% endif %}

            {% if show_navigation_buttons %}
              {% for key, item in content.pb_content_slideshow_section %}
                {% if key|first != '#' %}
                  <button id="pb-slideshow__nav-btn-{{ paragraph.id.value }}-{{ key + 1 }}" type="button"
                          aria-label="{{ 'Slide '|t ~ (key + 1) }}"
                          aria-current="{{ key == 0 ? 'true' : 'false' }}"
                          aria-controls="pb-slideshow__slide-{{ paragraph.id.value }}-{{ key + 1 }}"
                          class="pb-ui-btn pb-slideshow__nav-btn control-btn{{ key == 0 ? ' pb-is-active' : '' }}">
                    <span>{{ key + 1 }}</span>
                  </button>
                {% endif %}
              {% endfor %}
            {% endif %}
          </div>
        {% endif %}

        {% if pb_prev_next %}
          <div id="pb-slideshow__arrows-{{ paragraph.id.value }}" class="pb-ui-bar pb-slideshow__arrows pb-nav__prev-next-arrow-{{ pb_prev_next }}" role="navigation" aria-label="{{ 'Slideshow Navigation'|t }}">
            <button class="pb-nav__prev pb-ui-btn control-btn" role="button" aria-controls="pb-slideshow__slides-{{ paragraph.id.value }}" aria-label="{{ 'Previous Slide'|t }}">
              <span class="visually-hidden">{{ 'Previous Slide'|t }}</span>
              <span>{{ include('@paragraph_bundle_slideshow/svg/svg-prev.svg') }}</span>
            </button>
            <button class="pb-nav__next pb-ui-btn control-btn" role="button" aria-controls="pb-slideshow__slides-{{ paragraph.id.value }}" aria-label="{{ 'Next Slide'|t }}">
              <span class="visually-hidden">{{ 'Next Slide'|t }}</span>
              <span>{{ include('@paragraph_bundle_slideshow/svg/svg-next.svg') }}</span>
            </button>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
