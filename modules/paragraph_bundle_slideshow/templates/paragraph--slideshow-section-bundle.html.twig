{#
/**
 * @file
 * `slideshow_section_bundle` paragraph template (v2).
 *
 * Nested slide item — body paragraphs and optional slide title are rendered
 * by the parent `slideshow_bundle` template. This template passes through
 * default field output when the section is viewed in isolation.
 *
 * @see paragraph--slideshow-bundle.html.twig
 *
 * @ingroup themeable
 */
#}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
] %}

<div{{ attributes.addClass(classes) }}>
  {{ content }}
</div>
