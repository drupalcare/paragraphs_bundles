{#
/**
 * @file
 * `card_image_section_bundle` paragraph template (v2).
 *
 * Split dynamic CSS (see PbDynamicCssBuilder::SPLIT_COLOR_SCOPES):
 * - border/link on `#pb__image-{id} > .pb-ui-inner`
 * - bg/text on `#pb__image-{id} .pb-card__image-title`
 *
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 * @see \Drupal\paragraphs_bundles\Service\Css\PbDynamicCssBuilder
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_card/paragraph-bundle-image-section') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = 'pb-ui-inner pb-card-image-section__inner' %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-card',
  'pb-card-image-section',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set pb_displays = [
  'pb_display_width',
  'pb_display_border',
  'pb_display_border_radius',
  'pb_display_margin',
  'pb_display_padding',
  'pb_display_shadow',
] %}
{% for pb_display in pb_displays %}
  {% set display_value = paragraph|pb_field_value(pb_display) %}
  {% set classes_inner = display_value ? classes_inner ~ ' ' ~ (display_value|pb_class) : classes_inner %}
{% endfor %}

{% set pb_link = content.pb_content_image_link.0['#url'] %}
{% set pb_link_title = content.pb_content_image_link_title|render|striptags|trim %}
{% set pb_content_image_link_new_tab = paragraph.hasField('pb_content_image_link_new_tab') and not paragraph.pb_content_image_link_new_tab.isEmpty and paragraph|pb_field_value('pb_content_image_link_new_tab') %}
{% set pb_image = content.pb_content_image %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">
    {% if pb_link and pb_image %}
      <div class="pb-image__wrapper pb-card__image">
        <a href="{{ pb_link }}" class="pb-ui-link"{% if pb_link_title %} title="{{ pb_link_title }}"{% endif %}{% if pb_content_image_link_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
          {{ pb_image }}
          {% if pb_title %}
            <div class="pb-card__image-title">
              {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
            </div>
          {% endif %}
        </a>
      </div>
    {% elseif pb_image %}
      <div class="pb-image__wrapper pb-card__image">
        {{ pb_image }}
        {% if pb_title %}
          <div class="pb-card__image-title">
            {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
