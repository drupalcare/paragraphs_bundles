{#
/**
 * @file
 * `card_three_columns_bundle` paragraph template (v2).
 *
 * Dynamic CSS: `#pb-card-three-columns-{id} > .pb-ui-inner`.
 *
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 * @see \Drupal\paragraphs_bundles\Service\Css\PbDynamicCssBuilder
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_card/paragraph-bundle-card') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set pb_display_layout = paragraph|pb_field_value('pb_display_card_layout_three') %}
{% set pb_layout_class = pb_display_layout ? 'pb-card-three-columns--' ~ pb_display_layout|replace({_: '-'}) : '' %}
{% if pb_display_layout %}
  {% set pb_breakpoint = paragraph|pb_field_value('pb_display_card_breakpoints') %}
  {% if pb_breakpoint %}
    {{ attach_library('paragraph_bundle_card/paragraph-bundle-card-' ~ pb_breakpoint) }}
  {% endif %}
{% endif %}

{% set paragraph_id = pb_paragraph_id ?: 'pb-card-three-columns-' ~ paragraph.id.value %}
{% set classes_inner = 'pb-ui-inner pb-card-three-columns__inner' %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-card',
  'pb-card-three-columns',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set pb_displays = [
  'pb_display_width',
  'pb_display_border',
  'pb_display_border_radius',
  'pb_display_margin',
  'pb_display_padding',
  'pb_display_shadow',
] %}
{% for pb_display in pb_displays %}
  {% set display_value = paragraph|pb_field_value(pb_display) %}
  {% set classes_inner = display_value ? classes_inner ~ ' ' ~ (display_value|pb_class) : classes_inner %}
{% endfor %}

{% set pb_title = content.pb_content_title|render|striptags|trim %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">
    <div class="pb-content__full">
      {% if pb_title %}
        {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
      {% endif %}
      <div class="pb-card-three-columns {{ pb_layout_class }}">
        <div class="pb-card-three-columns__left">
          {{ content.pb_content_card_left }}
        </div>
        <div class="pb-card-three-columns__middle">
          {{ content.pb_content_card_middle }}
        </div>
        <div class="pb-card-three-columns__right">
          {{ content.pb_content_card_right }}
        </div>
      </div>
    </div>
  </div>
</div>
