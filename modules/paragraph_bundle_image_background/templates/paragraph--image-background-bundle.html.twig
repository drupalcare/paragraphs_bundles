{#
/**
 * @file
 * `image_background_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars                         | DOM target              | v2 mechanism |
 * |--------------------------------------|-------------------------|--------------|
 * | pb_display_* (list)                  | `.pb-image-background__inner` | entity field values |
 * | pb_display_bg + opacity              | `.img-color-overlay`    | dynamic CSS `background-color` |
 * | pb_display_background_* (no sm img)  | outer `#pb__image-bg-{id}` | dynamic CSS |
 * | pb_display_image_min_height          | outer wrapper           | dynamic CSS `min-height` |
 * | pb_display_background_image_sm       | outer `data-*` + JS     | breakpoint swap |
 *
 * Outer id: `#pb__image-bg-{id}`; inner colors use default inner scope when set.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_image_background/paragraph-bundle-image-background') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id ?: 'pb__image-bg-' ~ paragraph.id.value %}
{% set classes_inner = 'pb-ui-inner pb-image-background__inner pb-content__full' %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-image-background',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set pb_image_url = paragraph|pb_image_field_url('pb_display_background_image') %}
{% set pb_image_alt = paragraph.pb_display_background_image.alt|default('') %}
{% set pb_image_title = paragraph.pb_display_background_image.title|default('') %}
{% set pb_image_url_sm = paragraph|pb_image_field_url('pb_display_background_image_sm') %}
{% set pb_display_bg = paragraph|pb_field_value('pb_display_bg') %}

{% set pb_displays = [
  'pb_display_width',
  'pb_display_padding',
] %}
{% for pb_display in pb_displays %}
  {% set display_value = paragraph|pb_field_value(pb_display) %}
  {% set classes_inner = display_value ? classes_inner ~ ' ' ~ (display_value|pb_class) : classes_inner %}
{% endfor %}

{% if pb_image_url_sm %}
  {% set pb_breakpoint = paragraph|pb_field_value('pb_display_image_breakpoint', 'pb__992') %}
  {% set breakpoints = {
    pb__576: 576,
    pb__768: 768,
    pb__992: 992,
    pb__1200: 1200,
    pb__1400: 1400,
  } %}
  {% set breakpoint_value = breakpoints[pb_breakpoint] %}

  <div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}
       data-breakpoint="{{ breakpoint_value }}"
       data-image-big="{{ pb_image_url }}"
       data-image-small="{{ pb_image_url_sm }}"
       {% if pb_image_title %} data-image-title="{{ pb_image_title }}"{% endif %}
       {% if pb_image_alt %} data-image-alt="{{ pb_image_alt }}"{% endif %}>
{% else %}
  <div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}
       data-image-big="{{ pb_image_url }}"
       {% if pb_image_title %} data-image-title="{{ pb_image_title }}"{% endif %}
       {% if pb_image_alt %} data-image-alt="{{ pb_image_alt }}"{% endif %}>
{% endif %}

{% if pb_display_bg %}
  <div class="img-color-overlay"></div>
{% endif %}

<div class="{{ classes_inner }}">
  {{ content.pb_content_main }}
</div>
</div>
