{#
/**
 * @file
 * `image_background_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars                         | DOM target              | v2 mechanism |
 * |--------------------------------------|-------------------------|--------------|
 * | pb_display_* (list)                  | `.pb-image-background__inner` | entity field values |
 * | pb_display_bg + opacity              | `.img-color-overlay`    | dynamic CSS `background-color` |
 * | pb_display_background_* (no sm img)  | outer `#pb-image-background-{id}` | dynamic CSS |
 * | pb_display_image_min_height          | outer wrapper           | dynamic CSS `min-height` |
 * | pb_display_background_image_sm       | outer `data-*` + JS     | breakpoint swap |
 * | pb_image_url, pb_image_url_sm        | outer `data-*`          | PbibPreprocessHook (Pattern image style or the file) |
 *
 * Outer id: `#pb-image-background-{id}`; inner colors use default inner scope when set.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_image_background/paragraph-bundle-image-background') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = ['pb-ui-inner', 'pb-image-background__inner', 'pb-content__full']|merge(pb_display_classes)|join(' ') %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-image-background',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{# pb_image_url and pb_image_url_sm come from PbibPreprocessHook: the image
   style the section's Pattern names, else the file as uploaded. #}
{% set pb_image_alt = paragraph.pb_display_background_image.alt|default('') %}
{% set pb_image_title = paragraph.pb_display_background_image.title|default('') %}
{% set pb_display_bg = paragraph|pb_field_value('pb_display_bg') %}

{% if pb_image_url_sm %}
  {% set pb_breakpoint = paragraph|pb_field_value('pb_display_image_breakpoint', 'pb__992') %}
  {% set breakpoints = {
    pb__576: 576,
    pb__768: 768,
    pb__992: 992,
    pb__1200: 1200,
    pb__1400: 1400,
  } %}
  {% set breakpoint_value = breakpoints[pb_breakpoint] %}

  <div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}
       data-breakpoint="{{ breakpoint_value }}"
       data-image-big="{{ pb_image_url }}"
       data-image-small="{{ pb_image_url_sm }}"
       {% if pb_image_title %} data-image-title="{{ pb_image_title }}"{% endif %}
       {% if pb_image_alt %} data-image-alt="{{ pb_image_alt }}"{% endif %}>
{% else %}
  <div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}
       data-image-big="{{ pb_image_url }}"
       {% if pb_image_title %} data-image-title="{{ pb_image_title }}"{% endif %}
       {% if pb_image_alt %} data-image-alt="{{ pb_image_alt }}"{% endif %}>
{% endif %}

{# The background is CSS, so it has no alt of its own. Alt text set means the
   image carries meaning: a separate empty element exposes it as an image named
   by the alt (role="img" on the wrapper would hide the section's content). An
   empty alt means decorative, and nothing is exposed. #}
{% if pb_image_alt and (pb_image_url or pb_image_url_sm) %}
  <span class="pb-image-background__alt visually-hidden" role="img" aria-label="{{ pb_image_alt }}"></span>
{% endif %}

{# A background image always wins; without one, the SVG from the theme's pb-svg-icons folder (pb_svg, PbSvgHook). #}
{% if not pb_image_url and not pb_image_url_sm and pb_svg %}
  {{ pb_svg }}
{% endif %}

{% if pb_display_bg %}
  <div class="img-color-overlay"></div>
{% endif %}

<div class="{{ classes_inner }}">
  {{ content.pb_content_main }}
</div>
</div>
