<?php

/**
 * @file
 * Install and update hooks for paragraph_bundle_3d_carousel.
 *
 * V2 update hooks (pre-release):
 *  - 9001: move max width and screen-height fields into Display → Additional.
 *  - 9002: add the CSS Classes field.
 *  - 9003: add the Carousel style field (rotating ring / coverflow).
 *
 * THE FIELD IS OPTIONAL AND AN ABSENT VALUE MEANS THE ROTATING RING. Every
 * carousel that existed before this field was a ring, so "no value" resolves
 * to the ring at all three layers rather than being an error state:
 *
 *   - `default_value: ring` in the field config, for newly created paragraphs;
 *   - `pb_field_value('pb_display_3d_car_style', 'ring')` in the template,
 *     which decides what is rendered;
 *   - Pb3dcLibraryHook::DEFAULT_STYLE, which decides which geometry
 *     stylesheet is attached.
 *
 * Update 9003 additionally backfills `ring` onto content that predates the
 * field, so the stored data is explicit rather than merely defaulted. An
 * editor who wants the new coverflow selects it deliberately.
 */

declare(strict_types=1);

use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\Sql\DefaultTableMapping;
use Drupal\Core\Entity\Sql\SqlEntityStorageInterface;

/**
 * Display tab group overrides for 3d_carousel_bundle.
 *
 * Width and screen heights belong in Additional (same pattern as
 * carousel_bundle slide width / breakpoints).
 *
 * @return array<string, array{remove?: list<string>, add?: list<string>}>
 *   Group id => remove/add field lists.
 */
function paragraph_bundle_3d_carousel_display_group_overrides(): array {
  return [
    'group_pb_display_size' => [
      'remove' => ['pb_display_width'],
    ],
    'group_pb_display_extra' => [
      'add' => [
        // It decides what the other settings in here are describing, so it
        // carries the lowest weight (19) and renders first.
        //
        // ⚠ It does NOT sit first in this `children` list, and cannot:
        // paragraphs_bundles_pb_nest_display_field_groups() APPENDS, so after
        // 9003 ran the stored order is play_stop, breakpoints, style, width,
        // lheight, sheight, perspective. Measured, not assumed. The weight is
        // what puts it at the top of the group; this list is not.
        'pb_display_3d_car_style',
        'pb_display_width',
        'pb_content_3dcar_lheight',
        'pb_content_3dcar_sheight',
      ],
    ],
  ];
}

/**
 * Applies the 3D carousel Display tab field group layout on active config.
 */
function paragraph_bundle_3d_carousel_apply_form_display_layout(): void {
  \Drupal::moduleHandler()->loadInclude('paragraphs_bundles', 'inc', 'paragraphs_bundles.display');
  paragraphs_bundles_pb_nest_display_field_groups(
    '3d_carousel_bundle',
    paragraph_bundle_3d_carousel_display_group_overrides(),
  );
}

/**
 * Moves width and screen-height fields into Display → Additional.
 */
function paragraph_bundle_3d_carousel_update_9001(): string {
  paragraph_bundle_3d_carousel_apply_form_display_layout();
  return (string) t('3D carousel Display tab: width and screen heights grouped under Additional.');
}

/**
 * Adds the CSS Classes field to the bundle this module owns.
 *
 * The field lets a site put its own class on every instance of a bundle and
 * style them all with one theme rule. New sites get it from config/optional;
 * this is the path for sites that already have the bundle.
 */
function paragraph_bundle_3d_carousel_update_9002(): string {
  \Drupal::moduleHandler()->loadInclude('paragraphs_bundles', 'install');
  $done = [];
  foreach (['3d_carousel_bundle'] as $bundle) {
    if (paragraphs_bundles_pb_css_classes_wire_bundle('paragraph_bundle_3d_carousel', $bundle)) {
      $done[] = $bundle;
    }
  }
  return $done === []
    ? (string) t('CSS Classes field was already present; nothing to do.')
    : (string) t('CSS Classes field added to: @list.', ['@list' => implode(', ', $done)]);
}

/**
 * Adds the Carousel style field to sites that already have the bundle.
 *
 * Config in config/optional only installs on a FRESH install, so without this
 * an existing site keeps the bundle it has and never sees the new field — the
 * feature would ship and be invisible to every site that already uses it. The
 * maintainer asked for exactly this to be checked: "must work with existed
 * users or new users".
 *
 * Every step is guarded, so the hook is safe to re-run and safe on a site that
 * already has the field from a fresh install of the same code.
 *
 * WHY THE FIELD IS OPTIONAL (the shipped YAML says `required: false`). The
 * backfill below cannot reach every revision: measured on sts.local
 * 2026-09-25, 31 of 49 carousel revisions held no value, and reverting to one
 * of them failed validation with "This value should not be null" while the
 * field was required. Nothing needs the requirement either, because an absent
 * value resolves to the rotating ring in the field default, the template and
 * Pb3dcLibraryHook::DEFAULT_STYLE. (A separate 9004 once relaxed sites that
 * had received the field as required; neither hook was ever released, so it
 * was folded in here on 2026-09-26.)
 *
 * @see paragraph_bundle_alert_update_9001()
 */
function paragraph_bundle_3d_carousel_update_9003(): string {
  \Drupal::moduleHandler()->loadInclude('paragraphs_bundles', 'install');

  // 1. Storage, then instance. Order matters: the instance depends on it.
  foreach ([
    'field.storage.paragraph.pb_display_3d_car_style',
    'field.field.paragraph.3d_carousel_bundle.pb_display_3d_car_style',
  ] as $config_name) {
    paragraphs_bundles_import_optional_config_if_missing(
      'paragraph_bundle_3d_carousel',
      $config_name,
    );
  }

  $created = (bool) \Drupal::entityTypeManager()
    ->getStorage('field_config')
    ->load('paragraph.3d_carousel_bundle.pb_display_3d_car_style');

  // 2. Put it on the edit form. Weight 19 renders it above the other extras,
  //    because it decides what those settings are describing.
  $form_display = \Drupal::entityTypeManager()
    ->getStorage('entity_form_display')
    ->load('paragraph.3d_carousel_bundle.default');
  if ($form_display && !$form_display->getComponent('pb_display_3d_car_style')) {
    $form_display->setComponent('pb_display_3d_car_style', [
      'type' => 'options_select',
      'weight' => 19,
      'region' => 'content',
      'settings' => [],
      'third_party_settings' => [],
    ])->save();
  }

  // 3. Keep it off the rendered output, like every other display control —
  //    the template reads the value, so printing it as a field would put the
  //    word "coverflow" on the page.
  $view_display = \Drupal::entityTypeManager()
    ->getStorage('entity_view_display')
    ->load('paragraph.3d_carousel_bundle.default');
  if ($view_display && $view_display->getComponent('pb_display_3d_car_style')) {
    $view_display->removeComponent('pb_display_3d_car_style')->save();
  }

  // 4. Nest it under Display → Additional.
  paragraph_bundle_3d_carousel_apply_form_display_layout();

  // 5. Give existing carousels the value they already behave as having.
  $filled = paragraph_bundle_3d_carousel_backfill_style();

  return $created
    ? (string) t('Carousel style field added to 3d_carousel_bundle, placed under Display → Additional, and set to "Rotating ring" on @count existing carousel(s).', ['@count' => $filled])
    : (string) t('Carousel style field was already present; display layout re-applied and @count carousel(s) backfilled.', ['@count' => $filled]);
}

/**
 * Writes the default style onto carousels that predate the field.
 *
 * WHY THIS IS NEEDED. A field default applies only when an entity is CREATED,
 * so every carousel that existed before the field did holds an EMPTY value.
 * Without a stored value the dropdown opens unselected, so the edit form
 * would not show what the carousel actually renders. The template falling back to 'ring' fixes rendering and does nothing for the
 * edit form, which is the half a template cannot reach.
 *
 * 🚨 WHY IT WRITES TO STORAGE INSTEAD OF SAVING ENTITIES.
 *
 * WHAT WAS MEASURED on sts.local, 2026-09-24: the first version of this
 * backfill loaded each paragraph, set the value and called `save()` on it.
 * During that run node 93 went from THREE carousels to ONE — the other two
 * still existed as entities but were no longer referenced by the field — and a
 * third paragraph came back carrying a value it had never been given. The
 * node's previous revision still held all three, so the loss was recoverable.
 *
 * ⚠ WHAT IS NOT PROVEN: that the standalone `save()` is what caused it. That
 * is the obvious suspect — a paragraph is owned by its parent's field — but a
 * Kernel test built to reproduce it does NOT: with the same ownership metadata
 * (parent_type, parent_id, parent_field_name all set) the identical mutation
 * leaves the parent holding all three children. So the mechanism is still
 * unexplained, and something else in that run may be responsible.
 *
 * Writing to storage is therefore the conservative choice rather than a proven
 * remedy: it loads no parent, runs no presave hook and saves no entity, so
 * whatever the mechanism turns out to be, this code is not exposed to it.
 * ⚠ Do not treat the suspect as settled until it is reproduced.
 *
 * Writing the field's own data and revision rows touches no entity, loads no
 * parent and runs no presave hook, so it cannot re-parent or drop anything.
 * The table and column names are read from the entity type's table mapping
 * rather than assembled by hand, because a long field name can be truncated
 * and a write aimed at a table that does not exist fails quietly.
 *
 * It is written to be safely re-runnable: only paragraphs with no row at all
 * are touched, so a second run is a no-op rather than a duplicate.
 *
 * @return int
 *   How many paragraphs were given a value.
 */
function paragraph_bundle_3d_carousel_backfill_style(): int {
  $field = 'pb_display_3d_car_style';
  $bundle = '3d_carousel_bundle';

  $definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('paragraph');

  if (!isset($definitions[$field])) {
    return 0;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('paragraph');

  // getTableMapping() is declared on SqlEntityStorageInterface, NOT on the
  // EntityStorageInterface that getStorage() is typed to return. Narrowing
  // rather than assuming also keeps this fail-closed on a site running a
  // non-SQL storage back end, where the dedicated field tables this function
  // writes to do not exist at all.
  if (!$storage instanceof SqlEntityStorageInterface) {
    return 0;
  }

  $mapping = $storage->getTableMapping();

  // getTableMapping() is typed to return TableMappingInterface, which declares
  // NEITHER getDedicatedDataTableName() nor getDedicatedRevisionTableName().
  // Both live on the concrete DefaultTableMapping — core declares them at
  // DefaultTableMapping.php lines 569 and 595 — and that is what
  // SqlContentEntityStorage::getTableMapping() actually builds. Same narrowing
  // as the storage guard above, one layer down, and fail-closed for the same
  // reason: with no dedicated tables there is nothing this function can safely
  // write.
  if (!$mapping instanceof DefaultTableMapping) {
    return 0;
  }

  $data_table = $mapping->getDedicatedDataTableName($definitions[$field]);
  $revision_table = $mapping->getDedicatedRevisionTableName($definitions[$field]);
  // ⚠ getColumnNames() returns [] for a field it does not know, rather than
  // throwing — core DefaultTableMapping.php:413-423 builds an empty mapping
  // and returns it. So indexing ['value'] straight off it is an undefined-key
  // warning AND a NULL column name, in the middle of `drush updatedb`, which
  // would then write rows keyed on nothing. This function states fail-closed
  // intent three times over; this was the one place it did not.
  // Found by independent review, 2026-09-25.
  $columns = $mapping->getColumnNames($field);
  if (!isset($columns['value'])) {
    return 0;
  }

  $column = $columns['value'];

  $database = \Drupal::database();

  if (!$database->schema()->tableExists($data_table)) {
    return 0;
  }

  // Only carousels with no value at all. Anything an editor has already chosen
  // is left exactly as it is.
  $ids = \Drupal::entityQuery('paragraph')
    ->accessCheck(FALSE)
    ->condition('type', $bundle)
    ->notExists($field)
    ->execute();

  // execute() is typed `array|int` because a COUNT query returns an int. This
  // is not a count query, so the array branch is the only one reachable — but
  // asserting it here is what makes array_values() below provably safe instead
  // of safe-by-inspection, which is the whole point of running the analyser.
  if (!is_array($ids) || $ids === []) {
    return 0;
  }

  $filled = 0;

  // Chunked: a large site can hold thousands of these, and loading them all at
  // once is how an update hook runs out of memory half way through.
  foreach (array_chunk(array_values($ids), 50) as $chunk) {
    // EVERY REVISION OF THIS CHUNK, IN ONE QUERY.
    //
    // ⚠ NOT $storage->revisionIds(). That method is declared on
    // NodeStorageInterface, NOT on generic entity storage — measured
    // 2026-09-24, Drupal\paragraphs\ParagraphsStorage does not have it, so
    // calling it here would be "Call to undefined method" in the middle of
    // drush updatedb. `php -l` and PHPCS both pass that code happily, which
    // is why it was caught by running it rather than by linting it.
    //
    // allRevisions() returns [revision_id => entity_id] and works for any
    // revisionable entity type.
    $revisions = [];
    $revision_rows = \Drupal::entityQuery('paragraph')
      ->accessCheck(FALSE)
      ->allRevisions()
      ->condition('id', $chunk, 'IN')
      ->execute();

    // Same `array|int` shape as the selection above — a COUNT query would
    // return an int. Only the array branch is reachable here, and saying so
    // is what lets the analyser prove the foreach instead of trusting it.
    foreach (is_array($revision_rows) ? $revision_rows : [] as $revision_id => $entity_id) {
      $revisions[$entity_id][] = $revision_id;
    }

    // Loading is read-only and safe. SAVING is what must never happen here.
    foreach ($storage->loadMultiple($chunk) as $paragraph) {
      // loadMultiple() is typed EntityInterface[], which does not declare
      // getRevisionId(). ContentEntityInterface is the narrowing used because
      // it is what a paragraph actually IS, and it carries both halves this
      // loop needs: getRevisionId() through TranslatableRevisionableInterface,
      // and language()/id() through FieldableEntityInterface.
      //
      // ⚠ An earlier version of this comment justified the choice by claiming
      // RevisionableInterface "does not extend EntityInterface". IT DOES —
      // core declares `interface RevisionableInterface extends EntityInterface`
      // — so the reasoning was wrong even though the choice stands. Corrected
      // rather than quietly deleted: a plausible-sounding false reason in a
      // comment outlives whoever wrote it, and the next reader has no way to
      // tell it from a measured one.
      //
      // Skipping anything else is the fail-closed direction: it writes nothing,
      // rather than a row carrying a wrong revision id.
      if (!$paragraph instanceof ContentEntityInterface) {
        continue;
      }

      $langcode = $paragraph->language()->getId();
      $id = $paragraph->id();

      // WHICH REVISIONS ALREADY HOLD A VALUE — READ BEFORE ANYTHING IS WRITTEN.
      //
      // 🚨 THE ORDER IS THE POINT. An earlier version ran this query AFTER the
      // data-table write below, and bailed on a NULL result with `continue`.
      // That left the data row written, the revision rows missing and $filled
      // not incremented — and because the selection above is
      // `notExists($field)`, which the entity query answers from the DATA
      // table, the now-present data row means a RE-RUN NO LONGER SELECTS THIS
      // PARAGRAPH. The gap becomes permanent and silent: exactly the failure
      // the merge() change below was written to prevent, reintroduced one edit
      // later by its own null guard.
      //
      // Reading first means a bail costs nothing: nothing has been written, the
      // paragraph is still unselected-free, and the next run picks it up.
      $existing_rows = $database->select($revision_table, 'r')
        ->fields('r', ['revision_id'])
        ->condition('entity_id', $id)
        ->condition('langcode', $langcode)
        ->condition('delta', 0)
        ->condition('deleted', 0)
        ->execute();

      // execute() is typed `?StatementInterface`, and chaining fetchCol()
      // straight off it is both a PHPStan error and a fatal if it is ever NULL
      // — inside `drush updatedb`, where a fatal leaves a site half converted.
      if ($existing_rows === NULL) {
        continue;
      }

      $existing = array_map('strval', $existing_rows->fetchCol());

      // ⚠ merge(), NOT insert(). The selection above asks the entity query for
      // paragraphs with no value, which tests the DATA table only — so the two
      // tables can disagree and a plain insert turns that disagreement into a
      // fatal:
      //
      //   - data row present, revision rows missing (a run that died between
      //     the two writes): never selected again, so the gap is permanent and
      //     silent, and those revisions stay empty on a REQUIRED field;
      //   - data row missing, revision rows present: selected, and the revision
      //     insert collides with the existing key — `drush updatedb` dies part
      //     way through, on a site whose content is already half converted.
      //
      // merge() is idempotent per row, so a partial run RESUMES instead of
      // crashing, and a complete re-run is still a no-op.
      $database->merge($data_table)
        ->keys([
          'entity_id' => $id,
          'deleted' => 0,
          'delta' => 0,
          'langcode' => $langcode,
        ])
        ->fields([
          'bundle' => $bundle,
          'revision_id' => $paragraph->getRevisionId(),
          $column => 'ring',
        ])
        ->execute();

      // Every revision, not just the current one, or the value vanishes the
      // moment somebody reverts a node to an earlier revision.
      //
      // 🚨 BUT ONLY REVISIONS THAT HAVE NO ROW AT ALL, AND THAT DISTINCTION IS
      // NOT COSMETIC. Selection above is `notExists($field)`, which the entity
      // query answers from the DATA table — and that table holds only the
      // CURRENT revision. So an entity can be selected while its revision rows
      // already carry real, differing values.
      //
      // MEASURED on sts.local 2026-09-24, paragraph 492: revision 2665 held
      // 'coverflow' and 2669 held 'ring'. An earlier version of this loop
      // merged 'ring' across every revision and turned 2665 into 'ring',
      // silently destroying edit history. That version had been written to fix
      // a duplicate-key crash in this exact asymmetric case — and it did fix
      // it, by replacing a loud failure with a quiet one. That is worse: a
      // crashed update hook gets reported, an overwritten revision does not.
      //
      // ⚠ The test that first exercised this deleted ALL rows before running,
      // so there was nothing left to overwrite and it passed. Only the
      // asymmetric shape shows the defect.
      //
      // $existing was read ABOVE, before any write — see the note there for
      // why the order matters.
      foreach ($revisions[$id] ?? [$paragraph->getRevisionId()] as $revision_id) {
        // Never touch a revision that already has a value, whatever it says.
        if (in_array((string) $revision_id, $existing, TRUE)) {
          continue;
        }

        $database->merge($revision_table)
          ->keys([
            'entity_id' => $id,
            'revision_id' => $revision_id,
            'deleted' => 0,
            'delta' => 0,
            'langcode' => $langcode,
          ])
          ->fields([
            'bundle' => $bundle,
            $column => 'ring',
          ])
          ->execute();
      }

      $filled++;
    }

    // Per CHUNK, not once at the end. These rows went in behind the entity
    // API, so anything holding a cached copy has to be told — and doing it
    // here releases each chunk's entities as that chunk finishes instead of
    // pinning every loaded paragraph in memory until the whole run is over.
    // On the site this was written against that is 9 paragraphs and the
    // difference is nothing; the chunking exists for sites where it is not.
    $storage->resetCache($chunk);
  }

  // The tag invalidation stays OUTSIDE the loop deliberately: it is one global
  // statement about "paragraphs changed", so firing it per chunk would repeat
  // identical work for no benefit.
  if ($filled > 0) {
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['paragraph_list']);
  }

  return $filled;
}
