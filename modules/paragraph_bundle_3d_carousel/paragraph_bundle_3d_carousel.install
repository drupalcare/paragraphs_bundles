<?php

/**
 * @file
 * Install and update hooks for paragraph_bundle_3d_carousel.
 *
 * V2 update hook (pre-release — one hook only):
 *  - 9001: move max width and screen-height fields into Display → Additional.
 */

declare(strict_types=1);

/**
 * Display tab group overrides for 3d_carousel_bundle.
 *
 * Width and screen heights belong in Additional (same pattern as
 * carousel_bundle slide width / breakpoints).
 *
 * @return array<string, array{remove?: list<string>, add?: list<string>}>
 *   Group id => remove/add field lists.
 */
function paragraph_bundle_3d_carousel_display_group_overrides(): array {
  return [
    'group_pb_display_size' => [
      'remove' => ['pb_display_width'],
    ],
    'group_pb_display_extra' => [
      'add' => [
        'pb_display_width',
        'pb_content_3dcar_lheight',
        'pb_content_3dcar_sheight',
      ],
    ],
  ];
}

/**
 * Applies the 3D carousel Display tab field group layout on active config.
 */
function paragraph_bundle_3d_carousel_apply_form_display_layout(): void {
  \Drupal::moduleHandler()->loadInclude('paragraphs_bundles', 'inc', 'paragraphs_bundles.display');
  paragraphs_bundles_pb_nest_display_field_groups(
    '3d_carousel_bundle',
    paragraph_bundle_3d_carousel_display_group_overrides(),
  );
}

/**
 * Moves width and screen-height fields into Display → Additional.
 */
function paragraph_bundle_3d_carousel_update_9001(): string {
  paragraph_bundle_3d_carousel_apply_form_display_layout();
  return (string) t('3D carousel Display tab: width and screen heights grouped under Additional.');
}
