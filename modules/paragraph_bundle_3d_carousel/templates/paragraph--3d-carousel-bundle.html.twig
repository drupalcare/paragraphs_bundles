{#
/**
 * @file
 * `3d_carousel_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars                         | DOM target           | v2 mechanism |
 * |--------------------------------------|----------------------|--------------|
 * | pb_display_* (list)                  | `.pb-ui-inner`  | entity field values |
 * | pb_display_bg/text/border/link*      | `.pb-ui-inner`  | dynamic CSS |
 * | pb_display_3d_car_perspective        | `.pb-ui-inner`  | inline `perspective` (px) |
 * | pb_display_3d_caro_breakpoints       | outer wrapper        | breakpoint library |
 * | pb_content_3dcar_lheight/sheight     | outer wrapper class  | entity field values |
 * | pb_display_3d_play_stop              | `data-rotation-delay`| entity integer value |
 *
 * Dynamic CSS selector: `#pb-3d-carousel-{id} > .pb-ui-inner`
 *
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_3d_carousel/paragraph-bundle-3d-carousel') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set breakpoints_raw = paragraph|pb_field_value('pb_display_3d_caro_breakpoints') %}
{% if breakpoints_raw %}
  {{ attach_library('paragraph_bundle_3d_carousel/paragraph-bundle-3d-carousel-' ~ breakpoints_raw) }}
{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = ['pb-ui-inner', 'pb-3d-carousel__inner', 'pb-content__full']|merge(pb_display_classes)|join(' ') %}
{% set pb_play_stop = paragraph|pb_field_value('pb_display_3d_play_stop', 0) %}

{% set pb_lheight_raw = paragraph|pb_field_value('pb_content_3dcar_lheight') %}
{% set pb_sheight_raw = paragraph|pb_field_value('pb_content_3dcar_sheight') %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-3d-carousel',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
  pb_lheight_raw ? 'pb-3d-carousel--h' ~ pb_lheight_raw,
  pb_sheight_raw ? 'pb-3d-carousel--sh' ~ pb_sheight_raw,
] %}

{% set carousel_id = 'pb-3d-carousel-ring-' ~ paragraph.id.value %}
{% set co_id = 'co-' ~ paragraph.id.value %}
{% set valid_slides = content.pb_content_3d_car_body|filter((item, key) => key|first != '#') %}
{% set total_slides = valid_slides|length %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }} role="region" aria-label="{{ 'Image Carousel'|t }}">
  <div class="{{ classes_inner }}">

    <div id="{{ carousel_id }}"
         class="pb-3d-carousel__ring"
         role="group"
         aria-roledescription="carousel"
         aria-labelledby="index-{{ paragraph.id.value }}"
         data-rotation-delay="{{ pb_play_stop }}">

      {% for key, item in valid_slides %}
        <div id="item-{{ paragraph.id.value }}-{{ loop.index }}"
             class="pb-3d-carousel__slide item-{{ paragraph.id.value }}-{{ loop.index }}"
             role="group"
             aria-hidden="{{ loop.first ? 'false' : 'true' }}"
             tabindex="{{ loop.first ? 0 : -1 }}"
             aria-labelledby="label-item-{{ paragraph.id.value }}-{{ loop.index }}">
          <div id="label-item-{{ paragraph.id.value }}-{{ loop.index }}" class="visually-hidden">{{ 'Slide @current of @total'|t({'@current': loop.index, '@total': total_slides}) }}</div>
          {{ item }}
        </div>
      {% endfor %}

    </div>

    <div id="{{ co_id }}" class="pb-3d-carousel__options" aria-label="{{ 'Carousel Controls'|t }}">
      <div class="pb-ui-row pb-3d-carousel__options-inner">
        <button id="prev-{{ paragraph.id.value }}" type="button" class="pb-ui-btn pb-nav__prev" aria-controls="{{ carousel_id }}" aria-label="{{ 'Previous Slide'|t }}">
          <span class="visually-hidden">{{ 'Previous Slide'|t }}</span>
          <span>{{ include('@paragraph_bundle_3d_carousel/svg/svg-prev.svg') }}</span>
        </button>
        <span id="index-{{ paragraph.id.value }}" class="pb-slideshow__number" aria-label="{{ 'Slide 1 of @total'|t({'@total': total_slides}) }}" role="status" aria-live="polite"></span>

        {% if pb_play_stop > 0 %}
          <button id="btn-{{ paragraph.id.value }}"
                  type="button"
                  class="pb-ui-btn pb-nav__pause"
                  aria-controls="{{ carousel_id }}"
                  aria-label="{{ 'Pause slideshow'|t }}"
                  aria-pressed="true">
            <span class="visually-hidden">{{ 'Pause slideshow'|t }}</span>
            <span class="pb-nav__pause-icon">{{ include('@paragraph_bundle_3d_carousel/svg/svg-pause.svg') }}</span>
            <span class="pb-nav__play-icon" hidden>{{ include('@paragraph_bundle_3d_carousel/svg/svg-play.svg') }}</span>
          </button>
        {% endif %}

        <button id="next-{{ paragraph.id.value }}" type="button" class="pb-ui-btn pb-nav__next" aria-controls="{{ carousel_id }}" aria-label="{{ 'Next Slide'|t }}">
          <span class="visually-hidden">{{ 'Next Slide'|t }}</span>
          <span>{{ include('@paragraph_bundle_3d_carousel/svg/svg-next.svg') }}</span>
        </button>
      </div>
    </div>

  </div>
</div>
