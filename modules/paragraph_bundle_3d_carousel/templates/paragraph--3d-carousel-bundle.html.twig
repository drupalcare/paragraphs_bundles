{#
/**
 * @file
 * `3d_carousel_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars                         | DOM target           | v2 mechanism |
 * |--------------------------------------|----------------------|--------------|
 * | pb_display_* (list)                  | `.pb-ui-inner`  | entity field values |
 * | pb_display_bg/text/border/link*      | `.pb-ui-inner`  | dynamic CSS |
 * | pb_display_3d_car_perspective        | `.pb-ui-inner`  | dynamic CSS |
 * | pb_display_3d_caro_breakpoints       | outer wrapper        | breakpoint library |
 * | pb_content_3dcar_lheight/sheight     | outer wrapper class  | entity field values |
 * | pb_display_3d_play_stop              | `data-rotation-delay`| entity integer value |
 *
 * Dynamic CSS selector: `#pb-3d-carousel-{id} > .pb-ui-inner`
 *
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_3d_carousel/paragraph-bundle-3d-carousel') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set breakpoints_raw = paragraph|pb_field_value('pb_display_3d_caro_breakpoints') %}
{% if breakpoints_raw %}
  {{ attach_library('paragraph_bundle_3d_carousel/paragraph-bundle-3d-carousel-' ~ breakpoints_raw) }}
{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{# `pb-width-own` -- this element OWNS its width: the node width does not clamp
   it and its bundle max-width is not blanked.

   Load-bearing here, not cosmetic. The slide transforms and the `perspective`
   are computed from THIS box, so clamping it to the node width would skew the
   3D geometry rather than merely narrow it. The editor's own max-width on the
   paragraph is the right authority.

   Checked against the other three inherited owners: the slideshow and the plain
   carousel were WRONG to be on that list and now follow the node width. This one
   and the modal are correct. #}
{% set classes_inner = ['pb-ui-inner', 'pb-3d-carousel__inner', 'pb-content__full', 'pb-width-own']|merge(pb_display_classes)|join(' ') %}
{% set pb_play_stop = paragraph|pb_field_value('pb_display_3d_play_stop', 0) %}

{% set pb_lheight_raw = paragraph|pb_field_value('pb_content_3dcar_lheight') %}
{% set pb_sheight_raw = paragraph|pb_field_value('pb_content_3dcar_sheight') %}

{# WHICH GEOMETRY, defaulting to the ring.

   THE DEFAULT IS LOAD-BEARING, not tidiness. A field default only applies when
   an entity is CREATED, so every carousel that existed before update 9003 ran
   holds an empty value — measured on sts.local 2026-09-24, all five of them.
   Without `'ring'` here those carousels would render with no style at all. -#}
{% set pb_car_style = paragraph|pb_field_value('pb_display_3d_car_style', 'ring') -%}

{# ONE STYLE LIBRARY, NEVER BOTH. The shared library above carries the base
   stylesheet and the script; this adds only the rules true of the chosen
   geometry. A ring page therefore never downloads the fan's rules, and a
   coverflow never downloads the ring's pointer-events rule — which is the one
   that used to make its visible cards silently unclickable.

   The value is bounded to `ring` or `coverflow` by the field's allowed values
   and by the default above, but it is checked rather than trusted: a stray
   value would otherwise ask Drupal for a library that does not exist. -#}
{% if pb_car_style in ['ring', 'coverflow'] -%}
  {{ attach_library('paragraph_bundle_3d_carousel/paragraph-bundle-3d-carousel-' ~ pb_car_style) -}}
{% endif -%}

{# ONLY the coverflow class is ever emitted -- there is deliberately no
   "--ring" class. The ring is the default and its markup must stay byte
   identical, because thirteen demo sites compare published pages byte for
   byte and any added attribute would show as a diff on every one of them.

   THIS NOTE LIVES HERE, NOT BETWEEN THE ARRAY ITEMS BELOW. A Twig comment
   placed inside a set expression is not a comment at all: the lexer is in
   expression mode there, so it keeps reading and fails on the first character
   it cannot parse. Measured 2026-09-24 -- writing one inside this very array
   took the page to HTTP 500 with a Twig SyntaxError naming an unexpected
   character. Keep explanations outside the brackets.

   Every tag added for the geometry ends in `-` so it emits no whitespace:
   without it these lines printed blank lines on every ring, and the ring's
   markup must stay byte identical. -#}
{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-3d-carousel',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
  pb_lheight_raw ? 'pb-3d-carousel--h' ~ pb_lheight_raw,
  pb_sheight_raw ? 'pb-3d-carousel--sh' ~ pb_sheight_raw,
  pb_car_style == 'coverflow' ? 'pb-3d-carousel--coverflow',
] %}

{% set carousel_id = 'pb-3d-carousel__ring-' ~ paragraph.id.value %}
{% set co_id = 'pb-3d-carousel__options-' ~ paragraph.id.value %}
{% set valid_slides = content.pb_content_3d_car_body|filter((item, key) => key|first != '#') %}
{% set total_slides = valid_slides|length %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }} role="region" aria-label="{{ 'Image Carousel'|t }}">
  <div class="{{ classes_inner }}">

    <div id="{{ carousel_id }}"
         class="pb-3d-carousel__ring"
         role="group"
         aria-roledescription="carousel"
         aria-labelledby="pb-3d-carousel__index-{{ paragraph.id.value }}"
         data-rotation-delay="{{ pb_play_stop }}"{% if pb_car_style == 'coverflow' %}
         data-pb-style="coverflow"{% endif %}>

      {% for key, item in valid_slides %}
        <div id="pb-3d-carousel__slide-{{ paragraph.id.value }}-{{ loop.index }}"
             class="pb-3d-carousel__slide"
             role="group"
             aria-hidden="{{ loop.first ? 'false' : 'true' }}"
             tabindex="{{ loop.first ? 0 : -1 }}"
             aria-labelledby="pb-3d-carousel__slide-label-{{ paragraph.id.value }}-{{ loop.index }}">
          <div id="pb-3d-carousel__slide-label-{{ paragraph.id.value }}-{{ loop.index }}" class="visually-hidden">{{ 'Slide @current of @total'|t({'@current': loop.index, '@total': total_slides}) }}</div>
          {{ item }}
        </div>
      {% endfor %}

    </div>

    <div id="{{ co_id }}" class="pb-3d-carousel__options" aria-label="{{ 'Carousel Controls'|t }}">
      <div class="pb-ui-row pb-3d-carousel__options-inner">
        <button id="pb-3d-carousel__prev-{{ paragraph.id.value }}" type="button" class="pb-ui-btn pb-nav__prev" aria-controls="{{ carousel_id }}" aria-label="{{ 'Previous Slide'|t }}">
          <span class="visually-hidden">{{ 'Previous Slide'|t }}</span>
          <span>{{ include('@paragraph_bundle_3d_carousel/svg/svg-prev.svg') }}</span>
        </button>
        <span id="pb-3d-carousel__index-{{ paragraph.id.value }}" class="pb-slideshow__number" aria-label="{{ 'Slide 1 of @total'|t({'@total': total_slides}) }}" role="status" aria-live="polite"></span>

        {% if pb_play_stop > 0 %}
          <button id="pb-3d-carousel__play-pause-{{ paragraph.id.value }}"
                  type="button"
                  class="pb-ui-btn pb-nav__pause"
                  aria-controls="{{ carousel_id }}"
                  aria-label="{{ 'Pause slideshow'|t }}"
                  aria-pressed="true">
            <span class="visually-hidden">{{ 'Pause slideshow'|t }}</span>
            <span class="pb-nav__pause-icon">{{ include('@paragraph_bundle_3d_carousel/svg/svg-pause.svg') }}</span>
            <span class="pb-nav__play-icon" hidden>{{ include('@paragraph_bundle_3d_carousel/svg/svg-play.svg') }}</span>
          </button>
        {% endif %}

        <button id="pb-3d-carousel__next-{{ paragraph.id.value }}" type="button" class="pb-ui-btn pb-nav__next" aria-controls="{{ carousel_id }}" aria-label="{{ 'Next Slide'|t }}">
          <span class="visually-hidden">{{ 'Next Slide'|t }}</span>
          <span>{{ include('@paragraph_bundle_3d_carousel/svg/svg-next.svg') }}</span>
        </button>
      </div>
    </div>

  </div>
</div>
