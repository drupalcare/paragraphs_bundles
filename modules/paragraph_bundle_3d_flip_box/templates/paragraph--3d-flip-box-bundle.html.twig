{#
/**
 * @file
 * `3d_flip_box_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars                    | DOM target               | v2 mechanism |
 * |---------------------------------|--------------------------|--------------|
 * | pb_display_* (list)             | `.pb-ui-inner`           | entity field values |
 * | pb_display_bg/text/border/link* | `.pb-ui-inner`           | dynamic CSS |
 * | pb_display_flip_xy              | `.pb-3d-flip-box__scene` | class on scene |
 * | pb_display_3d_height            | `.pb-3d-flip-box__scene` | inline `height` (px) |
 *
 * Dynamic CSS selector: `#pb__3d-flip-box-{id} > .pb-ui-inner`
 *
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_3d_flip_box/paragraph-bundle-3d-flip-box') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = 'pb-ui-inner' %}
{% set pb_flip_xy = paragraph|pb_field_value('pb_display_flip_xy') %}
{% set pb_box_height = paragraph|pb_field_value('pb_display_3d_height') %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-3d-flip-box',
  'paragraph--type--3d-flip-box-bundle',
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set pb_displays = [
  'pb_display_width',
  'pb_display_border',
  'pb_display_border_radius',
  'pb_display_margin',
  'pb_display_padding',
  'pb_display_shadow',
] %}
{% for pb_display in pb_displays %}
  {% set display_value = paragraph|pb_field_value(pb_display) %}
  {% set classes_inner = display_value ? classes_inner ~ ' ' ~ (display_value|pb_class) : classes_inner %}
{% endfor %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">

    <div class="pb-content__full">
      {% if pb_title %}
        {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
      {% endif %}

      <div class="pb-3d-flip-box__scene{{ pb_flip_xy ? ' pb-3d-flip-box--' ~ pb_flip_xy|replace({_: '-'}) }}" tabindex="0"{% if pb_box_height %} style="height: {{ pb_box_height }}px"{% endif %}>
        <div class="pb-3d-flip-box__inner">
          <div class="pb-3d-flip-box__front">{{ content.pb_content_3d_box_front }}</div>
          <div class="pb-3d-flip-box__back{{ pb_flip_xy ? ' pb-3d-flip-box--' ~ pb_flip_xy|replace({_: '-'}) }}">{{ content.pb_content_3d_box_back }}</div>
        </div>
      </div>

    </div>
  </div>
</div>
