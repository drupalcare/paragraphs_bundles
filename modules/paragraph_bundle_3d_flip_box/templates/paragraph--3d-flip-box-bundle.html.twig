{#
/**
 * @file
 * `3d_flip_box_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars                    | DOM target               | v2 mechanism |
 * |---------------------------------|--------------------------|--------------|
 * | pb_display_* (list)             | `.pb-ui-inner`           | entity field values |
 * | pb_display_bg/text/border/link* | `.pb-ui-inner`           | dynamic CSS |
 * | pb_display_flip_xy              | `.pb-3d-flip-box__scene` | class on scene |
 * | pb_display_3d_height            | `.pb-3d-flip-box__scene` | generated CSS file (px) |
 *
 * Dynamic CSS selector: `#pb-3d-flip-box-{id} > .pb-ui-inner`
 *
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_3d_flip_box/paragraph-bundle-3d-flip-box') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = ['pb-ui-inner']|merge(pb_display_classes)|join(' ') %}
{% set pb_flip_xy = paragraph|pb_field_value('pb_display_flip_xy') %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-3d-flip-box',
  'paragraph--type--3d-flip-box-bundle',
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">

    <div class="pb-content__full">
      {% if pb_title %}
        {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
      {% endif %}

      {#
        NO INLINE STYLE HERE. The scene height now comes from this paragraph's
        generated stylesheet — see PbDynamicUserVarBuilder::USER_STYLE_SCOPES,
        `3d_flip_box_bundle`. A `style="…"` attribute cannot be permitted by a
        Content Security Policy except via `'unsafe-inline'`, and unlike a
        `<style>` element it cannot carry a nonce.
      #}
      <div class="pb-3d-flip-box__scene{{ pb_flip_xy ? ' pb-3d-flip-box--' ~ pb_flip_xy|replace({_: '-'}) }}">
        <div class="pb-3d-flip-box__inner" id="{{ paragraph_id }}-faces">
          <div class="pb-3d-flip-box__front">{{ content.pb_content_3d_box_front }}</div>
          <div class="pb-3d-flip-box__back{{ pb_flip_xy ? ' pb-3d-flip-box--' ~ pb_flip_xy|replace({_: '-'}) }}">{{ content.pb_content_3d_box_back }}</div>
        </div>
        {#
          Hidden until the behaviour attaches: without the script the button
          has nothing to toggle, and a control that does nothing is worse than
          no control. The faces are left operable for that no-JS case, exactly
          as they were before — the script is what makes the face-down one
          inert.
        #}
        <button type="button" class="pb-3d-flip-box__toggle" aria-expanded="false" aria-controls="{{ paragraph_id }}-faces" hidden>
          {#
            A card with an arrow turning over it — "show me the other side".

            The previous glyph was two panels either side of a dashed mirror
            axis. That is the icon design tools use for "flip horizontal", i.e.
            MIRROR THIS OBJECT, which is not what this control does; and at the
            24px it renders at, the dashed axis (3px dashes, 2.5px gaps) aliased
            into a smudge while the solid left panel read as an off-centre blob.
            Three ink weights in 24px was more than the size could carry.

            This one has a single stroke weight and no sub-pixel detail, and it
            is ASYMMETRIC on purpose: the state rotation below turns it 180deg,
            which is only visible if the glyph has a top and a bottom. Still
            drawn from primitives, so the bundle carries no third-party licence.
          #}
          <svg class="pb-3d-flip-box__toggle-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
            <rect x="4.4" y="8.6" width="15.2" height="11" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
            <path d="M5.4 6.4A8.4 8.4 0 0 1 18.6 6.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M18.9 2.6 19 6.9 14.8 6.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {#
            The label is the SPOKEN state, and it has to change with the face on
            show — including when a pointer is what changed it. `aria-expanded`
            alone says open/closed, which does not describe a card that has two
            equal sides. The behaviour swaps between these two strings; both are
            translated here rather than built in JS so they stay extractable.
          #}
          <span class="visually-hidden" data-pb-label-front="{{ pb_title ? 'Show the back of @title'|t({'@title': pb_title}) : 'Show the back'|t }}" data-pb-label-back="{{ pb_title ? 'Show the front of @title'|t({'@title': pb_title}) : 'Show the front'|t }}">{{ pb_title ? 'Show the back of @title'|t({'@title': pb_title}) : 'Show the back'|t }}</span>
        </button>
      </div>

    </div>
  </div>
</div>
