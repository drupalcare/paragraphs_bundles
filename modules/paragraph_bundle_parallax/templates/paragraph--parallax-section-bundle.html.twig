{#
/**
 * @file
 * `parallax_section_bundle` paragraph template (v2).
 *
 * Outer wrapper (`#pb-parallax-{id}`): scroll mode, breakpoint, data attrs.
 * Inner (`.pb-ui-inner`): section height + parallax effect class.
 * Background (`.pb-parallax__bg`): image URL + JS animation custom properties.
 * Text layer (`.pb-parallax__text`): display list classes; color vars via
 * dynamic CSS on `#pb-parallax-{id} .pb-parallax__text`.
 *
 * Nested inside `parallax_bundle` via `pb_content_parallax_section`.
 *
 * @see paragraph--parallax-bundle.html.twig
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_parallax/paragraph-bundle-parallax') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set pb_anim_easing = paragraph|pb_field_value('pb_display_para_anim_easing', 'ease') %}
{% set pb_anim_speed = paragraph|pb_field_value('pb_display_para_bg_anim_speed', '0.3') %}
{% set pb_bg_height_unit = paragraph|pb_field_value('pb_display_para_height_unit', 'px') %}
{% set pb_bg_position = paragraph|pb_field_value('pb_display_parallax_bg_position', 'center') %}
{% set pb_breakpoints = paragraph|pb_field_value('pb_display_parallax_breakpoints', 'all') %}
{% set pb_scroll_affect = paragraph|pb_field_value('pb_display_parallax_scroll', 'legacy') %}
{% set pb_parallax_speed = paragraph|pb_field_value('pb_display_parallax_speed', '0.7') %}

{% if pb_breakpoints %}
  {{ attach_library('paragraph_bundle_parallax/paragraph-bundle-parallax__' ~ pb_breakpoints) }}
{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = []|merge(pb_display_classes)|join(' ') %}
{% set pb_height_unit_css = pb_bg_height_unit == 'pr' ? '%' : pb_bg_height_unit %}
{% set pb_easing_css = pb_anim_easing|replace({_: '-'}) %}
{% set pb_effect_css = pb_scroll_affect|replace({_: '-'}) %}
{% set effect_class = 'pb-parallax--' ~ pb_effect_css %}
{% set breakpoint_class = 'pb-parallax--br-' ~ pb_breakpoints %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-parallax-section',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
  pb_scroll_affect == 'legacy' ? 'parallax-css' : 'parallax-js',
  breakpoint_class,
  'easing-' ~ pb_easing_css,
  'bg-pos-' ~ pb_bg_position|replace({' ': '-', '%': 'pct', _: '-'}),
  'height-unit-' ~ pb_height_unit_css|replace({_: '-'}),
] %}

{# Resolve the background image through the file/media resolver rather than
   rendering the field and stripping tags. The rendered-output route depended
   on the `pb_media_parallax` view mode keeping the `image_url` formatter (it
   is editable optional config), and it yielded a raw editor-supplied filename
   that was then interpolated into a `style` attribute, where Twig's HTML
   autoescape offers no protection, because `(`, `)` and `;` are not escaped.
   `pb_image_field_url` returns a generated, path-encoded URL. #}
{% set pb_image_url = paragraph|pb_image_field_url('pb_content_image') %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id).setAttribute('data-breakpoint', pb_breakpoints).setAttribute('data-parallax-speed', pb_parallax_speed).setAttribute('data-parallax-effect', pb_effect_css) }}>
  <div class="pb-ui-inner pb-parallax-section__inner {{ effect_class }}">

    {#
      NO INLINE STYLES HERE. The background image and the animation custom
      properties now come from this paragraph's generated stylesheet: see
      PbDynamicUserVarBuilder::USER_STYLE_SCOPES, `parallax_section_bundle`.
      A style ATTRIBUTE cannot be permitted by a Content Security Policy
      except through `'unsafe-inline'`; unlike a `<style>` element it cannot
      carry a nonce.

      THE BRANCH STAYS. `image-url-empty` is a state the stylesheet renders
      differently (it centers a message at full viewport height), so it is
      markup, not styling.
    #}
    {% if pb_image_url %}
      <div class="pb-parallax__bg"></div>
    {% else %}
      <div class="pb-parallax__bg image-url-empty"></div>
    {% endif %}

    <div class="pb-parallax__text{{ classes_inner == '' ? '' : ' ' ~ classes_inner }}">
      <div class="pb-content__full">{{ content.pb_content_body }}{{ content.pb_content_link }}</div>
    </div>

  </div>
</div>
