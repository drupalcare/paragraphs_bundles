<?php

/**
 * @file
 * Install and update hooks for paragraph_bundle_link.
 */

declare(strict_types=1);

/**
 * Adds the CSS Classes field to the bundle this module owns.
 *
 * The field lets a site put its own class on every instance of a bundle and
 * style them all with one theme rule. New sites get it from config/optional;
 * this is the path for sites that already have the bundle.
 */
function paragraph_bundle_link_update_9001(): string {
  \Drupal::moduleHandler()->loadInclude('paragraphs_bundles', 'install');
  $done = [];
  foreach (['link_bundle'] as $bundle) {
    if (paragraphs_bundles_pb_css_classes_wire_bundle('paragraph_bundle_link', $bundle)) {
      $done[] = $bundle;
    }
  }
  return $done === []
    ? (string) t('CSS Classes field was already present; nothing to do.')
    : (string) t('CSS Classes field added to: @list.', ['@list' => implode(', ', $done)]);
}

/**
 * Adds the CSS Classes field to each Link item (link_section_bundle).
 *
 * One class per link lets a theme give each link its own icon or colour.
 * The preprocess hook already puts the sanitised classes on the item's outer
 * element, so no render code changes. The item form has no Display tab, so
 * the field stays ungrouped at the end of the form.
 */
function paragraph_bundle_link_update_9002(): string {
  \Drupal::moduleHandler()->loadInclude('paragraphs_bundles', 'install');
  if (\Drupal::entityTypeManager()->getStorage('paragraphs_type')->load('link_section_bundle') === NULL) {
    return (string) t('Link item is not installed; nothing to do.');
  }
  return paragraphs_bundles_pb_css_classes_wire_bundle('paragraph_bundle_link', 'link_section_bundle')
    ? (string) t('CSS Classes field added to: link_section_bundle.')
    : (string) t('CSS Classes field could not be added to link_section_bundle.');
}
