{#
/**
 * @file
 * `link_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field                  | DOM target        | v2 mechanism |
 * |------------------------|-------------------|--------------|
 * | pb_display_* (list)    | `.pb-link__inner` | entity field values |
 * | pb_display_bg* / text* | `.pb-link__inner` | dynamic CSS `--pb-*` |
 * | pb_display_border_color* | `.pb-link__inner` | dynamic CSS `--pb-br*` |
 * | pb_display_link*       | `.pb-link__inner` | dynamic CSS `--pb-lk*` |
 * | pb_link_section_body   | `.pb-content__full` | nested `link_section` |
 *
 * Dynamic CSS selector: `#pb__link-{id} > .pb-ui-inner`
 * Nested section links inherit `--pb-lk*` via `.pb-link__inner :where(a)`.
 * Scoping contract: L0 `pb-link` on paragraph root.
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = ['pb-ui-inner', 'pb-link__inner']|merge(pb_display_classes)|join(' ') %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-link',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set pb_title = content.pb_content_title|render|striptags|trim %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">

    <div class="pb-content__full">

      {% if pb_title %}
        {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
      {% endif %}

      {{ content|without(
        'pb_content_title',
        'pb_content_title_tag',
        'pb_content_title_alignment',
        'pb_display_bg',
        'pb_display_bg_opacity',
        'pb_display_bg_hover',
        'pb_display_border_color',
        'pb_display_border_hover',
        'pb_display_text',
        'pb_display_text_hover',
        'pb_display_link',
        'pb_display_link_hover',
        'pb_display_border',
        'pb_display_border_radius',
        'pb_display_margin',
        'pb_display_padding',
        'pb_display_width',
        'pb_display_shadow',
        'pb_link_section_body',
      ) }}

      {{ content.pb_link_section_body }}

    </div>

  </div>
</div>
