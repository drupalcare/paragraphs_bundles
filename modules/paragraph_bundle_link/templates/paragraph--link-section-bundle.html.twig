{#
/**
 * @file
 * `link_section_bundle` paragraph template (v2).
 *
 * v1 Twig audit:
 *
 * | Field                         | DOM target | CSS |
 * |-------------------------------|------------|-----|
 * | pb_content_link_section_title | outer div  | none (plain text before link) |
 * | pb_content_link_section_url   | outer div  | inherits `--pb-lk*` from parent `.pb-link__inner :where(a)` |
 *
 * Scoping contract: L0 `pb-link-section` on paragraph root.
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraph_bundle_link\Hook\PblThemeHook
 *
 * @ingroup themeable
 */
#}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-link-section',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
] %}

<div{{ attributes.addClass(classes) }}>
  {{ content }}
</div>
