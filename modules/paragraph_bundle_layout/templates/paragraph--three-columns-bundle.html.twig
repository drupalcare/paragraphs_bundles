{#
/**
 * @file
 * `three_columns_bundle` paragraph template (v2).
 *
 * Dynamic CSS selector: `#pb__three-columns-{id} > .pb-ui-inner`
 * Column anim/sticky vars remain inline on `.pb-three-columns` grid.
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_layout/paragraph-bundle-layout') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set pb_display_layout = paragraph|pb_field_value('pb_display_three_columns') %}
{% set pb_layout_class = pb_display_layout ? 'pb-three-columns--' ~ pb_display_layout|replace({_: '-'}) : '' %}
{% set pb_layout_bp_key = paragraph|pb_field_value('pb_display_layout_breakpoints') %}
{% if pb_display_layout and pb_layout_bp_key %}
  {{ attach_library('paragraph_bundle_layout/paragraph-bundle-layout-' ~ pb_layout_bp_key) }}
{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = 'pb-ui-inner pb-three-columns__inner' %}

{% set pb_3c_l_stk = paragraph.hasField('pb_display_3c_l_stk') and not paragraph.pb_display_3c_l_stk.isEmpty and paragraph|pb_field_value('pb_display_3c_l_stk') %}
{% set pb_3c_m_stk = paragraph.hasField('pb_display_3c_m_stk') and not paragraph.pb_display_3c_m_stk.isEmpty and paragraph|pb_field_value('pb_display_3c_m_stk') %}
{% set pb_3c_r_stk = paragraph.hasField('pb_display_3c_r_stk') and not paragraph.pb_display_3c_r_stk.isEmpty and paragraph|pb_field_value('pb_display_3c_r_stk') %}
{% set pb_3c_l_tgl = paragraph.hasField('pb_display_3c_l_tgl') and not paragraph.pb_display_3c_l_tgl.isEmpty and paragraph|pb_field_value('pb_display_3c_l_tgl') %}
{% set pb_3c_m_tgl = paragraph.hasField('pb_display_3c_m_tgl') and not paragraph.pb_display_3c_m_tgl.isEmpty and paragraph|pb_field_value('pb_display_3c_m_tgl') %}
{% set pb_3c_r_tgl = paragraph.hasField('pb_display_3c_r_tgl') and not paragraph.pb_display_3c_r_tgl.isEmpty and paragraph|pb_field_value('pb_display_3c_r_tgl') %}

{% set pb_3c_icn_pos = paragraph.hasField('pb_display_3c_icn_pos') and not paragraph.pb_display_3c_icn_pos.isEmpty ? paragraph|pb_field_value('pb_display_3c_icn_pos') : 'edge' %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-layout',
  'pb-three-columns',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
  pb_layout_bp_key ? pb_layout_bp_key,
  (pb_3c_l_stk or pb_3c_m_stk or pb_3c_r_stk) ? 'pb-has-sticky-col',
  (pb_3c_l_tgl or pb_3c_m_tgl or pb_3c_r_tgl) ? 'pb-layout-col__icon-pos--' ~ pb_3c_icn_pos|replace({_: '-'}),
] %}

{% set pb_displays = [
  'pb_display_width',
  'pb_display_border',
  'pb_display_border_radius',
  'pb_display_margin',
  'pb_display_padding',
  'pb_display_shadow',
] %}
{% for pb_display in pb_displays %}
  {% set display_value = paragraph|pb_field_value(pb_display) %}
  {% set classes_inner = display_value ? classes_inner ~ ' ' ~ (display_value|pb_class) : classes_inner %}
{% endfor %}

{% set pb_title = content.pb_content_title|render|striptags|trim %}
{% set pb_3c_l_def = paragraph.hasField('pb_display_3c_l_def') and not paragraph.pb_display_3c_l_def.isEmpty ? paragraph|pb_field_value('pb_display_3c_l_def') : 'open' %}
{% set pb_3c_m_def = paragraph.hasField('pb_display_3c_m_def') and not paragraph.pb_display_3c_m_def.isEmpty ? paragraph|pb_field_value('pb_display_3c_m_def') : 'open' %}
{% set pb_3c_r_def = paragraph.hasField('pb_display_3c_r_def') and not paragraph.pb_display_3c_r_def.isEmpty ? paragraph|pb_field_value('pb_display_3c_r_def') : 'open' %}
{% set pb_3c_stk_top = paragraph.hasField('pb_display_3c_stk_top') and not paragraph.pb_display_3c_stk_top.isEmpty ? paragraph|pb_field_value('pb_display_3c_stk_top') : '0' %}
{% set pb_3c_icn = paragraph.hasField('pb_display_3c_icn') and not paragraph.pb_display_3c_icn.isEmpty ? paragraph|pb_field_value('pb_display_3c_icn') : 'chevron' %}
{% set pb_3c_anim = paragraph.hasField('pb_display_3c_anim') and not paragraph.pb_display_3c_anim.isEmpty ? paragraph|pb_field_value('pb_display_3c_anim') : 'slide' %}
{% set pb_3c_anim_ms = paragraph.hasField('pb_display_3c_anim_ms') and not paragraph.pb_display_3c_anim_ms.isEmpty ? paragraph|pb_field_value('pb_display_3c_anim_ms') : '300' %}
{% set pb_3c_expand = paragraph.hasField('pb_display_3c_expand') and not paragraph.pb_display_3c_expand.isEmpty and paragraph|pb_field_value('pb_display_3c_expand') %}
{% set pb_layout_min_map = {
  pb__576: '36rem',
  pb__768: '48rem',
  pb__992: '62rem',
  pb__1200: '75rem',
  pb__1400: '87.5rem',
} %}
{% set pb_layout_min = pb_layout_min_map[pb_layout_bp_key]|default('62rem') %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">

    <div class="pb-content__full">
      {% if pb_title %}
        {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
      {% endif %}

      {% if pb_3c_l_tgl or pb_3c_m_tgl or pb_3c_r_tgl %}
      <div class="pb-layout-col__toolbar pb-three-columns {{ pb_layout_class }}">
        {% if pb_3c_l_tgl %}
          <button type="button"
                  class="pb-layout-col__toggle"
                  data-col-toggle="left"
                  data-label-expand="{{ 'Expand left column'|t }}"
                  data-label-collapse="{{ 'Collapse left column'|t }}"
                  aria-controls="{{ paragraph_id }}-col-left"
                  aria-expanded="{{ pb_3c_l_def == 'closed' ? 'false' : 'true' }}"
                  aria-label="{{ pb_3c_l_def == 'closed' ? 'Expand left column'|t : 'Collapse left column'|t }}"
                  title="{{ pb_3c_l_def == 'closed' ? 'Expand left column'|t : 'Collapse left column'|t }}">
            {{ include('@paragraph_bundle_layout/templates/pb-col-toggle-icons.html.twig', {icon_style: pb_3c_icn, col_side: 'left'}, false) }}
            <span class="visually-hidden">{{ 'Toggle left column'|t }}</span>
          </button>
        {% endif %}
        {% if pb_3c_m_tgl %}
          <button type="button"
                  class="pb-layout-col__toggle"
                  data-col-toggle="middle"
                  data-label-expand="{{ 'Expand middle column'|t }}"
                  data-label-collapse="{{ 'Collapse middle column'|t }}"
                  aria-controls="{{ paragraph_id }}-col-middle"
                  aria-expanded="{{ pb_3c_m_def == 'closed' ? 'false' : 'true' }}"
                  aria-label="{{ pb_3c_m_def == 'closed' ? 'Expand middle column'|t : 'Collapse middle column'|t }}"
                  title="{{ pb_3c_m_def == 'closed' ? 'Expand middle column'|t : 'Collapse middle column'|t }}">
            {{ include('@paragraph_bundle_layout/templates/pb-col-toggle-icons.html.twig', {icon_style: pb_3c_icn, col_side: 'middle'}, false) }}
            <span class="visually-hidden">{{ 'Toggle middle column'|t }}</span>
          </button>
        {% endif %}
        {% if pb_3c_r_tgl %}
          <button type="button"
                  class="pb-layout-col__toggle"
                  data-col-toggle="right"
                  data-label-expand="{{ 'Expand right column'|t }}"
                  data-label-collapse="{{ 'Collapse right column'|t }}"
                  aria-controls="{{ paragraph_id }}-col-right"
                  aria-expanded="{{ pb_3c_r_def == 'closed' ? 'false' : 'true' }}"
                  aria-label="{{ pb_3c_r_def == 'closed' ? 'Expand right column'|t : 'Collapse right column'|t }}"
                  title="{{ pb_3c_r_def == 'closed' ? 'Expand right column'|t : 'Collapse right column'|t }}">
            {{ include('@paragraph_bundle_layout/templates/pb-col-toggle-icons.html.twig', {icon_style: pb_3c_icn, col_side: 'right'}, false) }}
            <span class="visually-hidden">{{ 'Toggle right column'|t }}</span>
          </button>
        {% endif %}
      </div>
      {% endif %}

      <div class="pb-three-columns {{ pb_layout_class }}"
           data-col-icon-style="{{ pb_3c_icn }}"
           data-col-icon-position="{{ pb_3c_icn_pos }}"
           data-col-anim="{{ pb_3c_anim }}"
           data-col-anim-ms="{{ pb_3c_anim_ms }}"
           data-col-expand="{{ pb_3c_expand ? '1' : '0' }}"
           data-col-layout-min="{{ pb_layout_min }}"
           data-col-sticky-top="{{ pb_3c_stk_top|default('0') }}">
        <div class="pb-col-left{{ pb_3c_l_stk ? ' pb-is-sticky' : '' }}{{ pb_3c_l_tgl and pb_3c_l_def == 'closed' ? ' pb-is-collapsed' : '' }}"
             data-col="left"
             data-col-toggle-enabled="{{ pb_3c_l_tgl ? '1' : '0' }}"
             {% if pb_3c_l_tgl %}data-col-default="{{ pb_3c_l_def }}"{% endif %}>
          <div id="{{ paragraph_id }}-col-left" class="pb-layout-col__content"{% if pb_3c_l_tgl and pb_3c_l_def == 'closed' %} aria-hidden="true" inert{% endif %}>
          {{ content.pb_content_left_column }}
          </div>
        </div>
        <div class="pb-col-middle{{ pb_3c_m_stk ? ' pb-is-sticky' : '' }}{{ pb_3c_m_tgl and pb_3c_m_def == 'closed' ? ' pb-is-collapsed' : '' }}"
             data-col="middle"
             data-col-toggle-enabled="{{ pb_3c_m_tgl ? '1' : '0' }}"
             {% if pb_3c_m_tgl %}data-col-default="{{ pb_3c_m_def }}"{% endif %}>
          <div id="{{ paragraph_id }}-col-middle" class="pb-layout-col__content"{% if pb_3c_m_tgl and pb_3c_m_def == 'closed' %} aria-hidden="true" inert{% endif %}>
          {{ content.pb_content_middle_column }}
          </div>
        </div>
        <div class="pb-col-right{{ pb_3c_r_stk ? ' pb-is-sticky' : '' }}{{ pb_3c_r_tgl and pb_3c_r_def == 'closed' ? ' pb-is-collapsed' : '' }}"
             data-col="right"
             data-col-toggle-enabled="{{ pb_3c_r_tgl ? '1' : '0' }}"
             {% if pb_3c_r_tgl %}data-col-default="{{ pb_3c_r_def }}"{% endif %}>
          <div id="{{ paragraph_id }}-col-right" class="pb-layout-col__content"{% if pb_3c_r_tgl and pb_3c_r_def == 'closed' %} aria-hidden="true" inert{% endif %}>
          {{ content.pb_content_right_column }}
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
