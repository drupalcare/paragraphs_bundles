{#
/**
 * @file
 * `modal_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars              | DOM target                              | CSS |
 * |---------------------------|-----------------------------------------|-----|
 * | pb_display_* (list)       | `.pb-ui-inner.pb-modal__inner`          | base classes |
 * | pb_display_bg/text/border*| `.pb-ui-inner` inside dialog             | dynamic CSS |
 * | pb_display_animated_modal | `.pb-modal__content`                    | animation class |
 *
 * Dynamic CSS selector:
 * `#pb-modal-{id}-win .pb-modal__content > .pb-ui-inner`
 *
 * Outer wrapper id: `pb-modal__wrapper-{id}` (trigger area).
 * Button id: `pb-modal-{id}`; dialog id: `pb-modal-{id}-win`.
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 * @see \Drupal\paragraphs_bundles\Service\Css\PbDynamicCssBuilder
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_modal/paragraph-bundle-modal') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set modal_wrapper_id = 'pb-modal__wrapper-' ~ paragraph.id.value %}
{# `pb-width-own` -- this element OWNS its width: the node width does not clamp
   it and its bundle max-width is not blanked.

   A modal is an OVERLAY. It is lifted out of the page's content column, so the
   node's content width has no authority over it -- the paragraph's own
   max-width does. Maintainer's call, 2026-09-12.

   Checked against the other three inherited owners: the slideshow and the plain
   carousel were WRONG to be on that list and now follow the node width. This one
   and the 3D carousel are correct. #}
{% set classes_inner = ['pb-ui-inner', 'pb-modal__inner', 'pb-content__full', 'pb-width-own']|merge(pb_display_classes)|join(' ') %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-modal',
  'pb-content__full',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set pb_animated_modal = paragraph|pb_field_value('pb_display_animated_modal')|pb_class %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}
{% set modal_title_text = content.pb_content_modal_title|render|striptags|trim %}
{% set modal_button_text = content.pb_content_modal_button|render|striptags|trim %}
{% set modal_body_rendered = content.pb_content_modal_body|render|striptags|trim %}
{% set modal_accessible_label = modal_button_text ?: pb_title ?: 'Dialog'|t %}

<div {{ attributes.addClass(classes).setAttribute('id', modal_wrapper_id) }}>

  {% if pb_title %}
    {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
  {% endif %}

  <div class="pb-modal__button">
    <button id="{{ paragraph_id }}" type="button" class="pb-ui-btn" aria-expanded="false" aria-controls="{{ paragraph_id }}-win" data-toggle="modal" data-target="#{{ paragraph_id }}-win"{% if not modal_button_text %} aria-label="{{ 'Open dialog'|t }}"{% endif %}>
      {% if modal_button_text %}
        {{ content.pb_content_modal_button }}
      {% else %}
        <span class="visually-hidden">{{ 'Open dialog'|t }}</span>
      {% endif %}
    </button>
  </div>

  {# L3 dialog host - JS once() attaches here; open trigger is sibling `.pb-modal__button`. #}
  <div class="pb-modal__dialog" id="{{ paragraph_id }}-win" role="dialog"{% if modal_title_text %} aria-labelledby="{{ paragraph_id }}-label"{% else %} aria-label="{{ modal_accessible_label }}"{% endif %}{% if modal_body_rendered %} aria-describedby="{{ paragraph_id }}-description"{% endif %} aria-hidden="true" tabindex="-1">
    <div class="pb-modal__content {{ pb_animated_modal }}">
      <div class="{{ classes_inner }}">

        <div class="pb-modal__header">
          {% if content.pb_content_modal_title|render %}
            <div class="pb-modal__title" id="{{ paragraph_id }}-label">
              {{ content.pb_content_modal_title }}
            </div>
          {% endif %}
          <button type="button" class="pb-ui-btn" data-dismiss="modal" aria-label="{{ 'Close'|t }}"><span aria-hidden="true">&times;</span></button>
        </div>

        {% if content.pb_content_modal_body|render %}
          <div class="pb-modal__body" id="{{ paragraph_id }}-description">
            {% for key, item in content.pb_content_modal_body %}
              {% if key|first != '#' %}
                {{ item }}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if content.pb_content_modal_footer|render %}
          <div class="pb-modal__footer">
            {% for key, item in content.pb_content_modal_footer %}
              {% if key|first != '#' %}
                {{ item }}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

      </div>
    </div>
  </div>
</div>
