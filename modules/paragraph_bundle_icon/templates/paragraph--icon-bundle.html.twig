{#
/**
 * @file
 * `icon_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field                  | DOM target           | CSS |
 * |------------------------|----------------------|-----|
 * | pb_display_width       | `.pb-ui-inner`  | paragraphs-bundles-custom.css |
 * | pb_display_border      | `.pb-ui-inner`  | base `.pb__border*` |
 * | pb_display_border_radius | `.pb-ui-inner` | base `.pb__round*` |
 * | pb_display_margin      | `.pb-ui-inner`  | base `.pb__margin*` |
 * | pb_display_padding     | `.pb-ui-inner`  | base `.pb__padding*` |
 * | pb_display_shadow      | `.pb-ui-inner`  | base `.pb-card*` |
 * | pb_display_bg*         | `.pb-ui-inner`  | dynamic CSS `--pb-bg*` |
 * | pb_display_text*       | `.pb-ui-inner`  | dynamic CSS `--pb-tx*` |
 * | pb_display_border_color* | `.pb-ui-inner` | dynamic CSS `--pb-br*` |
 * | pb_display_link*       | `.pb-ui-inner`  | dynamic CSS `--pb-lk*` |
 *
 * Dynamic CSS selector: `#pb-icon-{id} > .pb-ui-inner` plus GMS vars on
 * `.icon-wrapper`. Scoping contract: L0 `pb-icon` on paragraph root.
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_icon/paragraph-bundle-icon') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set icon_style = paragraph|pb_field_value('pb_content_gms_style')|default('outlined') %}
{{ attach_library('paragraph_bundle_icon/paragraph-bundle-icon-' ~ icon_style) }}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = ['pb-ui-inner', 'pb-icon__inner']|merge(pb_display_classes)|join(' ') %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-icon',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set gms_name = paragraph|pb_field_value('pb_content_gms_icon_name') %}
{% set gms_style = 'material-symbols-' ~ icon_style %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}
{% set icon_link = content.pb_content_link.0['#url'] %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">

    <div class="pb-content__full">
      {% if content.pb_content_image_icon|render %}
        <div class="pb-icon__header">
          {% if icon_link %}
            <a href="{{ icon_link }}" class="pb-ui-link"{% if pb_title %} title="{{ pb_title }}"{% endif %}>
          {% endif %}
          {% if pb_title %}
            {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
          {% endif %}
          {{ content.pb_content_image_icon }}
          {% if icon_link %}
            </a>
          {% endif %}
        </div>
      {% else %}
        <div class="pb-icon__header">
          {% if icon_link %}
            <a href="{{ icon_link }}" class="pb-ui-link"{% if pb_title %} title="{{ pb_title }}"{% endif %}>
          {% endif %}
          {% if pb_title %}
            {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
          {% endif %}
          <div class="icon-wrapper material-icons-hidden">
            <span class="{{ gms_style }}">{{ gms_name }}</span>
          </div>
          {% if icon_link %}
            </a>
          {% endif %}
        </div>
      {% endif %}
      {{ content.pb_content_body }}

      {{ content|without(
        'pb_content_body',
        'pb_content_image_icon',
        'pb_content_link',
        'pb_content_title',
        'pb_content_title_tag',
        'pb_content_title_alignment',
        'pb_content_gms_fill',
        'pb_content_gms_grade',
        'pb_content_gms_icon_color',
        'pb_content_gms_icon_font_size',
        'pb_content_gms_icon_name',
        'pb_content_gms_optical_size',
        'pb_content_gms_style',
        'pb_content_gms_weight',
        'pb_display_bg',
        'pb_display_bg_hover',
        'pb_display_bg_opacity',
        'pb_display_border',
        'pb_display_border_color',
        'pb_display_border_hover',
        'pb_display_border_radius',
        'pb_display_margin',
        'pb_display_padding',
        'pb_display_shadow',
        'pb_display_text',
        'pb_display_text_hover',
        'pb_display_link',
        'pb_display_link_hover',
        'pb_display_width',
      ) }}
    </div>

  </div>
</div>
