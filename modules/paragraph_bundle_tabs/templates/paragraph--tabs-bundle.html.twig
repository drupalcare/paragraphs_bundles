{#
/**
 * @file
 * `tabs_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars              | DOM target                    | v2 mechanism |
 * |---------------------------|-------------------------------|--------------|
 * | pb_display_* (list)       | `.pb-ui-inner`                | entity field values |
 * | pb_display_bg/text/border*| `.pb-ui-inner`                | dynamic CSS |
 * | pb_display_tab_active_item | `--pb-bt-a` on inner         | dynamic CSS |
 * | pb_display_tab_animated_tabs | `.pb-tabs__panel`          | class on panel |
 * | pb_display_tabs_breakpoints | `.pb-tabs__tabset`          | v/h + breakpoint classes |
 *
 * Dynamic CSS selector: `#pb-tabs-{id} > .pb-ui-inner`
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_tabs/paragraph-bundle-tabs') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = ['pb-ui-inner', 'pb-tabs__inner']|merge(pb_display_classes)|join(' ') %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-tabs',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set pb_animated_tab = paragraph|pb_field_value('pb_display_tab_animated_tabs')|pb_class %}
{% set pb_breakpoints = paragraph|pb_field_value('pb_display_tabs_breakpoints', 'pb__992') %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}
{% set is_vertical = not paragraph.pb_display_tab_vertical_tabs.isEmpty and paragraph|pb_field_value('pb_display_tab_vertical_tabs') %}
{% set tabset_layout = (is_vertical ? 'pb-u-vertical-tabs' : 'pb-u-horizontal-tabs') ~ ' ' ~ pb_breakpoints %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">

    <div class="pb-content__full">
      {% if pb_title %}
        {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
      {% endif %}

      {# Named for the element it sits on; `pb-tabs-{id}` is the outer id. #}
      {% set tab_id = 'pb-tabs__tabset-' ~ paragraph.id.value %}
      {# L3 behavior host: JS once() target #}
      <div id="{{ tab_id }}" class="pb-tabs__tabset pb-ui-row {{ tabset_layout }}">

        <div class="pb-ui-bar pb-tabs__tablist" role="tablist" aria-label="{{ 'Tab List'|t }}">
          <span class="visually-hidden">{{ 'Use the arrow keys to navigate between tabs'|t }}</span>
          {% for key, item in content.pb_content_tab_section %}
            {% if key|first != '#' %}

              {% set tab_index = key + 1 %}
              {% set tab_para = item['#paragraph'] %}
              {% set use_tab_icon = tab_para.hasField('pb_content_tab_name_icon') and not tab_para.pb_content_tab_name_icon.isEmpty() and tab_para.pb_content_tab_name_icon.value %}
              {% set tab_label_raw = tab_para.pb_content_tab_name.value|default('') %}

              {% if use_tab_icon %}
                {% set raw_slug = 'icon-' ~ paragraph.id.value ~ '-' ~ tab_index %}
                {% set base_slug = raw_slug|clean_id %}
              {% else %}
                {% set raw_slug = tab_label_raw %}
                {% set base_slug = raw_slug|length > 50 ? raw_slug[:50]|clean_id : raw_slug|clean_id %}
              {% endif %}

              {% set tab_slug = paragraph.id.value ~ '-' ~ tab_index ~ '-' ~ base_slug %}

              <button id="{{ tab_id }}-{{ tab_index }}"
                class="pb-ui-btn pb-tabs__tab{% if key == 0 %} pb-is-active{% endif %}"
                data-fragment="{{ tab_slug }}"
                {% if use_tab_icon %}
                  aria-label="{{ 'Tab @n'|t({'@n': tab_index}) }}"
                {% endif %}
                aria-selected="{% if key == 0 %}true{% else %}false{% endif %}"
                aria-expanded="{% if key == 0 %}true{% else %}false{% endif %}"
                aria-controls="{{ tab_id }}-{{ tab_index }}-pane"
                type="button"
                role="tab"
                {% if key != 0 %}tabindex="-1"{% else %}tabindex="0"{% endif %}>
                {% if use_tab_icon %}
                  {% set _tn = tab_label_raw|trim %}
                  {% if ':' in _tn %}
                    {% set _parts = _tn|split(':', 2) %}
                    {% set _class = _parts[0]|trim %}
                    {% if _class starts with 'material-icons' or _class starts with 'material-symbols' %}
                      <span class="{{ _class|e('html_attr') }}" aria-hidden="true">{{ _parts[1]|trim|e }}</span>
                    {% else %}
                      <i class="{{ _tn|e('html_attr') }}" aria-hidden="true"></i>
                    {% endif %}
                  {% else %}
                    <i class="{{ _tn|e('html_attr') }}" aria-hidden="true"></i>
                  {% endif %}
                {% else %}
                  <span>{{ tab_label_raw|decode_entities }}</span>
                {% endif %}
              </button>
            {% endif %}
          {% endfor %}
        </div>

        <div class="pb-ui-row pb-tabs__panels">
          {% for key, item in content.pb_content_tab_section %}
            {% if key|first != '#' %}
              <div id="{{ tab_id }}-{{ key + 1 }}-pane" role="tabpanel" data-index="{{ key }}" aria-hidden="{% if key == 0 %}false{% else %}true{% endif %}" aria-labelledby="{{ tab_id }}-{{ key + 1 }}" class="pb-tabs__panel{{ pb_animated_tab == '' ? '' : ' ' ~ pb_animated_tab }}" {% if key == 0 %} aria-live="polite"{% endif %}>
                {{ item|pb_section_bodies('pb_content_tab_body') }}
              </div>
            {% endif %}
          {% endfor %}
        </div>

      </div>
    </div>
  </div>
</div>
