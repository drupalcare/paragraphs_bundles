{#
/**
 * @file
 * `accordion_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars              | DOM target                    | v2 mechanism |
 * |---------------------------|-------------------------------|--------------|
 * | pb_display_* (list)       | `.pb-ui-inner`           | entity field values + classes |
 * | pb_display_bg/text/border*| `.pb-ui-inner`           | dynamic CSS |
 * | pb_display_accor_active_item | `--pb-bt-a` on inner       | dynamic CSS |
 * | pb_display_accor_animated | `.pb-accordion__pane`             | class on pane |
 *
 * Dynamic CSS selector: `#pb-accordion-{id} > .pb-ui-inner`
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_accordion/paragraph-bundle-accordion') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = ['pb-ui-inner', 'pb-accordion-wrap__inner']|merge(pb_display_classes)|join(' ') %}
{% set pb_animated_tab = paragraph|pb_field_value('pb_display_accor_animated')|pb_class %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}
{% set pb_expand_all = not paragraph.pb_display_accor_show_expand.isEmpty and paragraph|pb_field_value('pb_display_accor_show_expand') %}
{% set pb_show_indicator = not paragraph.pb_display_accor_indicator.isEmpty and paragraph|pb_field_value('pb_display_accor_indicator') %}
{% set pb_open_first = not paragraph.pb_display_accor_open_first.isEmpty and paragraph|pb_field_value('pb_display_accor_open_first') %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-accordion',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  pb_expand_all ? 'pb--expand-all',
  pb_show_indicator ? 'pb--show-indicator',
  pb_open_first ? 'pb-u-open-first',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">

    <div class="pb-content__full">
      {# Named for the element it sits on. `pb-accordion-{id}` is now the
         outer id from preprocess, so this must not reuse it. #}
      {% set acc_id = 'pb-accordion__sections-' ~ paragraph.id.value %}
      {# L3 behavior host — JS once() target #}
      <div id="{{ acc_id }}" class="pb-accordion__sections pb-ui-row">

        {% if pb_title %}
          {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
        {% endif %}

        {% if pb_expand_all %}
          <div class="pb-ui-row pb-grid__expand-button pb-is-expand-all">
            <button class="pb-ui-btn pb-accordion__toggle-all" aria-expanded="false" aria-controls="{{ acc_id }}" aria-label="{{ 'Toggle all sections'|t }}" tabindex="0">
              <span class="visually-hidden">{{ 'Toggle all sections'|t }}</span>
              <span class="pb-icon-toggle__plus-svg">{{ include('@paragraph_bundle_accordion/svg/svg-all-expand.svg') }}</span>
              <span class="pb-icon-toggle__minus-svg">{{ include('@paragraph_bundle_accordion/svg/svg-all-collapse.svg') }}</span>
            </button>
          </div>
        {% endif %}

        {% for key, item in content.pb_content_accordion_section %}
          {% if key|first != '#' %}
            <div id="pb-accordion__item-{{ paragraph.id.value }}-{{ key + 1 }}" class="pb-ui-row pb-accordion__item{% if key == 0 and pb_open_first %} pb-is-active{% else %} pb-is-inactive{% endif %}">

              {% set tab_index = key + 1 %}
              {% set accordion_title = item['#paragraph']|pb_field_value('pb_content_accordion_title') %}
              {% set raw_slug = accordion_title|lower|replace({' ': '-', '?': '', ',': '', '.': '', '/': '-'}) %}
              {% set base_slug = raw_slug|length > 50 ? raw_slug[:50]|clean_id : raw_slug|clean_id %}
              {% set tab_slug = paragraph.id.value ~ '-' ~ tab_index ~ '-' ~ base_slug %}
              <button id="{{ acc_id }}-{{ tab_index }}" class="pb-ui-btn pb-ui-bar pb-accordion__button" data-fragment="{{ tab_slug }}" aria-label="{{ accordion_title|decode_entities }}" aria-expanded="{% if key == 0 and pb_open_first %}true{% else %}false{% endif %}" aria-controls="{{ acc_id }}-{{ tab_index }}-pane" type="button">

                <span class="pb-ui-btn__title">
                  {{ accordion_title|decode_entities }}
                </span>

                {% if pb_show_indicator %}
                  <span class="pb-icon-toggle">
                    <span class="pb-icon-toggle__minus" aria-hidden="{{ key == 0 and pb_open_first ? 'false' : 'true' }}">
                      {{ include('@paragraph_bundle_accordion/svg/svg-panel-collapse.svg') }}
                    </span>
                    <span class="pb-icon-toggle__plus" aria-hidden="{{ key == 0 and pb_open_first ? 'true' : 'false' }}">
                      {{ include('@paragraph_bundle_accordion/svg/svg-panel-expand.svg') }}
                    </span>
                    <span class="visually-hidden">{{ 'Close or Open tab'|t }}</span>
                  </span>
                {% endif %}
              </button>

              <div id="{{ acc_id }}-{{ key + 1 }}-pane" class="pb-ui-row pb-accordion__pane {{ pb_animated_tab == '' ? '' : ' ' ~ pb_animated_tab }}" role="region" aria-labelledby="{{ acc_id }}-{{ key + 1 }}" aria-hidden="{% if key == 0 and pb_open_first %}false{% else %}true{% endif %}" data-index="{{ key }}">
                {{ item|pb_section_bodies('pb_content_accordion_body') }}
              </div>

            </div>
          {% endif %}
        {% endfor %}

      </div>
    </div>
  </div>
</div>
