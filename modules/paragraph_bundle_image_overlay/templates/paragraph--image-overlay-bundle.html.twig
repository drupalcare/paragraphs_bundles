{#
/**
 * @file
 * `image_overlay_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars                    | DOM target              | v2 mechanism |
 * |---------------------------------|-------------------------|--------------|
 * | pb_display_* (list)             | `.pb-ui-inner`     | entity field values |
 * | pb_display_border_color         | `.pb-ui-inner`     | dynamic CSS (`--pb-br`) |
 * | pb_display_bg/text/link*        | paragraph wrapper       | generated CSS file |
 *
 * THE MODE NO LONGER CHANGES WHERE THE COLORS GO. `--pb-bg` / `--pb-tx` and
 * their hover variants are defined once on the wrapper and inherited; the
 * stylesheet already selects the right element per mode
 * (`:not(.pb-image-overlay--title) .pb-overlay__container` versus
 * `.pb-image-overlay--title … :hover .pb-overlay__title`). The PHP that used
 * to route one inline string to one element or the other is gone.
 * | pb_display_image_overlay        | outer wrapper class     | `pb-image-overlay--{key}` |
 * | pb_display_border_radius        | `.pb-overlay__container`| class on overlay |
 * | pb_display_padding              | `.pb-overlay__title`    | class via title_extra_classes |
 *
 * Dynamic CSS selector: `#pb-image-overlay-{id}` with split scopes.
 *
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 * @see \Drupal\paragraphs_bundles\Service\Css\PbDynamicCssBuilder
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_image_overlay/paragraph-bundle-image-overlay') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = ['pb-ui-inner', 'pb-image-overlay__inner', 'pb-content__full']|merge(pb_display_classes)|join(' ') %}

{% set pb_image_overlay_raw = paragraph|pb_field_value('pb_display_image_overlay') %}
{% set pb_image_overlay_class = pb_image_overlay_raw ? 'pb-image-overlay--' ~ pb_image_overlay_raw|replace({_: '-'}) : '' %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-image-overlay',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
  pb_image_overlay_class,
] %}

{% set pb_br_radius = paragraph|pb_field_value('pb_display_border_radius')|pb_class %}
{% set pb_padding = paragraph|pb_field_value('pb_display_padding')|pb_class %}
{% set pb_overlay_class = pb_br_radius ? 'pb-overlay__container ' ~ pb_br_radius : 'pb-overlay__container' %}

{% set pb_link = content.pb_content_image_link.0['#url'] %}
{% set pb_link_title = content.pb_content_image_link_title|render|striptags|trim %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}
{% set _overlay_title_extra = pb_padding ? 'pb-overlay__title ' ~ pb_padding : 'pb-overlay__title' %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">

    <div class="pb-image__wrapper">
      {{ content.pb_content_image }}
    </div>

    {#
      NO INLINE STYLE HERE. The overlay colors now come from this paragraph's
      generated stylesheet: see PbDynamicUserVarBuilder::USER_STYLE_SCOPES,
      `image_overlay_bundle`, which defines `--pb-bg`/`--pb-tx` and their hover
      variants on the paragraph wrapper. The existing rules in
      paragraph-bundle-image-overlay.css already select the right element per
      overlay mode, and custom properties inherit, so nothing here needs to
      know which mode is active.
    #}
    <div class="{{ pb_overlay_class }}">
      {% if pb_link %}
        <a href="{{ pb_link }}" class="pb-ui-row pb-ui-link"{% if pb_link_title %} title="{{ pb_link_title }}"{% endif %}>
      {% endif %}

      <div class="pb-ui-row">
        {% if pb_title %}
          {{ include('@paragraphs_bundles/pb-content-title.html.twig', {
            paragraph: paragraph,
            content: content,
            title_extra_classes: _overlay_title_extra,
          }, false) }}
        {% endif %}
      </div>

      {% if pb_link %}
        </a>
      {% endif %}
    </div>

  </div>
</div>
