{#
/**
 * @file
 * `node_reference_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars              | DOM target           | v2 mechanism |
 * |---------------------------|----------------------|--------------|
 * | pb_display_* (list)       | `.pb-ui-inner`  | entity field values |
 * | pb_display_bg/text/border*| `.pb-ui-inner`  | dynamic CSS |
 * | pb_content_view_mode      | content branch logic | entity field value |
 * | pb_content_nf_*           | `.pb-content__full`  | entity reference render |
 *
 * Dynamic CSS selector: `#pb__nf-{id} > .pb-ui-inner`
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_node_reference/paragraph-bundle-node-reference') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = 'pb-ui-inner pb-node-reference__inner' %}
{% set view_mode = paragraph|pb_field_value('pb_content_view_mode') %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-node-reference',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set pb_displays = [
  'pb_display_width',
  'pb_display_border',
  'pb_display_border_radius',
  'pb_display_margin',
  'pb_display_padding',
  'pb_display_shadow',
] %}
{% for pb_display in pb_displays %}
  {% set display_value = paragraph|pb_field_value(pb_display) %}
  {% set classes_inner = display_value ? classes_inner ~ ' ' ~ (display_value|pb_class) : classes_inner %}
{% endfor %}

<div {{ attributes.addClass(classes).setAttribute('id', paragraph_id) }}>
  <div class="{{ classes_inner }}">

    <div class="pb-content__full">

      {% if pb_title %}
        {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
      {% endif %}

      {% set content_displayed = false %}

      {% if view_mode == 'vm_title' and content.pb_content_nf_title_only|render %}
        {{ content.pb_content_nf_title_only }}
        {% set content_displayed = true %}
      {% endif %}

      {% if not content_displayed and view_mode == 'vm_teaser_text' and content.pb_content_nf_teaser_text|render %}
        {{ content.pb_content_nf_teaser_text }}
        {% set content_displayed = true %}
      {% endif %}

      {% if not content_displayed and view_mode == 'vm_slideshow' and content.pb_content_nf_slideshow|render %}
        {{ content.pb_content_nf_slideshow }}
        {% set content_displayed = true %}
      {% endif %}

      {% if not content_displayed and view_mode == 'vm_3d_carousel' and content.pb_content_nf_3d_carousel|render %}
        {{ content.pb_content_nf_3d_carousel }}
        {% set content_displayed = true %}
      {% endif %}

      {% if not content_displayed %}
        {% if content.pb_content_nf_title_only|render %}
          {{ content.pb_content_nf_title_only }}
        {% elseif content.pb_content_nf_3d_carousel|render %}
          {{ content.pb_content_nf_3d_carousel }}
        {% elseif content.pb_content_nf_slideshow|render %}
          {{ content.pb_content_nf_slideshow }}
        {% elseif content.pb_content_nf_teaser_text|render %}
          {{ content.pb_content_nf_teaser_text }}
        {% endif %}
      {% endif %}

    </div>

  </div>
</div>
