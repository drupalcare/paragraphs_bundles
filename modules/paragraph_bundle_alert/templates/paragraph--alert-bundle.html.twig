{#
/**
 * @file
 * `alert_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars              | DOM target              | CSS |
 * |---------------------------|-------------------------|-----|
 * | pb_display_margin         | `.pb-ui-inner`     | base `.pb__margin*` |
 * | pb_display_width          | `.pb-ui-inner`     | custom `--pb-width` |
 * | pb_display_border         | `.pb-ui-inner`     | base `.pb__border*` |
 * | pb_display_border_radius  | `.pb-ui-inner`     | base `.pb__round*` |
 * | pb_display_padding        | `.pb-ui-inner`     | base `.pb__padding*` |
 * | pb_display_shadow         | `.pb-ui-inner`     | base `.pb-card*` |
 * | pb_display_bg*            | `.pb-ui-inner`     | dynamic CSS `--pb-bg*` |
 * | pb_display_text*          | `.pb-ui-inner`     | dynamic CSS `--pb-tx*` |
 * | pb_display_border_color*  | `.pb-ui-inner`     | dynamic CSS `--pb-br*` |
 * | pb_display_link*          | `.pb-ui-inner`     | dynamic CSS `--pb-lk*` |
 *
 * Dynamic CSS selector: `#pb-alert-{id} > .pb-ui-inner` (default builder).
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraph_bundle_alert\Hook\PbaPreprocessAlertHook
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 * @see \Drupal\paragraphs_bundles\Service\Css\PbDynamicCssBuilder
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_alert/paragraph-bundle-alert') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set classes_inner = ['pb-ui-inner']|merge(pb_display_classes)|join(' ') %}
{% set paragraph_id = pb_paragraph_id %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-alert',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  paragraph_id,
] %}

{% set pb_close_button = not paragraph.pb_display_show_close_button.isEmpty and paragraph|pb_field_value('pb_display_show_close_button') %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}

{% if not pb_alert_hidden %}
<div {{ attributes.addClass(classes, pb_default_state == 'closed' ? 'pb-is-closed').setAttribute('id', paragraph_id).setAttribute('role', 'alert').setAttribute('aria-live', 'assertive').setAttribute('aria-hidden', pb_default_state == 'closed' ? 'true' : 'false')
  .setAttribute('data-dismissal-type', pb_dismissal_type)
  .setAttribute('data-countdown-seconds', pb_countdown_seconds)
  .setAttribute('data-show-countdown-label', pb_show_countdown_label ? '1' : '0')
  .setAttribute('data-close-persist', pb_close_persist)
  .setAttribute('data-date-range-end', pb_date_range_end) }}>
  <div class="{{ classes_inner }}">

    {# WCAG 2.2.1 Timing Adjustable: whenever the countdown can run there must be
       a control that turns it off, and it is gated on the countdown ITSELF, not
       on pb_show_countdown_label. The label is cosmetic — the timer runs
       whenever the dismissal type is `countdown` and the seconds are above zero
       — so gating the control on the label would leave every label-off alert
       removing its own content on a limit the user cannot stop. #}
    {% set pb_countdown_runs = pb_dismissal_type == 'countdown' and pb_countdown_seconds > 0 %}

    {% if pb_close_button or pb_countdown_runs %}
      <div class="pb-alert--top {{ pb_close_button ? 'pb--has-close' : 'pb--no-close' }}">
        {% if pb_countdown_runs %}
          <div class="pb-alert__countdown" aria-live="polite">
            {% if pb_show_countdown_label %}
              <span data-pb-countdown-label>{{ pb_countdown_seconds }}</span>
              <span class="pb-alert__countdown-unit">{{ 'sec'|t }}</span>
            {% endif %}
            <button type="button"
                    data-pb-countdown-pause
                    aria-label="{{ 'Pause the countdown that dismisses this alert'|t }}"
                    aria-pressed="false"
                    class="pb-ui-btn pb-alert__countdown-pause">
              <span class="visually-hidden">{{ 'Pause countdown'|t }}</span>
              <span class="pb-alert__pause-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor" focusable="false"><path d="M560-200v-560h160v560H560Zm-320 0v-560h160v560H240Z"/></svg>
              </span>
              <span class="pb-alert__play-icon" aria-hidden="true" hidden>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor" focusable="false"><path d="M320-200v-560l440 280-440 280Z"/></svg>
              </span>
            </button>
          </div>
        {% endif %}
        {% if pb_close_button %}
          {# No aria-expanded: dismissal is one-way. The button lives inside the
             container that closeAlert() marks `inert`, so it can neither be
             focused nor clicked once closed — a disclosure state here described
             an affordance that cannot exist (WCAG 4.1.2). #}
          <button aria-label="{{ 'Close alert'|t }}"
                  aria-controls="{{ paragraph_id }}"
                  type="button"
                  class="pb-alert__close">
            <span class="visually-hidden">{{ 'Close message'|t }}</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true" focusable="false"><path d="m336-280 144-144 144 144 56-56-144-144 144-144-56-56-144 144-144-144-56 56 144 144-144 144 56 56ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
          </button>
        {% endif %}
      </div>
    {% endif %}

    <div class="pb-content__full pb-alert__content">
      {% if pb_title %}
        {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
      {% endif %}
      {{ content.pb_content_alert_body }}
    </div>

  </div>
</div>
{% endif %}
