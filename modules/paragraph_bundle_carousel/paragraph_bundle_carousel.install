<?php

/**
 * @file
 * Install and update hooks for paragraph_bundle_carousel.
 *
 * V2 update hooks (pre-release):
 *  - 9001: add the CSS Classes field.
 *  - 9002: add the Kicker and Lede content fields (G1, G2).
 */

declare(strict_types=1);

use Drupal\Core\Entity\Display\EntityDisplayInterface;

/**
 * Adds the CSS Classes field to the bundle this module owns.
 *
 * The field lets a site put its own class on every instance of a bundle and
 * style them all with one theme rule. New sites get it from config/optional;
 * this is the path for sites that already have the bundle.
 */
function paragraph_bundle_carousel_update_9001(): string {
  \Drupal::moduleHandler()->loadInclude('paragraphs_bundles', 'install');
  $done = [];
  foreach (['carousel_bundle'] as $bundle) {
    if (paragraphs_bundles_pb_css_classes_wire_bundle('paragraph_bundle_carousel', $bundle)) {
      $done[] = $bundle;
    }
  }
  return $done === []
    ? (string) t('CSS Classes field was already present; nothing to do.')
    : (string) t('CSS Classes field added to: @list.', ['@list' => implode(', ', $done)]);
}

/**
 * Adds the Kicker and Lede content fields to carousel_bundle.
 *
 * Both reuse parent storages: `pb_content_kicker` (paragraphs_bundles 9013)
 * and `pb_content_body`. Each step is guarded, so the function is safe to run
 * again and safe on a site that got the fields from config/optional.
 *
 * @return bool
 *   TRUE when the Kicker instance was created by this call.
 */
function paragraph_bundle_carousel_add_intro_fields(): bool {
  $bundle = 'carousel_bundle';
  $items_field = 'pb_content_carousel_body';
  $em = \Drupal::entityTypeManager();
  \Drupal::moduleHandler()->loadInclude('paragraphs_bundles', 'install');

  $existed = $em->getStorage('field_config')->load('paragraph.' . $bundle . '.pb_content_kicker') !== NULL;
  // Storage first (parent), then this module's instance: the instance
  // depends on the storage.
  paragraphs_bundles_import_optional_config_if_missing('paragraphs_bundles', 'field.storage.paragraph.pb_content_kicker');
  paragraphs_bundles_import_optional_config_if_missing('paragraphs_bundles', 'field.storage.paragraph.pb_content_body');
  paragraphs_bundles_import_optional_config_if_missing('paragraph_bundle_carousel', 'field.field.paragraph.' . $bundle . '.pb_content_kicker');
  paragraphs_bundles_import_optional_config_if_missing('paragraph_bundle_carousel', 'field.field.paragraph.' . $bundle . '.pb_content_body');

  // Edit form: Content tab, after the three title fields. The form display
  // verifier needs title, tag and alignment at weights 1-3, so these take 4
  // and 5 and the items field moves to 6 to stay last.
  $form = $em->getStorage('entity_form_display')->load('paragraph.' . $bundle . '.default');
  if ($form instanceof EntityDisplayInterface) {
    $changed = FALSE;
    if ($form->getComponent('pb_content_kicker') === NULL) {
      $form->setComponent('pb_content_kicker', [
        'type' => 'string_textfield',
        'weight' => 4,
        'region' => 'content',
        'settings' => ['size' => 60, 'placeholder' => ''],
        'third_party_settings' => [],
      ]);
      $changed = TRUE;
    }
    if ($form->getComponent('pb_content_body') === NULL) {
      $form->setComponent('pb_content_body', [
        'type' => 'text_textarea',
        'weight' => 5,
        'region' => 'content',
        'settings' => ['rows' => 3, 'placeholder' => ''],
        'third_party_settings' => [],
      ]);
      $changed = TRUE;
    }
    $items = $form->getComponent($items_field);
    if (is_array($items) && (int) ($items['weight'] ?? 0) < 6) {
      $items['weight'] = 6;
      $form->setComponent($items_field, $items);
      $changed = TRUE;
    }
    $group = $form->getThirdPartySetting('field_group', 'group_pb_tab_content');
    if (is_array($group) && is_array($group['children'] ?? NULL)) {
      $children = array_values(array_diff($group['children'], ['pb_content_kicker', 'pb_content_body']));
      $at = array_search('pb_content_title_alignment', $children, TRUE);
      $at = $at === FALSE ? count($children) : $at + 1;
      array_splice($children, $at, 0, ['pb_content_kicker', 'pb_content_body']);
      if ($children !== $group['children']) {
        $group['children'] = $children;
        $form->setThirdPartySetting('field_group', 'group_pb_tab_content', $group);
        $changed = TRUE;
      }
    }
    if ($changed) {
      $form->save();
    }
  }

  // Display: both print (the template wraps them only when filled).
  $view = $em->getStorage('entity_view_display')->load('paragraph.' . $bundle . '.default');
  if ($view instanceof EntityDisplayInterface) {
    $changed = FALSE;
    if ($view->getComponent('pb_content_kicker') === NULL) {
      $view->setComponent('pb_content_kicker', [
        'type' => 'string',
        'label' => 'hidden',
        'settings' => ['link_to_entity' => FALSE],
        'third_party_settings' => [],
        'weight' => 20,
        'region' => 'content',
      ]);
      $changed = TRUE;
    }
    if ($view->getComponent('pb_content_body') === NULL) {
      $view->setComponent('pb_content_body', [
        'type' => 'text_default',
        'label' => 'hidden',
        'settings' => [],
        'third_party_settings' => [],
        'weight' => 21,
        'region' => 'content',
      ]);
      $changed = TRUE;
    }
    if ($changed) {
      $view->save();
    }
  }

  return !$existed && $em->getStorage('field_config')->load('paragraph.' . $bundle . '.pb_content_kicker') !== NULL;
}

/**
 * Adds the Kicker and Lede content fields to the carousel.
 *
 * New sites get them from config/optional; this is the path for sites that
 * already have the bundle. Both are optional and empty, so existing carousels
 * render exactly as before until an editor fills one.
 */
function paragraph_bundle_carousel_update_9002(): string {
  if (\Drupal::entityTypeManager()->getStorage('paragraphs_type')->load('carousel_bundle') === NULL) {
    return (string) t('No carousel paragraph type; nothing to do.');
  }
  return paragraph_bundle_carousel_add_intro_fields()
    ? (string) t('Kicker and Lede fields added to the carousel Content tab.')
    : (string) t('Kicker and Lede fields were already present; form and display checked.');
}

/**
 * Implements hook_update_dependencies().
 *
 * @phpstan-return array<string, array<int, array<string, int>>>
 */
function paragraph_bundle_carousel_update_dependencies(): array {
  // 9002 imports the Kicker storage that paragraphs_bundles 9013 ships.
  return [
    'paragraph_bundle_carousel' => [
      9002 => ['paragraphs_bundles' => 9013],
    ],
  ];
}
