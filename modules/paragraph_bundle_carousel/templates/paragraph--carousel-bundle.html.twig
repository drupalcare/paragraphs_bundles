{#
/**
 * @file
 * `carousel_bundle` paragraph template (v2).
 *
 * v1 Twig audit (display field -> DOM target -> CSS source):
 *
 * | Field / vars                    | DOM target              | v2 mechanism |
 * |---------------------------------|-------------------------|--------------|
 * | pb_display_* (list)             | `.pb-ui-inner`          | entity field values |
 * | pb_display_bg/text/border*      | `.pb-ui-inner`          | dynamic CSS |
 * | pb_display_slide_gap            | `.pb-carousel__slides`  | inline `gap` (px) |
 * | pb_display_custom_slide_width   | `.pb-carousel__slide`   | inline `max-width` |
 * | pb_display_carousel_breakpoints | outer wrapper class     | breakpoint library |
 *
 * Dynamic CSS selector: `#pb-carousel-{id} > .pb-ui-inner`
 *
 * @see template_preprocess_paragraph()
 * @see \Drupal\paragraphs_bundles\Hook\PbPreprocessHook
 *
 * @ingroup themeable
 */
#}

{{ attach_library('paragraphs_bundles/paragraphs-bundles') }}
{{ attach_library('paragraph_bundle_carousel/paragraph-bundle-carousel') }}
{% if pb_dynamic_library %}{{ attach_library(pb_dynamic_library) }}{% endif %}

{% set breakpoints_raw = paragraph|pb_field_value('pb_display_carousel_breakpoints') %}
{% if breakpoints_raw %}
  {{ attach_library('paragraph_bundle_carousel/paragraph-bundle-carousel-' ~ breakpoints_raw) }}
{% endif %}

{% set paragraph_id = pb_paragraph_id %}
{% set classes_inner = ['pb-ui-inner', 'pb-carousel__track-inner']|merge(pb_display_classes)|join(' ') %}
{% set vertical_carousel = paragraph|pb_field_value('pb_display_vertical_carousel') %}
{% set pb_navigation = paragraph|pb_field_value('pb_display_navigation') %}
{% set pb_play_stop = paragraph|pb_field_value('pb_display_carousel_play_stop') %}
{% set pb_big_screen = paragraph|pb_field_value('pb_display_big_screen') %}
{% set pb_small_screen = paragraph|pb_field_value('pb_display_small_screen') %}
{% set pb_looping = not paragraph.pb_display_activate_looping.isEmpty and paragraph|pb_field_value('pb_display_activate_looping') %}
{% set item_width = paragraph|pb_field_value('pb_display_custom_slide_width') %}
{% set item_gap = paragraph|pb_field_value('pb_display_slide_gap') %}
{% set pb_title = content.pb_content_title|render|striptags|trim %}
{% set carousel_id = paragraph_id %}
{% set items_id = 'pb-carousel__slides-' ~ paragraph.id.value %}
{% set valid_slides = content.pb_content_carousel_body|filter((item, key) => key|first != '#') %}
{% set total_slides = valid_slides|length %}

{% set classes = [
  'paragraph',
  'paragraphs-bundles',
  'pb-carousel',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished',
  'paragraph--id--' ~ paragraph.id.value,
  vertical_carousel == 'vertical' ? 'pb-u-vertical-carousel' : (vertical_carousel == 'hybrid' ? 'pb-u-hybrid-carousel' : 'pb-u-horizontal-carousel'),
  pb_navigation in ['arrows', 'both'] ? 'pb-has-arrows' : 'pb-no-arrows',
  breakpoints_raw,
  paragraph_id,
] %}

<div {{ attributes.addClass(classes).setAttribute('id', carousel_id) }} role="region" aria-label="{{ 'Carousel'|t }}" tabindex="0">
  <div class="{{ classes_inner }}">

    {% if pb_title %}
      {{ include('@paragraphs_bundles/pb-content-title.html.twig', {paragraph: paragraph, content: content}, false) }}
    {% endif %}

    {# L3 behavior host — JS once() target #}
    <div class="pb-carousel__viewport pb-content__full">
      <div class="pb-carousel__wrapper">
        <div id="{{ items_id }}"
             class="pb-carousel__slides{{ pb_play_stop == 0 ? ' pb-u-zero' : ' pb-u-not-zero' }}"
             role="group"
             aria-roledescription="carousel"
             aria-labelledby="index-{{ paragraph.id.value }}"
             data-slide-time="{{ pb_play_stop }}"
             data-small-screen="{{ pb_small_screen }}"
             data-big-screen="{{ pb_big_screen }}"
             data-breakpoints="{{ breakpoints_raw|replace({pb__: ''}) }}"
             data-total-slides="{{ total_slides }}"
             data-carousel-loop="{{ pb_looping ? '1' : '0' }}"
             data-navigation="{{ pb_navigation }}"
             data-gap="{{ item_gap }}"
            {% if vertical_carousel %}data-orientation="{{ vertical_carousel }}"{% endif %}>

          {% for key, item in valid_slides %}
            {% set item_id = 'item-' ~ paragraph.id.value ~ '-' ~ loop.index %}
            {% set item_classes = 'pb-carousel__slide item-' ~ paragraph.id.value ~ '-' ~ loop.index %}

            <div
              id="{{ item_id }}"
              class="{{ item_classes }}"
              role="group"
              aria-labelledby="label-{{ item_id }}">

              <div id="label-{{ item_id }}" class="visually-hidden">
                {{ 'Slide @current of @total'|t({'@current': loop.index, '@total': total_slides}) }}
              </div>

              {{ item }}
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="pb-carousel__announcer visually-hidden" aria-live="polite"></div>

      {# Bottom bar: play/pause (autoplay only) beside horizontally centered,
         wrapping dots. Renders when either is present. #}
      {% set pb_show_dots = pb_navigation in ['dots', 'both'] %}
      {% if total_slides > 1 and (pb_show_dots or pb_play_stop > 0) %}
        <div class="pb-carousel__bottom-bar">
          {% if pb_play_stop > 0 %}
            <button id="play-pause-{{ paragraph.id.value }}" type="button" class="pb-ui-btn pb-carousel__play-pause pb-is-playing" aria-controls="{{ carousel_id }}" aria-label="{{ 'Pause slideshow'|t }}" aria-pressed="true">
              <span class="visually-hidden">{{ 'Play or pause the carousel'|t }}</span>
              <span class="pb-nav__pause-icon">{{ include('@paragraph_bundle_carousel/svg/svg-pause.svg') }}</span>
              <span class="pb-nav__play-icon" hidden>{{ include('@paragraph_bundle_carousel/svg/svg-play.svg') }}</span>
            </button>
          {% endif %}

          {% if pb_show_dots %}
            <div class="pb-carousel__dots" aria-label="{{ 'Slide navigation'|t }}">
              {# Dots populated by JavaScript. #}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% set pb_show_arrows = pb_navigation in ['arrows', 'both'] %}
      {% if total_slides > 1 and pb_show_arrows %}
        <div class="pb-carousel__options-bar" aria-label="{{ 'Carousel Controls'|t }}">
          <button id="prev-{{ paragraph.id.value }}" type="button" class="pb-ui-btn pb-nav__prev" aria-controls="{{ carousel_id }}" aria-label="{{ 'Previous Slide'|t }}">
            <span class="visually-hidden">{{ 'Previous Slide'|t }}</span>
            {{ include('@paragraph_bundle_carousel/svg/svg-prev.svg') }}
          </button>

          <button id="next-{{ paragraph.id.value }}" type="button" class="pb-ui-btn pb-nav__next" aria-controls="{{ carousel_id }}" aria-label="{{ 'Next Slide'|t }}">
            <span class="visually-hidden">{{ 'Next Slide'|t }}</span>
            {{ include('@paragraph_bundle_carousel/svg/svg-next.svg') }}
          </button>
        </div>
      {% endif %}

    </div>
  </div>
</div>
